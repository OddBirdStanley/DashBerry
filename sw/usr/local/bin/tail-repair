#!/bin/sh
# tail-repair — give a session's last segments back their declared duration.
#
# Why this exists. splitmuxsink writes each segment's mvhd/tkhd/mehd
# duration only when it CLOSES the file, and the recorders patch that
# (wrong) value from the fragment-closed message. Neither happens to the
# segment that is still open when recording ends, and recording always ends
# that way: ignition cuts the 12 V mid-segment. The sample tables
# (moof/traf/trun) are intact — every fragment that reached the card is
# there — but the file declares a duration of 0, so VLC and anything else
# that trusts the declaration plays nothing. The footage was saved; the
# header says otherwise. mp4-set-duration recovers the real duration from
# the sample tables; this script decides which files to point it at.
#
#   tail-repair stale          every session dir EXCEPT the live one — run
#                              once at boot (tail-repair.service), so the
#                              previous drive's last segment is playable
#                              before anyone pulls the card. This is the
#                              path that covers a power cut, where nothing
#                              on the card got to run at shutdown.
#   tail-repair current BASE   the live session's dir for one camera, run
#                              from that recorder's ExecStopPost — a clean
#                              `systemctl stop`/shutdown repairs the tail
#                              immediately instead of waiting for the next
#                              boot. BASE is front or rear: never touch the
#                              OTHER camera's tail, it may still be
#                              recording into it.
set -u
. /etc/dashberry.conf

# mp4-set-duration's `repair` mode reads this to decide whether a file's
# declared duration is plausible or needs recovering.
export SEGMENT_NS

SESSION=$(cat "$SESSION_FILE" 2>/dev/null || true)

# The last TWO segments, not just the tail. The tail is the obvious one — it
# was never closed, so its duration was never written. But the segment BEFORE
# it can be damaged too: it is closed and the watcher patches it within the
# second, and a power cut landing inside that second leaves it either
# unpatched or patched halfway through mp4-set-duration's four writes. Only
# the most recently closed segment can be in that state (the watcher handles
# messages in order), so two files is complete coverage, and checking an
# already-healthy one costs a single short read.
fix_dir() {
    for _f in $(ls "$1" 2>/dev/null | grep -E '^[0-9]+\.mp4$' | sort -n | tail -2); do
        mp4-set-duration "$1/$_f" repair ||
            echo "tail-repair: cannot repair $1/$_f" >&2
    done
}

case "${1:-stale}" in
current)
    base=${2:?usage: tail-repair current {front|rear}}
    # No session means no recorder ran; nothing to repair.
    [ -n "$SESSION" ] || exit 0
    fix_dir "$DATA/$base/$SESSION"
    ;;
stale)
    # Without a live session name we cannot tell which dir to leave alone,
    # so do nothing rather than race a recorder. session.service orders
    # ahead of us, so this only fires when it failed — and then no recorder
    # is running either.
    [ -n "$SESSION" ] || {
        echo "tail-repair: no session name yet, skipping sweep" >&2
        exit 0
    }
    for base in front rear; do
        for d in "$DATA/$base"/*; do
            [ -d "$d" ] || continue
            [ "${d##*/}" = "$SESSION" ] && continue
            fix_dir "$d"
        done
    done
    ;;
*)
    echo "usage: tail-repair {stale|current {front|rear}}" >&2
    exit 2
    ;;
esac
exit 0
