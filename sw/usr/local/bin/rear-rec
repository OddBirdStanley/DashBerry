#!/bin/sh
# rear-rec — rear UVC (showmewebcam) MJPEG → hw decode → hw H.264 → 60 s
# fragmented MP4 segments. Exits (→ systemd Restart) if the camera is absent;
# the Zero normally beats the Pi 4 to readiness since both power on ignition.
# Writes into the per-boot session directory minted by session-init (rev 6):
# a restart REUSES the same session dir.
set -eu
. /etc/dashberry.conf

[ -e "$REAR_CAM_DEV" ] || { echo "rear-rec: $REAR_CAM_DEV not present yet"; sleep 2; exit 1; }

SESSION=$(cat "$SESSION_FILE")
OUT="$DATA/rear/$SESSION"
mkdir -p "$OUT"

# Restart-in-same-session: resume the %05d counter one past the highest
# existing segment (splitmuxsink start-index). VERIFY on bench alongside
# front-rec: no overwrite after unplug/replug of the rear camera.
START_INDEX=$(ls "$OUT" 2>/dev/null | awk -F. '/^[0-9]+\.mp4$/ { if ($1 + 1 > s) s = $1 + 1 } END { print s + 0 }')

# VERIFY on bench (PLAN §6 "encoder pipeline quirks"): v4l2h264enc wants
# bitrate/period set via extra-controls and an explicit level in caps —
# names below are the bookworm-era ones; confirm on trixie (kernel 6.12)
# with `v4l2-ctl -d /dev/video11 -L`.
gst-launch-1.0 -e v4l2src device="$REAR_CAM_DEV" \
    ! "image/jpeg,width=$REAR_W,height=$REAR_H,framerate=$REAR_FPS/1" \
    ! v4l2jpegdec \
    ! v4l2h264enc extra-controls="controls,video_bitrate=$REAR_BITRATE,h264_i_frame_period=$REAR_FPS" \
    ! "video/x-h264,level=(string)4" \
    ! h264parse \
    ! splitmuxsink location="$OUT/%05d.mp4" \
        start-index="$START_INDEX" \
        max-size-time="$SEGMENT_NS" \
        muxer-properties="properties,fragment-duration=$FRAGMENT_MS"
