#!/bin/sh
# rear-rec — rear UVC (showmewebcam) MJPEG → software decode → hw H.264 →
# 60 s fragmented MP4 segments. Exits (→ systemd Restart) if the camera is
# absent; the Zero normally beats the Pi 4 to readiness since both power on
# ignition. Writes into the per-boot session directory minted by
# session-init: a restart REUSES the same session dir.
set -eu
. /etc/dashberry.conf

[ -e "$REAR_CAM_DEV" ] || { echo "rear-rec: $REAR_CAM_DEV not present yet"; sleep 2; exit 1; }

SESSION=$(cat "$SESSION_FILE")
OUT="$DATA/rear/$SESSION"
mkdir -p "$OUT"

# Restart-in-same-session: resume the %05d counter one past the highest
# existing segment (splitmuxsink start-index), so nothing is overwritten
# after an unplug/replug of the rear camera.
START_INDEX=$(ls "$OUT" 2>/dev/null | awk -F. '/^[0-9]+\.mp4$/ { if ($1 + 1 > s) s = $1 + 1 } END { print s + 0 }')

# Crash-restart tail: recover the previous run's last file's declared
# duration from its sample tables (same qtmux bug as front-rec, see there).
# Within-this-boot only — the PREVIOUS boot's tail is in another session dir
# and belongs to tail-repair.service's boot sweep.
tail-repair current rear || true

# jpegdec (SOFTWARE, ~1/3 core at 720p30) — deliberately NOT v4l2jpegdec.
# The hardware decoder (bcm2835-codec, kernel 6.18) returns an empty
# V4L2_BUF_FLAG_LAST capture buffer after its FIRST frame ("Empty last
# buffer, signalling eos" under GST_DEBUG); gst 1.26 treats that as a
# drain, flushes, and must renegotiate downstream before restarting
# capture. fakesink tolerates the renegotiation, so isolation tests pass —
# but any real chain (encoder→parse→mux→sink, already caps-locked) never
# completes it, and the decoder's capture task dies SILENTLY while its
# sink keeps eating v4l2src frames: no error, no backpressure, no files.
#
# The level=(string)4 caps filter is LOAD-BEARING: without it the encoder
# auto-negotiates baseline@level-1 (QCIF-class) for 720p30 — nothing
# downstream constrains the level, and gst tries the lowest first.
#
# v4l2h264enc wants bitrate/period via extra-controls (no properties);
# names confirmable with `v4l2-ctl -d /dev/video11 -L`. The encoder's
# firmware context needs gpu_mem=256 alongside front's ISP+encode
# (boot/config-snippet.txt): at the 76 MB default the extra context fails
# as REQBUFS ENOMEM or a global VCHIQ wedge that kills front too.
#
# muxer= / sink= (not muxer-properties, which splitmuxsink silently ignores
# unless async-finalize=true — the fragment-duration was never applied through
# it): fragmented MP4 for power-cut recovery, unbuffered filesink so completed
# fragments reach the card instead of dying in a 64 KB stdio buffer.
# The -m watcher patches each closed segment's declared duration (mvhd/mehd)
# — v4l2src's running time also grows continuously across segments, so the
# same qtmux absolute-duration bug applies here; details in front-rec.
#
# INVERT_REAR=1 (dashberry-install --invert-rear): the camera is mounted
# upside down. Unlike the front (where the ISP flips for free), this one
# costs a videoflip element between the decoder and the encoder — a row
# reversal on already-decoded I420, cheap next to the software jpegdec
# that is already in the chain, and nothing in the UVC gadget is asked to
# change (the Zero's image stays untouched, per the project rule). Rear
# footage lands upright, so every downstream consumer stays ignorant.
[ "${INVERT_REAR:-0}" = 1 ] && FLIP='videoflip method=vertical-flip !' || FLIP=

# REAR_GAMMA: the rear picture is too dark at night; the front (IMX708, HDR)
# is not. The fix lands here rather than at the source for two reasons: the
# Zero's showmewebcam image and its camera tuning are untouched by this tree
# (project rule), and at 30 fps the sensor's exposure is already capped at
# 33 ms — whatever its AE has left is gain, which buys the same noise this
# does without being switchable.
#
# Gamma, not a brightness offset or contrast stretch, and that choice IS the
# day/night balance: a gamma curve is pinned at both black and white, so it
# moves near-black pixels a great deal and near-white ones almost not at all.
# A night scene lives at the end that moves; a daylit one lives at the end
# that doesn't. So a single static value serves both, with no metering, no
# feedback loop, and no risk of clipping a bright sky — which a fixed
# brightness offset (shifts everything, blows the highlights) or the camera's
# own gain (amplifies before the encoder sees it) could not offer.
#
# 1.0 leaves the element out of the chain entirely rather than passing a
# no-op filter — an untuned card runs exactly the pipeline it ran before.
# Cost is a per-pixel LUT on the Y plane only, small next to the software
# jpegdec already in the chain, but it is not free: see sw/README.md.
case "${REAR_GAMMA:-1.0}" in
    1|1.0|1.00) GAMMA= ;;
    *)          GAMMA="gamma gamma=$REAR_GAMMA !" ;;
esac
stdbuf -oL gst-launch-1.0 -e -m v4l2src device="$REAR_CAM_DEV" \
    ! "image/jpeg,width=$REAR_W,height=$REAR_H,framerate=$REAR_FPS/1" \
    ! jpegdec \
    ! $FLIP $GAMMA v4l2h264enc extra-controls="controls,video_bitrate=$REAR_BITRATE,h264_i_frame_period=$REAR_FPS" \
    ! "video/x-h264,level=(string)4" \
    ! h264parse \
    ! splitmuxsink location="$OUT/%05d.mp4" \
        start-index="$START_INDEX" \
        max-size-time="$SEGMENT_NS" \
        muxer="mp4mux fragment-duration=$FRAGMENT_MS" \
        sink="filesink buffer-mode=unbuffered" |
while IFS= read -r line; do
    case $line in
    *splitmuxsink-fragment-closed*)
        loc=${line#*"location=(string)"}; loc=${loc%%,*}
        dur=${line#*"fragment-duration=(guint64)"}; dur=${dur%%[!0-9]*}
        mp4-set-duration "$loc" "$dur" || echo "mp4-set-duration failed: $loc" >&2
        ;;
    esac
done
# Watcher only ends when gst-launch died: nonzero → systemd restarts us.
exit 1
