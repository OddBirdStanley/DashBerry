#!/bin/sh
# rear-rec — rear UVC (showmewebcam) MJPEG → software decode → software
# H.264 (openh264) → 60 s MPEG-TS segments. Exits (→ systemd Restart) if the camera is
# absent; the Zero normally beats the Pi 4 to readiness since both power on
# ignition. Writes into the per-boot session directory minted by
# session-init: a restart REUSES the same session dir.
set -eu
. /etc/dashberry.conf

[ -e "$REAR_CAM_DEV" ] || { echo "rear-rec: $REAR_CAM_DEV not present yet"; sleep 2; exit 1; }

SESSION=$(cat "$SESSION_FILE")
OUT="$DATA/rear/$SESSION"
mkdir -p "$OUT"

# Restart-in-same-session: resume the %05d counter one past the highest
# existing segment (splitmuxsink start-index), so nothing is overwritten
# after an unplug/replug of the rear camera.
START_INDEX=$(ls "$OUT" 2>/dev/null | awk -F. '/^[0-9]+\.ts$/ { if ($1 + 1 > s) s = $1 + 1 } END { print s + 0 }')

# A crash-restart tail needs no repair: MPEG-TS has no header to finalize, so
# the previous run's truncated last file is just a shorter file (see
# front-rec for why the container changed).

# jpegdec (SOFTWARE, ~1/3 core at 720p30) — deliberately NOT v4l2jpegdec.
# The hardware decoder (bcm2835-codec, kernel 6.18) returns an empty
# V4L2_BUF_FLAG_LAST capture buffer after its FIRST frame ("Empty last
# buffer, signalling eos" under GST_DEBUG); gst 1.26 treats that as a
# drain, flushes, and must renegotiate downstream before restarting
# capture. fakesink tolerates the renegotiation, so isolation tests pass —
# but any real chain (encoder→parse→mux→sink, already caps-locked) never
# completes it, and the decoder's capture task dies SILENTLY while its
# sink keeps eating v4l2src frames: no error, no backpressure, no files.
#
# openh264enc (SOFTWARE, ~1 core at 720p30) — deliberately NOT
# v4l2h264enc, and for a second, INDEPENDENT gst-v4l2 element bug on this
# same kernel 6.18 + gst 1.26 pairing (bench 2026-08-05,
# cam/dashberry-rear-probe.sh): the hardware encoder is healthy as
# hardware — 325 fps fed by a non-live videotestsrc — but the
# v4l2h264enc ELEMENT collapses to ~5 fps the moment any LIVE source
# feeds it. Supply-independent: queues before/after, output-io-mode
# overrides, and front-rec on/off all change nothing, so the wait is
# internal to the element. Of every alternative probed (x264enc,
# avenc_h264_v4l2m2m, ffmpeg h264_v4l2m2m direct, io-modes), only
# openh264enc sustained the camera's full rate — 29.3 fps measured
# through this exact chain while front-rec recorded.
#
# The costs, accepted: baseline profile only (~10-20% less
# bitrate-efficient than a high-profile hw encode — tolerable while the
# Zero's ~25 Mbps MJPEG is the quality floor; raise REAR_BITRATE before
# blaming the encoder) and ~1 CPU core, which the Pi 4 has idle. If a
# thermal soak ever shows strain, complexity=low and multi-thread=N are
# the headroom knobs. The queue ahead of the encoder decouples
# capture+decode from encode so the software encoder pipelines across
# cores — part of the benched configuration, not an optimization.
# The old level=(string)4 caps filter was v4l2h264enc-specific (without
# it THAT element auto-negotiated baseline@level-1) and leaves with it.
# gpu_mem=256 (boot/config-snippet.txt) stays: front's ISP+encode still
# wants it — rear simply no longer adds a firmware codec context.
#
# muxer= / sink= (not muxer-properties, which splitmuxsink silently ignores
# unless async-finalize=true): MPEG-TS for power-cut survivability — no index
# to lose, so a truncated segment still reads — and an unbuffered filesink so
# a closed segment is not sitting in a 64 KB stdio buffer when the 12 V dies.
# Rationale in full, and the crash tail that prompted it, in front-rec.
# The -m watcher fsyncs each closed segment (and its directory entry); it is
# the only fsync in this capture path.
#
# INVERT_REAR (dashberry-install --invert-rear): the axes this camera's
# mounting has to be corrected on — v if it is mounted upside down, h if its
# image arrives mirrored (plates and signs read backwards), "v,h" for both,
# empty for neither. Unlike the front (where the ISP flips for free), this
# one costs a videoflip element between the decoder and the encoder — a
# reversal on already-decoded I420, cheap next to the software jpegdec that
# is already in the chain, and nothing in the UVC gadget is asked to change
# (the Zero's image stays untouched, per the project rule).
#
# Both axes at once is rotate-180 (vertical ∘ horizontal), NOT two elements,
# so the two-axis mount costs exactly what a one-axis mount does. Horizontal
# reverses within each row rather than reordering whole rows, so it is the
# less cache-friendly of the two — still small beside the software decode,
# but it is the one to name if a soak ever shows strain. Rear footage lands
# upright and un-mirrored, so every downstream consumer stays ignorant.
V=0 H=0
for axis in $(printf '%s' "${INVERT_REAR:-}" | tr ',' ' ' | tr '[:upper:]' '[:lower:]'); do
    case $axis in
    v) V=1 ;;
    h) H=1 ;;
    *) echo "rear-rec: ignoring unknown INVERT_REAR axis '$axis'" >&2 ;;
    esac
done
case "$V$H" in
    11) FLIP='videoflip method=rotate-180 !' ;;
    10) FLIP='videoflip method=vertical-flip !' ;;
    01) FLIP='videoflip method=horizontal-flip !' ;;
    *)  FLIP= ;;
esac

# REAR_GAMMA: the rear picture is too dark at night; the front (IMX708, HDR)
# is not. The fix lands here rather than at the source for two reasons: the
# Zero's showmewebcam image and its camera tuning are untouched by this tree
# (project rule), and at 30 fps the sensor's exposure is already capped at
# 33 ms — whatever its AE has left is gain, which buys the same noise this
# does without being switchable.
#
# Gamma, not a brightness offset or contrast stretch, and that choice IS the
# day/night balance: a gamma curve is pinned at both black and white, so it
# moves near-black pixels a great deal and near-white ones almost not at all.
# A night scene lives at the end that moves; a daylit one lives at the end
# that doesn't. So a single static value serves both, with no metering, no
# feedback loop, and no risk of clipping a bright sky — which a fixed
# brightness offset (shifts everything, blows the highlights) or the camera's
# own gain (amplifies before the encoder sees it) could not offer.
#
# 1.0 leaves the element out of the chain entirely rather than passing a
# no-op filter — an untuned card runs exactly the pipeline it ran before.
# Cost is a per-pixel LUT on the Y plane only, small next to the software
# jpegdec already in the chain, but it is not free: see sw/README.md.
case "${REAR_GAMMA:-1.0}" in
    1|1.0|1.00) GAMMA= ;;
    *)          GAMMA="gamma gamma=$REAR_GAMMA !" ;;
esac
stdbuf -oL gst-launch-1.0 -e -m v4l2src device="$REAR_CAM_DEV" \
    ! "image/jpeg,width=$REAR_W,height=$REAR_H,framerate=$REAR_FPS/1" \
    ! jpegdec \
    ! $FLIP $GAMMA queue max-size-buffers=8 \
    ! openh264enc bitrate="$REAR_BITRATE" gop-size="$REAR_FPS" \
    ! h264parse \
    ! splitmuxsink location="$OUT/%05d.ts" \
        start-index="$START_INDEX" \
        max-size-time="$SEGMENT_NS" \
        muxer=mpegtsmux \
        sink="filesink buffer-mode=unbuffered" |
while IFS= read -r line; do
    case $line in
    *splitmuxsink-fragment-closed*)
        loc=${line#*"location=(string)"}; loc=${loc%%,*}
        sync "$loc" "$OUT" || echo "sync failed: $loc" >&2
        ;;
    esac
done
# Watcher only ends when gst-launch died: nonzero → systemd restarts us.
exit 1
