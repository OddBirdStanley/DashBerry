#!/bin/sh
# rear-rec — rear UVC (DashBerry Zero) H.264 → 60 s MPEG-TS segments. The Zero
# encodes; this box only parses and muxes. Exits (→ systemd Restart) if the
# camera is absent; the Zero normally beats the Pi 4 to readiness since both
# power on ignition. Writes into the per-boot session directory minted by
# session-init: a restart REUSES the same session dir.
set -eu
. /etc/dashberry.conf

[ -e "$REAR_CAM_DEV" ] || { echo "rear-rec: $REAR_CAM_DEV not present yet"; sleep 2; exit 1; }

SESSION=$(cat "$SESSION_FILE")
OUT="$DATA/rear/$SESSION"
mkdir -p "$OUT"

# Restart-in-same-session: resume the %05d counter one past the highest
# existing segment (splitmuxsink start-index), so nothing is overwritten
# after an unplug/replug of the rear camera.
START_INDEX=$(ls "$OUT" 2>/dev/null | awk -F. '/^[0-9]+\.ts$/ { if ($1 + 1 > s) s = $1 + 1 } END { print s + 0 }')

# A crash-restart tail needs no repair: MPEG-TS has no header to finalize, so
# the previous run's truncated last file is just a shorter file (see
# front-rec for why the container changed).

# OPEN-SEGMENT SYNCER (2026-08-09) — identical to front-rec's, and for the
# same reason: the fragment-closed fsync below never fires for the segment
# being written when the 12 V dies, so nothing forced its partially-filled
# tail pages out and the 1 s journal commit had already written them with
# their remainders zeroed. Rear was hit as hard as front proportionally —
# 3 holes in a 3.9 s final segment cost 3.0 s of its video. Rationale, and
# what this does NOT guarantee on its own, in front-rec.
open_segment_syncer() {
    while sleep 1; do
        newest=$(ls "$OUT"/*.ts 2>/dev/null | tail -n 1)
        if [ -n "$newest" ]; then
            sync "$newest" 2>/dev/null || true
        fi
    done
}
open_segment_syncer &
SYNCER_PID=$!
trap 'kill "$SYNCER_PID" 2>/dev/null || true' EXIT INT TERM

# THE ENCODE LIVES ON THE ZERO (2026-08-13). This pipeline used to be
# v4l2src ! jpegdec ! videoflip ! gamma ! queue ! openh264enc ! h264parse !
# splitmuxsink — a software MJPEG decode and a software baseline H.264 encode,
# both on this box, alongside front-rec.
#
# It could not hold 30 fps at ANY mode. INVESTIGATE-REAR-ENCODE.md settled why:
# openh264enc runs one slice, one slice is one thread, and one thread on this
# box does ~65,000 macroblocks/s on a rolling scene. Measured, off the recorded
# files rather than the container's nominal rate:
#
#   1280x720 @ 8 Mbps   18.15 fps   65,340 MB/s
#   1640x922 @ 4 Mbps   10.77 fps   64,364 MB/s
#
# Within 1.5% of each other across a 2x bitrate change, so the bitrate was
# never the knob and REAR_BITRATE was never the fix. 720p30 needs 108,000 MB/s
# and 1640x922@30 needs 179,220: every mode this project ever considered,
# 720p30 included, wanted more than one core. The 40% aggregate CPU that made
# this look like headroom was one PINNED core plus front-rec with three cores
# idle, and iowait sat at ~2%, so the card was never implicated either.
# (The 29.3 fps IMPL.md used to record for 720p was a bench figure off a static
# scene, where the encoder skips most macroblocks. It did not transfer.)
#
# So the encode moved to the source. The Zero's VideoCore does 1080p30 in
# hardware, the DashBerry Zero image streams H.264 over the same UVC gadget,
# and this chain becomes a remux: no decode, no encode, no flip, no gamma.
# That deletes BOTH busy threads (~1.2 cores), not just the encoder one, and
# cuts USB traffic from tens of Mbps of MJPEG to ~1 MB/s.
#
# What moved with it, and where it went (zero/README.md, and rear-ctl):
#   INVERT_REAR   -> sensor hflip/vflip in the Zero's ISP. Free, and it
#                    replaces a full-frame videoflip copy of every frame.
#   REAR_GAMMA    -> GONE. Its job (rear reads dark at night, front does not)
#                    is now source-side exposure bias, REAR_EXPOSURE_BIAS.
#                    Better placed: gamma lifted shadow NOISE into the encode
#                    and then paid bitrate for it.
#   REAR_BITRATE  -> the Zero's V4L2_CID_MPEG_VIDEO_BITRATE, and the profile
#   REAR_GOP         is HIGH now rather than openh264's baseline-only.
#
# All four are still THIS box's to choose. rear-ctl pushes them over the
# Zero's control port before this unit is allowed to start (ExecStartPre), and
# faults if a read-back disagrees — the Zero is stateless across replug, so a
# push at boot alone would be worthless.
#
# h264parse config-interval=-1 puts SPS/PPS in front of every IDR, so a
# segment read on its own decodes from its first frame. The Zero also sets
# repeat_sequence_header, which does the same job at the source; this is the
# cheap belt beside that braces, and it costs a few bytes per GOP.
#
# Segment cuts now land on SOURCE keyframes: nothing here re-encodes, so
# splitmuxsink can only cut where the Zero put an IDR. REAR_GOP (27 = 0.9 s,
# detuned off ext4's 1 Hz commit tick — see front-rec) is pushed to the Zero's
# I-frame period for exactly this reason, and it makes a 60 s segment land
# within 0.9 s of 60 s rather than exactly on it.
#
# muxer= / sink= (not muxer-properties, which splitmuxsink silently ignores
# unless async-finalize=true): MPEG-TS for power-cut survivability — no index
# to lose, so a truncated segment still reads — and an unbuffered filesink so
# a closed segment is not sitting in a 64 KB stdio buffer when the 12 V dies.
# Rationale in full, and the crash tail that prompted it, in front-rec.
# The -m watcher fsyncs each closed segment (and its directory entry); the
# open-segment syncer above covers the one segment it cannot reach.
#
# The queue is the one element kept from the old chain: it decouples the USB
# read from the disk write, so a filesink stall cannot push back into the
# gadget and drop frames at the source.
stdbuf -oL gst-launch-1.0 -e -m v4l2src device="$REAR_CAM_DEV" \
    ! "video/x-h264,width=$REAR_W,height=$REAR_H,framerate=$REAR_FPS/1,stream-format=byte-stream,alignment=au" \
    ! h264parse config-interval=-1 \
    ! queue max-size-buffers=8 \
    ! splitmuxsink location="$OUT/%05d.ts" \
        start-index="$START_INDEX" \
        max-size-time="$SEGMENT_NS" \
        muxer=mpegtsmux \
        sink="filesink buffer-mode=unbuffered" |
while IFS= read -r line; do
    case $line in
    *splitmuxsink-fragment-closed*)
        loc=${line#*"location=(string)"}; loc=${loc%%,*}
        sync "$loc" "$OUT" || echo "sync failed: $loc" >&2
        ;;
    esac
done
# Watcher only ends when gst-launch died: nonzero → systemd restarts us.
exit 1
