#!/usr/bin/env python3
"""mp4-set-duration FILE {DURATION_NS|scan|repair} — rewrite a DashBerry
segment's declared duration boxes in place.

Works around a GStreamer 1.26 qtmux bug: in splitmuxsink's continuous-input
reuse pattern, mvhd/mehd get the muxer's ABSOLUTE running time (time since
service start) instead of this file's duration — players that trust the
declared duration (VLC) show segment N as N minutes long. The per-sample
data (tfdt/trun) is correct; only the declarations are wrong. front-rec and
rear-rec call this from splitmuxsink's fragment-closed message with the
authoritative duration.

Walks the box tree properly (no byte-scanning: fourcc strings can occur
inside mdat payload) and patches: mvhd + mehd (movie level), and tkhd +
mdhd (every track). Exit 0 on success.

Modes:
  DURATION_NS  the authoritative duration, straight from splitmuxsink's
               fragment-closed message (the live recorder path).
  scan         recover the duration from the sample tables (moof/traf/trun)
               and patch unconditionally — for a file whose fragment-closed
               message never fired.
  repair       same, but first read the DECLARED duration out of the file's
               head and do nothing when it is already plausible. This is the
               sweep path (tail-repair): it must look at every session on
               the card without pulling gigabytes off it, so an untouched
               file costs one short read instead of a full one.

The file's mtime is preserved across a patch. Two things on this card read
mtimes and would be misled by a repair sweep bumping them: the panel's
recording-alive check (newest segment in the LIVE session vs STALE_SECS)
and retention's delete-oldest-first ordering."""
import sys, struct, os


def boxes(buf, start, end):
    """Yield (fourcc, header_size, body_start, body_end) for boxes in [start, end)."""
    off = start
    while off + 8 <= end:
        size = struct.unpack_from(">I", buf, off)[0]
        typ = bytes(buf[off + 4:off + 8])
        hdr = 8
        if size == 1:
            size = struct.unpack_from(">Q", buf, off + 8)[0]
            hdr = 16
        elif size == 0:  # to end of enclosing box
            size = end - off
        if size < hdr or off + size > end:
            break  # damaged/truncated tail — stop cleanly
        yield typ, off, hdr, off + hdr, off + size
        off += size


def full_box(buf, body):
    version = buf[body]
    return version, body + 4  # skip version+flags


def patch(path, dur_ns):
    st = os.stat(path)
    with open(path, "r+b") as f:
        buf = bytearray(f.read())
        moov = None
        for typ, off, hdr, body, end in boxes(buf, 0, len(buf)):
            if typ == b"moov":
                moov = (body, end)
                break
        if moov is None:
            raise SystemExit(f"{path}: no moov box")

        writes = []  # (offset, packed bytes)

        def scale(timescale):
            return dur_ns * timescale // 1_000_000_000

        mvhd_timescale = None
        for typ, off, hdr, body, end in boxes(buf, *moov):
            if typ == b"mvhd":
                ver, p = full_box(buf, body)
                if ver == 1:
                    mvhd_timescale = struct.unpack_from(">I", buf, p + 16)[0]
                    writes.append((p + 20, struct.pack(">Q", scale(mvhd_timescale))))
                else:
                    mvhd_timescale = struct.unpack_from(">I", buf, p + 8)[0]
                    writes.append((p + 12, struct.pack(">I", scale(mvhd_timescale))))
            elif typ == b"mvex":
                for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                    if t2 == b"mehd":
                        ver, p = full_box(buf, b2)
                        if ver == 1:
                            writes.append((p, struct.pack(">Q", scale(mvhd_timescale))))
                        else:
                            writes.append((p, struct.pack(">I", scale(mvhd_timescale))))
            elif typ == b"trak":
                for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                    if t2 == b"tkhd":
                        # tkhd duration is in MOVIE timescale
                        ver, p = full_box(buf, b2)
                        if ver == 1:
                            writes.append((p + 24, struct.pack(">Q", scale(mvhd_timescale))))
                        else:
                            writes.append((p + 16, struct.pack(">I", scale(mvhd_timescale))))
                    elif t2 == b"mdia":
                        for t3, o3, h3, b3, e3 in boxes(buf, b2, e2):
                            if t3 == b"mdhd":
                                ver, p = full_box(buf, b3)
                                if ver == 1:
                                    ts = struct.unpack_from(">I", buf, p + 16)[0]
                                    writes.append((p + 20, struct.pack(">Q", scale(ts))))
                                else:
                                    ts = struct.unpack_from(">I", buf, p + 8)[0]
                                    writes.append((p + 12, struct.pack(">I", scale(ts))))

        if mvhd_timescale is None:
            raise SystemExit(f"{path}: no mvhd box")
        # Already-correct fields are left unwritten: the recorders' startup
        # tail re-scan, and the boot sweep, both hit already-correct files
        # routinely, and there is no reason to touch the card for them.
        patched = 0
        for off, data in writes:
            if buf[off:off + len(data)] != data:
                f.seek(off)
                f.write(data)
                patched += 1
        if patched:
            # The shutdown path patches the tail as the machine is going
            # down: a few hundred bytes, and no reason to leave them
            # depending on the journal commit that may not come.
            f.flush()
            os.fsync(f.fileno())
    if patched:
        # Restore the mtime we just bumped (see the module docstring): the
        # panel's liveness check and retention's ordering both read it, and
        # neither should see a repaired segment as freshly written.
        os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))
    return patched


MOOV_PREFIX = 1 << 18   # 256 KiB — ftyp+moov are the first few KiB of a
                        # fragmented MP4, so this always covers them


def declared_durations_ns(path):
    """EVERY duration the file declares — mvhd, mehd, and each track's tkhd
    and mdhd — normalized to ns, reading only the head of the file. Empty
    list when no moov is reachable in the prefix (truncated, or moov at the
    end: the caller then falls back to a full scan).

    All four and not just mvhd, because patch() writes them as four separate
    non-atomic writes, mvhd first: a power cut mid-patch leaves a file whose
    mvhd is right and whose tkhd/mdhd are stale. Reading only mvhd would
    call that file healthy and never look at it again."""
    with open(path, "rb") as f:
        buf = f.read(MOOV_PREFIX)
    moov = None
    for typ, off, hdr, body, end in boxes(buf, 0, len(buf)):
        if typ == b"moov":
            moov = (body, end)
            break
    if moov is None:
        return []

    out = []
    movie_ts = None       # mvhd is moov's first child, so this is set before
                          # the mehd/tkhd below need it (both are in movie
                          # timescale); if it somehow is not, they are skipped
                          # and the file reads as inconsistent, i.e. repaired.
    for typ, off, hdr, body, end in boxes(buf, *moov):
        if typ == b"mvhd":
            ver, p = full_box(buf, body)
            if ver == 1:
                movie_ts = struct.unpack_from(">I", buf, p + 16)[0]
                dur = struct.unpack_from(">Q", buf, p + 20)[0]
            else:
                movie_ts = struct.unpack_from(">I", buf, p + 8)[0]
                dur = struct.unpack_from(">I", buf, p + 12)[0]
            if movie_ts:
                out.append(dur * 1_000_000_000 // movie_ts)
        elif typ == b"mvex" and movie_ts:
            for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                if t2 == b"mehd":
                    ver, p = full_box(buf, b2)
                    dur = struct.unpack_from(">Q" if ver == 1 else ">I", buf, p)[0]
                    out.append(dur * 1_000_000_000 // movie_ts)
        elif typ == b"trak":
            for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                if t2 == b"tkhd" and movie_ts:
                    ver, p = full_box(buf, b2)
                    dur = (struct.unpack_from(">Q", buf, p + 24)[0] if ver == 1
                           else struct.unpack_from(">I", buf, p + 16)[0])
                    out.append(dur * 1_000_000_000 // movie_ts)
                elif t2 == b"mdia":
                    for t3, o3, h3, b3, e3 in boxes(buf, b2, e2):
                        if t3 != b"mdhd":
                            continue
                        ver, p = full_box(buf, b3)
                        if ver == 1:
                            ts = struct.unpack_from(">I", buf, p + 16)[0]
                            dur = struct.unpack_from(">Q", buf, p + 20)[0]
                        else:
                            ts = struct.unpack_from(">I", buf, p + 8)[0]
                            dur = struct.unpack_from(">I", buf, p + 12)[0]
                        if ts:
                            out.append(dur * 1_000_000_000 // ts)
    return out


# A segment's declared duration is believable only if it is in a narrow band
# AND the boxes agree with each other. All three ways it goes wrong fail one
# of those:
#   0          the muxer never finalized the file (power cut / SIGKILL) — the
#              moov it wrote up front still says zero.
#   >> 60 s    the muxer DID finalize, hitting the qtmux absolute-running-time
#              bug this tool exists for, and nothing patched it afterwards.
#   disagree   a patch was interrupted partway through its four writes.
# (Segment 00000 is immune to the second one: for the first file the muxer's
# absolute running time IS its duration, so it lands inside the band and is
# left alone — correctly, because it is already right.)
PLAUSIBLE_SLACK_NS = 30 * 10**9
# Values we wrote all derive from one dur_ns and differ only by timescale
# truncation, i.e. well under a millisecond. Anything above this is a real
# disagreement, never rounding.
CONSISTENT_SLACK_NS = 100 * 10**6


def durations_are_plausible(durs, segment_ns):
    if not durs:
        return False
    if max(durs) - min(durs) > CONSISTENT_SLACK_NS:
        return False                      # half-patched
    return 0 < min(durs) <= segment_ns + PLAUSIBLE_SLACK_NS


def scan_duration_ns(path):
    """Sum real sample durations from the moof/traf/trun boxes — for files
    whose fragment-closed message never fired (power cut, SIGKILL)."""
    with open(path, "rb") as f:
        buf = f.read()
    mdhd_timescale = None
    total = 0  # in mdhd timescale units
    trex_default = None
    for typ, off, hdr, body, end in boxes(buf, 0, len(buf)):
        if typ == b"moov":
            for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                if t2 == b"trak":
                    for t3, o3, h3, b3, e3 in boxes(buf, b2, e2):
                        if t3 == b"mdia":
                            for t4, o4, h4, b4, e4 in boxes(buf, b3, e3):
                                if t4 == b"mdhd" and mdhd_timescale is None:
                                    ver, p = full_box(buf, b4)
                                    mdhd_timescale = struct.unpack_from(
                                        ">I", buf, p + (16 if ver == 1 else 8))[0]
                elif t2 == b"mvex":
                    for t3, o3, h3, b3, e3 in boxes(buf, b2, e2):
                        if t3 == b"trex":
                            trex_default = struct.unpack_from(">I", buf, b3 + 16)[0]
        elif typ == b"moof":
            for t2, o2, h2, b2, e2 in boxes(buf, body, end):
                if t2 != b"traf":
                    continue
                tfhd_default = None
                for t3, o3, h3, b3, e3 in boxes(buf, b2, e2):
                    if t3 == b"tfhd":
                        flags = struct.unpack_from(">I", buf, b3)[0] & 0xFFFFFF
                        p = b3 + 8  # version/flags + track_ID
                        if flags & 0x1:
                            p += 8
                        if flags & 0x2:
                            p += 4
                        if flags & 0x8:
                            tfhd_default = struct.unpack_from(">I", buf, p)[0]
                    elif t3 == b"trun":
                        flags = struct.unpack_from(">I", buf, b3)[0] & 0xFFFFFF
                        count = struct.unpack_from(">I", buf, b3 + 4)[0]
                        p = b3 + 8
                        if flags & 0x1:
                            p += 4
                        if flags & 0x4:
                            p += 4
                        if flags & 0x100:
                            step = 4 * (
                                1 + bool(flags & 0x200) + bool(flags & 0x400)
                                + bool(flags & 0x800))
                            for _ in range(count):
                                if p + 4 > e3:
                                    break  # truncated trun
                                total += struct.unpack_from(">I", buf, p)[0]
                                p += step
                        else:
                            dflt = tfhd_default or trex_default or 0
                            total += count * dflt
    if not mdhd_timescale or not total:
        raise SystemExit(f"{path}: nothing to scan (timescale {mdhd_timescale}, total {total})")
    return total * 1_000_000_000 // mdhd_timescale


if __name__ == "__main__":
    if len(sys.argv) != 3:
        raise SystemExit("usage: mp4-set-duration FILE {DURATION_NS|scan|repair}")
    path, mode = sys.argv[1], sys.argv[2]
    name = os.path.basename(path)
    if mode == "repair":
        # SEGMENT_NS comes from /etc/dashberry.conf via the caller's
        # environment; the default matches the shipped 60 s segment.
        segment_ns = int(os.environ.get("SEGMENT_NS") or 60 * 10**9)
        declared = declared_durations_ns(path)
        if durations_are_plausible(declared, segment_ns):
            print(f"{name}: declares {min(declared) / 1e9:.3f}s, left alone")
            raise SystemExit(0)
    dur = scan_duration_ns(path) if mode in ("scan", "repair") else int(mode)
    n = patch(path, dur)
    print(f"{name}: patched {n} duration fields to {dur / 1e9:.3f}s")
