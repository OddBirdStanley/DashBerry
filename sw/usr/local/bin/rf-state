#!/bin/sh
# rf-state — enforce persisted RF state at boot, fail closed. (Renamed from
# rf-apply in rev 6; semantics unchanged since rev 4.)
# Runs from rf-state.service before the network stack (Before=network-pre.target),
# so the block lands before anything could key the radios.
# Rule: block unconditionally first; unblock ONLY if the state file is present,
# readable, and exactly "1". Missing/corrupt/unreadable → stay dark.
# Runtime toggling lives inside dashberry-panel (button A hold), not here.
. /etc/dashberry.conf

rfkill block wifi
rfkill block bluetooth

state=$(cat "$RF_STATE_FILE" 2>/dev/null) || exit 0
if [ "$state" = "1" ]; then
    rfkill unblock wifi
    rfkill unblock bluetooth
fi
exit 0
