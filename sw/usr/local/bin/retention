#!/bin/sh
# retention — delete oldest segments (front+rear pooled, across all session
# dirs) until free space on /data is back above RETENTION_FLOOR_MB. Runs from
# retention.timer every 5 min. GPS NMEA logs and health logs are tiny and
# never deleted here.
#
# NOTE: the free-space floor is retention's own target ONLY. The panel's
# Storage state does not key off it — panel ERR means actually-full/
# read-only/I/O-errors.
set -u
. /etc/dashberry.conf

avail_mb() { df -Pm "$DATA" | awk 'NR==2 {print $4}'; }

while [ "$(avail_mb)" -le "$RETENTION_FLOOR_MB" ]; do
    oldest=$(find "$DATA/front" "$DATA/rear" -name '*.ts' -printf '%T@ %p\n' 2>/dev/null |
             sort -n | head -n1 | cut -d' ' -f2-)
    [ -n "$oldest" ] || { echo "retention: below floor but nothing left to delete"; exit 1; }
    rm -f "$oldest" || { echo "retention: cannot delete $oldest (fs read-only?)"; exit 1; }
done

# Prune session dirs emptied by deletion (but never live ones — rmdir refuses
# non-empty dirs, and a live session dir always holds an in-flight segment).
find "$DATA/front" "$DATA/rear" -mindepth 1 -type d -empty -mmin +10 -exec rmdir {} + 2>/dev/null
exit 0
