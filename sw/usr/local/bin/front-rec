#!/bin/sh
# front-rec — front CSI camera → hardware H.264 → 60 s fragmented MP4 segments.
# rpicam-vid does the capture+encode+TS-mux; GStreamer only demuxes and remuxes,
# so a mux crash never touches the ISP. Writes into the per-boot session
# directory minted by session-init (rev 6): a recorder restart REUSES the same
# session dir.
set -eu
. /etc/dashberry.conf

SESSION=$(cat "$SESSION_FILE")
OUT="$DATA/front/$SESSION"
mkdir -p "$OUT"

# Restart-in-same-session: resume the %05d counter one past the highest
# existing segment so filenames never collide (splitmuxsink start-index).
START_INDEX=$(ls "$OUT" 2>/dev/null | awk -F. '/^[0-9]+\.mp4$/ { if ($1 + 1 > s) s = $1 + 1 } END { print s + 0 }')

# The previous run of THIS session may have died mid-segment (crash restart):
# that tail file's fragments are fine but its declared duration was never
# corrected (see below) — recover it from the sample tables before we start.
TAIL=$(ls "$OUT" 2>/dev/null | grep -E '^[0-9]+\.mp4$' | sort -n | tail -1)
[ -n "$TAIL" ] && mp4-set-duration "$OUT/$TAIL" scan || true

# Timestamps travel IN-BAND (settled on bench, third iteration): the encoder's
# own PTS/DTS ride the pipe inside an MPEG-TS container (--codec libav,
# hardware h264_v4l2m2m underneath, --libav-format mpegts), and tsdemux hands
# them to the muxer. Every earlier attempt to stamp a bare H.264 elementary
# stream on the receiving side (fdsrc do-timestamp + framerate caps +
# h264timestamper) was structurally broken: splitmuxsink prerolls async, so
# the pipeline has no clock until data already flowed — the leading frames
# can never be stamped, and mp4mux aborts on the first PTS-less buffer as
# soon as the first GOP leaves splitmuxsink's queue (the "~1 s in" crash).
# Needs full rpicam-apps (firstinstall.sh) — rpicam-apps-lite has no libav.
#
# --intra = 1 keyframe/s so splitmuxsink can cut close to the 60 s mark.
# muxer= / sink= (not muxer-properties, which splitmuxsink silently ignores
# unless async-finalize=true): fragment-duration keeps a power-cut segment
# playable up to its last ~1 s fragment, and the unbuffered filesink makes
# sure completed fragments actually reach the card instead of dying in a
# 64 KB stdio buffer.
#
# The -m watcher works around a GStreamer 1.26 qtmux bug (bench-verified,
# exact same build as the Pi): with continuous input running time, each
# segment's DECLARED duration (mvhd/mehd) is written as the muxer's absolute
# running time — segment N claims N minutes (VLC trusts the declaration;
# ffprobe scans and is immune), while tfdt/trun sample data is correct. A
# fresh muxer per fragment (async-finalize) inherits the same absolute time,
# so no splitmuxsink config avoids it. Instead: splitmuxsink posts
# splitmuxsink-fragment-closed with the file's true duration; we patch the
# boxes the moment each file closes. stdbuf keeps -m line-buffered so the
# patch happens within the second, not 4 KB of messages later.
# Focus is pinned at the hyperfocal position (--autofocus-mode manual with
# --lens-position default = rpicam's hyperfocal setting): a dashcam lens must
# never hunt — rain/dirt on the windshield sits far inside the minimum focus
# distance and continuous AF would pull focus off the road for it. VERIFY on
# bench: footage sharp from hood to infinity, day and night.
rpicam-vid -t 0 -n \
    --width "$FRONT_W" --height "$FRONT_H" --framerate "$FRONT_FPS" \
    --bitrate "$FRONT_BITRATE" --intra "$FRONT_FPS" \
    --autofocus-mode manual --lens-position default \
    --codec libav --libav-format mpegts -o - |
stdbuf -oL gst-launch-1.0 -e -m fdsrc fd=0 \
    ! tsdemux \
    ! h264parse \
    ! splitmuxsink location="$OUT/%05d.mp4" \
        start-index="$START_INDEX" \
        max-size-time="$SEGMENT_NS" \
        muxer="mp4mux fragment-duration=$FRAGMENT_MS" \
        sink="filesink buffer-mode=unbuffered" |
while IFS= read -r line; do
    case $line in
    *splitmuxsink-fragment-closed*)
        loc=${line#*"location=(string)"}; loc=${loc%%,*}
        dur=${line#*"fragment-duration=(guint64)"}; dur=${dur%%[!0-9]*}
        mp4-set-duration "$loc" "$dur" || echo "mp4-set-duration failed: $loc" >&2
        ;;
    esac
done
# The watcher only ends when gst-launch died (EOS/EOF): report failure so
# systemd restarts us — a clean stop SIGTERMs the whole group before this.
exit 1
