#!/bin/sh
# rf-ctl — the radio half of JOIN WIFI, run by dashberry-panel.
#
# The panel forks this for every radio operation and polls its stdout, so
# nothing here may assume a terminal and nothing may take longer than the
# panel's per-command deadline (scan 25 s, down 15 s, connect 30 s — past
# it the panel SIGKILLs the whole process group). Exit status is the whole answer for `down` and
# `connect`; `scan` additionally prints one SSID per line on stdout.
#
# NetworkManager is the stack (Trixie, same assumption dashberry-install
# makes when it stages a first-boot profile). wpa_supplicant is never
# driven directly.
#
#   rf-ctl scan        unblock the radios, rescan, print the SSIDs in range
#   rf-ctl connect     read SSID then passphrase from STDIN (one per line),
#                      write a 0600 keyfile and bring it up
#   rf-ctl down        drop the profile and block the radios again
#   rf-ctl boot-kill   assert the block at boot, after every replayer, and
#                      prove it (dashberry-rfkill.service — not the panel)
#
# The passphrase arrives on stdin and is written under umask 077 — it is
# never an argument (argv is world-readable through /proc), never echoed,
# and never logged. On a production card /etc is an overlayfs whose upper
# layer is tmpfs, so the keyfile dies with the power: that is what makes
# "rebooting places the card in RF-KILLED again" true for credentials too.
set -eu

PROFILE_ID=dashberry-join
PROFILE=/etc/NetworkManager/system-connections/$PROFILE_ID.nmconnection

command -v nmcli >/dev/null 2>&1 || {
    echo "rf-ctl: nmcli not found — this card has no NetworkManager" >&2
    # boot-kill must fail CLOSED. Blocking the kernel switch does not need
    # NetworkManager, and a card with no nmcli is the last one that should
    # be left with its radios up because a helper was missing.
    [ "${1:-}" = boot-kill ] || exit 1
}

# Remove the profile whether or not it is up. Never fatal: `down` must
# always reach the rfkill block below, and `connect` uses this to clean up
# a failed attempt before reporting the failure.
drop_profile() {
    nmcli connection down "$PROFILE_ID" >/dev/null 2>&1 || true
    rm -f "$PROFILE"
    nmcli connection reload >/dev/null 2>&1 || true
}

# True while some wlan rfkill switch is clear BOTH ways — byte for byte the
# condition the panel's glyph reads (rf_unblocked() in dashberry-panel.c)
# and the one firstinstall's radios_off proves against, so no two of them
# can ever disagree about what RF-ENABLED means. No wlan switch at all
# counts as blocked, exactly as it does there.
rf_live() {
    for _s in /sys/class/rfkill/rfkill*; do
        [ -d "$_s" ] || continue
        [ "$(cat "$_s/type" 2>/dev/null)" = wlan ] || continue
        [ "$(cat "$_s/soft" 2>/dev/null)" = 0 ]    || continue
        [ "$(cat "$_s/hard" 2>/dev/null)" = 0 ]    || continue
        return 0
    done
    return 1
}

case "${1:-}" in
scan)
    # rfkill first: NetworkManager will not scan through a soft block, and
    # WirelessEnabled=false is exactly what firstinstall persisted.
    rfkill unblock wifi 2>/dev/null || true
    nmcli radio wifi on >/dev/null 2>&1 || true

    # A hard block here means no regulatory domain (the card was built
    # without --wifi-country) — the radios cannot legally key up, so say
    # so rather than printing an empty list that looks like "no APs".
    if rfkill list wifi 2>/dev/null | grep -q 'Hard blocked: yes'; then
        echo "rf-ctl: wlan is hard-blocked (no regulatory domain?)" >&2
        exit 1
    fi

    # `nmcli radio wifi on` returns as soon as NM has accepted the property
    # change — the device is NOT usable yet. On a production card the radio
    # has been off since boot (firstinstall persisted WirelessEnabled=false),
    # so enabling it starts a full bring-up: firmware load, interface up,
    # wlan0 unavailable -> disconnected. Scanning inside that window is the
    # bug this wait exists to kill: NM has no scannable device, the scan
    # comes back empty, and JW-1 says NO NETWORKS the instant the user
    # long-presses A — identical on screen to standing out of range.
    # Bounded well inside the panel's 25 s scan deadline.
    i=0
    while [ "$i" -lt 30 ]; do
        # -t gives 'TYPE:STATE' per line; take the STATE of the first plain
        # wifi device. sed, not awk: rf-ctl already depends on sed/grep/sort
        # and nothing else, and this must run on a minimal card.
        # '^wifi:' cannot match a 'wifi-p2p:' line.
        state=$(nmcli -t -f TYPE,STATE device status 2>/dev/null |
                sed -n 's/^wifi://p' | head -n 1)
        case $state in
            ''|unavailable|unmanaged) ;;
            *) break ;;
        esac
        sleep 0.2
        i=$((i + 1))
    done

    # --rescan yes forces a fresh sweep instead of NM's cached list.
    # Captured, not piped straight through: the exit status of a pipeline is
    # its LAST command (`sort`, always 0), so piping hid every nmcli failure
    # behind an empty list — and an empty list is a legitimate answer here,
    # which made a broken radio and an empty sky the same screen. Now a scan
    # that FAILS exits non-zero (JW-1: RF ERROR) and only a scan that
    # SUCCEEDS with nothing in range prints nothing (JW-1: NO NETWORKS).
    if ! raw=$(nmcli -t -f SSID device wifi list --rescan yes 2>&1); then
        echo "rf-ctl: scan failed: $raw" >&2
        exit 1
    fi
    # NM can return an empty list on the first sweep after a cold radio even
    # once the device is available (the bring-up finished, the first scan
    # did not). One retry, still inside the deadline, rather than reporting
    # an empty sky the user can see is wrong.
    if [ -z "$raw" ]; then
        sleep 2
        raw=$(nmcli -t -f SSID device wifi list --rescan yes 2>/dev/null) || true
    fi

    # -t -f SSID prints one field per line, backslash-escaping ':' and
    # '\' — undo exactly those two, in that order. Hidden APs come back
    # as an empty field and are dropped: there is nothing to display and
    # nothing the JW-1 list could usefully select.
    printf '%s\n' "$raw" |
        sed -e 's/\\:/:/g' -e 's/\\\\/\\/g' |
        grep -v '^[[:space:]]*$' |
        sort -u
    exit 0
    ;;

connect)
    # Line 1 = SSID, line 2 = passphrase (may be empty for an open AP).
    IFS= read -r SSID || SSID=
    IFS= read -r PSK   || PSK=
    [ -n "$SSID" ] || { echo "rf-ctl: no SSID on stdin" >&2; exit 1; }

    drop_profile
    # printf, not a heredoc: the passphrase must land byte-for-byte
    # ($, \, %s-safe). umask 077 so it is never world-readable even
    # briefly — NM refuses keyfiles that are not 600 anyway.
    (
        umask 077
        {
            printf '[connection]\nid=%s\nuuid=%s\ntype=wifi\nautoconnect=false\n\n' \
                "$PROFILE_ID" "$(cat /proc/sys/kernel/random/uuid)"
            printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$SSID"
            if [ -n "$PSK" ]; then
                printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$PSK"
            fi
            printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
        } > "$PROFILE"
    )
    chmod 600 "$PROFILE"
    nmcli connection reload >/dev/null 2>&1 || true

    # --wait: nmcli returns only once the connection is actually up
    # (association AND addressing), which is what the panel reports. Kept
    # under the panel's 30 s deadline, with room for the teardown below, so
    # the child exits on its own and the SIGKILL path stays theoretical.
    # A join that has not completed in 25 s has failed in practice.
    if nmcli --wait 25 connection up "$PROFILE_ID" >/dev/null 2>&1; then
        exit 0
    fi
    # Failed: leave nothing half-up. The radios stay ENABLED on purpose —
    # the user is standing at the car and gets another try without
    # re-arming; the bare-antenna glyph is what reports the failure.
    drop_profile
    exit 1
    ;;

down)
    drop_profile
    # Persisted (NetworkManager.state) on a writable OS; on a production
    # card the write lands in the overlay and the frozen state is already
    # false. Either way the radios are down now.
    nmcli radio wifi off >/dev/null 2>&1 || true
    rfkill block wifi 2>/dev/null || true
    ;;

boot-kill)
    # Once per boot, from dashberry-rfkill.service, ordered after the last
    # thing that can speak for the wlan switch. Until this existed a boot's
    # RF state was decided entirely by STATE — the frozen
    # NetworkManager.state and rfkill state files — with nothing asserting
    # it afterwards, so any card whose OS turned out to be writable (an
    # overlay that silently failed to arm, a debug card, a card someone
    # unsealed) carried a JOIN WIFI session's WirelessEnabled=true across
    # every later boot, permanently, with no code path on the card able to
    # undo it (field-observed 2026-08-08). This makes RF-KILLED-at-boot
    # true by assertion instead of inferred from three layers cooperating.
    #
    # No drop_profile: the panel writes that keyfile after boot, and a
    # session the user opens later is not this unit's business — it runs
    # once, latched by RemainAfterExit.
    #
    # `nmcli radio wifi off` leads for its side effect as much as its
    # effect: on a writable OS it rewrites WirelessEnabled=false into
    # NetworkManager.state, so a card poisoned by an earlier session heals
    # on this boot instead of replaying that session forever.
    nmcli radio wifi off >/dev/null 2>&1 || true
    rfkill block wifi 2>/dev/null || true

    # Winning the ordering race is not winning the write: NM applies the
    # killswitch asynchronously and can assert an unblock a moment after
    # ours lands. So re-assert while anything brings the switch back, and
    # only believe it once it has stayed down for 5 straight polls (1 s).
    # Capped at 5 s. A quiet boot leaves this loop after ~1 s, and nothing
    # is ordered after this unit, so no part of the drive waits on it.
    i=0
    quiet=0
    while [ "$i" -lt 25 ] && [ "$quiet" -lt 5 ]; do
        if rf_live; then
            nmcli radio wifi off >/dev/null 2>&1 || true
            rfkill block wifi 2>/dev/null || true
            quiet=0
        else
            quiet=$((quiet + 1))
        fi
        sleep 0.2
        i=$((i + 1))
    done

    if rf_live; then
        # Reported, not fatal — the card must still record. The panel's
        # glyph reads the switch directly, so the OLED already says so.
        echo "rf-ctl: wlan is STILL live after boot-kill — this card came" >&2
        echo "        up RF-ENABLED and something is re-asserting it" >&2
        exit 1
    fi
    ;;

*)
    echo "usage: rf-ctl scan|connect|down|boot-kill" >&2
    exit 2
    ;;
esac
