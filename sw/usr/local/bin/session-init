#!/bin/sh
# session-init — mint the per-boot session name and directories.
# Name: <YYYYmmdd-HHMMSS>-<NNNN> — RTC-backed clock plus a monotonic boot
# counter, so session names stay unique (and one-session ⇔ one-DRIVE grouping
# stays structural) even across boots with a wrong RTC.
# Runs once per boot (session.service, oneshot) after /data mounts; recorders
# and gps-log read $SESSION_FILE instead of minting their own timestamps.
set -eu
. /etc/dashberry.conf

mkdir -p /run/dashberry

# --- wall clock sanity ------------------------------------------------------
# The name below, and the mtime of every directory made here, are stamped from
# the wall clock at the earliest moment of the boot that /data exists — which
# is before anything guarantees that clock is right. The DS3231 sets it when
# its driver (a udev-loaded module) probes, and this unit is only ordered
# after basic.target: usually the RTC wins, not always. Losing that race mints
# a session named from whatever came before — which, since firstinstall masks
# fake-hwclock, is now 1970 and nothing else. That is deliberate: fake-hwclock
# used to hand over a wrong-but-PLAUSIBLE time (the last save), and the floor
# test below cannot see a clock that is merely hours off, so the fault stayed
# invisible. An absurd clock trips the floor and announces itself; a plausible
# one does not. The wrong name still outlives the drive (nothing revisits it).
# Details, and how to tell the timestamp faults apart on a pulled card:
# INVESTIGATE-TIMESTAMPS.md.
clock_ok() { [ "$(date +%s)" -ge "${CLOCK_FLOOR:-0}" ]; }
if ! clock_ok && [ "${BYPASS_TIME:-0}" != 1 ]; then
    # Re-read the RTC ourselves (same read the kernel does at probe) and give
    # it a bounded moment to appear. A healthy card never enters this loop.
    i=0
    while [ "$i" -lt 10 ] && ! clock_ok; do
        hwclock -s 2>/dev/null || true
        sleep 0.5
        i=$((i + 1))
    done
fi
if ! clock_ok; then
    # Mint anyway — the boot counter keeps the name unique, and one session
    # dir is still one drive — but never silently: a wrong clock also makes
    # retention delete the newest footage first.
    echo "session-init: WARNING clock reads $(date -u '+%F %T') UTC, before the" >&2
    echo "  CLOCK_FLOOR sanity floor. This session's name and directory" >&2
    echo "  timestamps will be wrong. Causes: a DS3231 that was never set" >&2
    echo "  (not fitted when firstinstall ran — it is the only thing that" >&2
    echo "  ever writes it) or has a dead cell, or a --bypass-time card with" >&2
    echo "  no GPS fix yet. On the Pi: hwclock -r" >&2
fi

# Boot counter: atomic increment (tmp -> fsync -> rename), garbage-tolerant.
c=$(cat "$DATA/.boot-counter" 2>/dev/null || echo 0)
case "$c" in
    ''|*[!0-9]*) c=0 ;;
esac
c=$((c + 1))
printf '%s' "$c" > "$DATA/.boot-counter.tmp"
sync "$DATA/.boot-counter.tmp"
mv "$DATA/.boot-counter.tmp" "$DATA/.boot-counter"
sync "$DATA"

SESSION="$(date +%Y%m%d-%H%M%S)-$(printf '%04d' $((c % 10000)))"
mkdir -p "$DATA/front/$SESSION" "$DATA/rear/$SESSION" "$DATA/gps/$SESSION" \
         "$DATA/health/$SESSION"
printf '%s' "$SESSION" > "$SESSION_FILE"
echo "session-init: session $SESSION (boot #$c)"
