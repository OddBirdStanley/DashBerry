[Unit]
Description=DashBerry boot spinner (OLED placeholder until the panel starts)
# Not enabled anywhere: udev pulls this in (99-dashberry.rules) the moment
# the ssd130x framebuffer registers — earliest possible pixel ownership,
# hence no default deps either.
DefaultDependencies=no
# Handoff: starting panel.service stops the spinner first (Conflicts= plus
# the Before= ordering), so the OLED has exactly one writer at any time.
Conflicts=panel.service shutdown.target
Before=panel.service shutdown.target

[Service]
ExecStart=/usr/local/bin/dashberry-panel --spinner
