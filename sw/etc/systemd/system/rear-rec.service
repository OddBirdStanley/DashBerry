[Unit]
Description=Rear camera recorder (UVC MJPEG -> hw transcode -> H.264 segments)
PartOf=dashberry.target
RequiresMountsFor=/data
# Session dir/name comes from session-init; never start without it.
Requires=session.service
After=session.service

[Service]
ExecStart=/usr/local/bin/rear-rec
# Restart=always is the late/re-enumeration strategy: if the Zero isn't up yet
# (or drops mid-run), the unit exits and retries until the camera is back.
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=10
# Repair the in-flight segment's declared duration once the cgroup is dead
# (the watcher that normally does it is inside that cgroup) — see
# front-rec.service. `current rear` so a front-rec restart can never touch
# a segment this recorder is still writing.
ExecStopPost=/usr/local/bin/tail-repair current rear

[Install]
WantedBy=dashberry.target
