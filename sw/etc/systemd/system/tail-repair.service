[Unit]
Description=Repair the previous drive's last video segment (declared duration)
PartOf=dashberry.target
RequiresMountsFor=/data
# Needs the live session name so the sweep can skip the dir the recorders
# are about to write into. Ordering only: if session-init failed there are
# no recorders either, and the sweep declines to run.
After=session.service
# Deliberately NOT ordered before the recorders: it only ever touches
# sessions from previous boots, so it can run alongside them and must never
# delay the start of recording.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tail-repair stale

[Install]
WantedBy=dashberry.target
