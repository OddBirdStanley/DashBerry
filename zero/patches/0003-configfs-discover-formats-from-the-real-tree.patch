From: DashBerry <zero/README.md>
Subject: [PATCH] configfs: discover formats from the real tree, not the symlinks

uvc-gadget finds its formats by ftw()-ing configfs and matching paths that
contain "streaming/class/". Those paths exist only through symlinks, and ftw()
does not descend into the class/<speed> ones. Measured on the device:

    ftw returned 0 (errno 0: none); files seen 122, under streaming/class 0

122 files walked, not one under streaming/class - while find -follow reaches
them and cat reads through them. So no format was ever recorded and the only
symptom was "configfs settings for uvc gadget not found".

The real path carries everything except the speed:

    .../streaming/<format>/<instance>/<frame>/<attribute>

confirmed on the device:

    .../uvc.usb0/streaming/framebased/h/922p/wWidth
    .../uvc.usb0/streaming/framebased/h/bFormatIndex

so this matches that shape too and registers each frame for fs, hs and ss.
multi-gadget.sh links the same header into all three class/<speed> groups, so
every format really is offered at every speed.

bFormatIndex is taken from the format level as well - it is the format's
position in the USB descriptors, the number the host selects by, and without it
the table is built in readdir order and the host's choice lands on the wrong
entry.

arr[0] is checked against the real format directory names because ftw() DOES
follow the format links inside streaming/header/<h>/, producing paths like
header/h/h/guidFormat with the same component count as a genuine frame path.
Without that check they become entries whose "frame" is an attribute name, and
set_uvc_format_value() then puts the real geometry on the wrong entry: measured
as 33 entries, all "format: 2, resolution: 0x0", and a host asking for H.264
being handed MJPEG.

It also PRINTS every derived part. Three revisions of this function have each
been corrected by the next log rather than by reading the code, so the mapping
from real path to synthesised part is recorded rather than assumed.
---
diff --git a/uvc-gadget.c b/uvc-gadget.c
index b16475a..e89a00f 100644
--- a/uvc-gadget.c
+++ b/uvc-gadget.c
@@ -2211,10 +2211,88 @@ static void configfs_fill_streaming_params(const char* path, const char * part)
 static int dashberry_files_seen = 0;
 static int dashberry_files_matched = 0;
 
+/* DashBerry: discover formats from the REAL directories, not the class/ view.
+ *
+ * configfs exposes the streaming formats twice: once at their real path,
+ *     .../streaming/<format>/<instance>/<frame>/<attribute>
+ * and once through symlinks under
+ *     .../streaming/class/<speed>/<header>/<instance>/<frame>/<attribute>
+ * and this walk only ever matched the second. ftw() does not descend into
+ * those symlinks on configfs - measured on the device: 122 files seen, 0
+ * under streaming/class - so no format was ever recorded and the only
+ * symptom was "configfs settings for uvc gadget not found".
+ *
+ * The real path carries everything except the speed. multi-gadget.sh links
+ * the same header into class/fs, class/hs and class/ss, so every format is
+ * available at every speed, and the entry is registered for each in turn -
+ * which is exactly what walking the class/ view would have produced.
+ */
+static void configfs_fill_formats_real(const char * path, const char * part)
+{
+    static const char * const speeds[] = { "fs", "hs", "ss" };
+    char synth[256];
+    char * copy = strdup(part);
+    char * tok = strtok(copy, "/");
+    char * arr[8];
+    int n = 0;
+    unsigned int i;
+
+    while (tok != NULL && n < 8) {
+        arr[n++] = tok;
+        tok = strtok(NULL, "/");
+    }
+
+    /* Print what was actually derived. Three patches to this function have
+     * been corrected by the NEXT log rather than by reading it, so the mapping
+     * from real path to synthesised part is no longer something to deduce. */
+    printf("CONFIGFS: real n=%d part='%s'\n", n, part);
+
+    /* arr[0] must be a real FORMAT directory. ftw() follows the format links
+     * inside streaming/header/<h>/ too, which yields paths like
+     *     header/h/h/guidFormat
+     * with the same component count as a genuine frame path. Feeding those in
+     * invents entries whose "frame" is an attribute name, and because
+     * set_uvc_format_value() applies to whatever entry was created last, the
+     * real width and height then land on the wrong one. The measured result
+     * was 33 entries, every one of them "format: 2, resolution: 0x0", and a
+     * host offered MJPEG when it asked for H.264. */
+    if (n < 1 ||
+        (strcmp(arr[0], "framebased") && strcmp(arr[0], "mjpeg") &&
+         strcmp(arr[0], "uncompressed"))) {
+        free(copy);
+        return;
+    }
+
+    if (n == 4) {
+        /* <format>/<instance>/<frame>/<attribute> - the frame geometry. */
+        for (i = 0; i < sizeof(speeds) / sizeof(speeds[0]); i++) {
+            snprintf(synth, sizeof(synth), "%s/h/%s/%s/%s",
+                     speeds[i], arr[1], arr[2], arr[3]);
+            configfs_fill_formats(path, synth);
+        }
+    } else if (n == 3 && !strcmp(arr[2], "bFormatIndex")) {
+        /* <format>/<instance>/bFormatIndex - the format's position in the
+         * descriptors, which is what the host selects by. Without it the
+         * table is built in readdir order and the daemon maps the host's
+         * chosen index onto the wrong format: asking for H.264 and being
+         * handed MJPEG. Only this one attribute is taken from the format
+         * level; the rest (guidFormat, bmaControls, aspect ratios) are not
+         * numbers and would only produce parse noise. */
+        for (i = 0; i < sizeof(speeds) / sizeof(speeds[0]); i++) {
+            snprintf(synth, sizeof(synth), "%s/h/%s/%s",
+                     speeds[i], arr[1], arr[2]);
+            configfs_fill_formats(path, synth);
+        }
+    }
+
+    free(copy);
+}
+
 static int configfs_path_check(const char* fpath, const struct stat * sb, int tflag)
 {
     int uvc = find_text_pos(fpath, "/uvc");
     int streaming = find_text_pos(fpath, "streaming/class/");
+    int streaming_real = find_text_pos(fpath, "/streaming/");
     int streaming_params = find_text_pos(fpath, "/streaming_");
     (void)(tflag); /* avoid warning: unused parameter 'tflag' */
 
@@ -2224,6 +2302,10 @@ static int configfs_path_check(const char* fpath, const struct stat * sb, int tf
             dashberry_files_matched++;
             configfs_fill_formats(fpath, fpath + streaming + 16);
 
+        } else if (streaming_real && uvc) {
+            dashberry_files_matched++;
+            configfs_fill_formats_real(fpath, fpath + streaming_real + 11);
+
         } else if (streaming_params) {
             configfs_fill_streaming_params(fpath, fpath + streaming_params + 11);
 
