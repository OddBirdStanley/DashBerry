#!/bin/sh
# Start rear-ctld once the USB gadget exists, so /dev/ttyGS1 is there to open.
# S95: after showmewebcam's own gadget bringup (which creates the ACM
# functions and starts uvc-gadget), and after the getty that owns ttyGS0.
DAEMON=/usr/bin/rear-ctld
PIDFILE=/var/run/rear-ctld.pid

case "$1" in
start)
    printf 'Starting rear-ctld: '
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" && echo OK || echo FAIL
    ;;
stop)
    printf 'Stopping rear-ctld: '
    start-stop-daemon -K -q -p "$PIDFILE" && echo OK || echo FAIL
    ;;
restart|reload)
    "$0" stop; sleep 1; "$0" start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
