[Unit]
Description=Keep the UVC gadget activated so the card enumerates without uvc-gadget
# After the daemon that should normally do this, so it can stand down if that
# succeeded.
After=uvc-webcam.service usb-gadget-config.service

[Service]
ExecStart=/usr/bin/uvc-activate
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=uvc-activate

[Install]
WantedBy=basic.target
