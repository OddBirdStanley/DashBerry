#!/bin/bash
# dashberry-install — ALL-IN-ONE card builder for the DashBerry Pi 4 (PC-side).
#
# Replaces sw/install.sh (which ran on the Pi): one command takes a stock
# Raspberry Pi OS Lite image you already downloaded (nothing is ever fetched
# here) and a target block device, and produces a card that boots straight
# into a self-installing DashBerry:
#
#   1. flashes the image — after a typed confirmation; the device is WIPED;
#   2. grows the OS partition to a fixed working size (default 4 GiB) instead
#      of letting first boot swallow the card — this is the volume that ends
#      up READ-ONLY (overlayfs, enabled at the end of the first-boot install);
#   3. creates the writable /data partition (ext4, rest of the card) and
#      appends its fstab entry (by PARTUUID; options from etc/fstab.snippet);
#   4. merges boot/config-snippet.txt into config.txt;
#   5. stages sw/ at /opt/dashberry/sw and enables a oneshot first-boot
#      service that installs packages, builds dashberry-panel, enables the
#      units, flips the OS read-only, and reboots (sw/firstinstall.sh);
#   6. (--wifi) stages a first-boot-ONLY Wi-Fi profile plus the regulatory
#      domain that stock Pi OS (Trixie) needs before it will unblock wlan, so
#      boot 2 can run without Ethernet — firstinstall wipes every trace of
#      it before the overlay freezes the OS and RF lockdown arms.
#
# The stock image's own auto-expand is left in place and self-disarms: it
# refuses to grow a root partition that is not the last one, and /data is.
#
# PC-side tooling, so the on-image no-interpreters rule doesn't bind; bash
# rather than Python because this is pure dd/sfdisk/mkfs orchestration.
set -euo pipefail

usage() {
    cat <<'EOF'
usage: sudo dashberry-install [options] <image> <device>

  <image>   Raspberry Pi OS Lite (64-bit) image, ALREADY DOWNLOADED —
            .img, .img.xz, .img.gz or .zip. This tool never downloads.
  <device>  target block device (whole disk, e.g. /dev/sdb or /dev/mmcblk0).
            Must be 8 GB or bigger. ALL DATA ON IT WILL BE ERASED.

options:
  --bypass-time     no DS3231 fitted: skip the RTC overlay, let chrony trust
                    GPS for wall time, and drop TIME from the panel health
                    model (never shown on the OLED error screen)
  --bypass-rear     no rear camera: rear-rec is not enabled and REAR is
                    dropped from the panel health model (never on the error
                    screen)
  --root-size GIB   OS (read-only) partition size in GiB (default 4)
  --writable        skip the read-only overlay step — for bench iteration;
                    enable later with: sudo raspi-config nonint do_overlayfs 0
  --user NAME:PASS  create the first-boot user via userconf.txt (headless
                    setup; note the password is visible in shell history)
  --ssh             enable ssh from first boot
  --wifi SSID:PSK   run the first boot over Wi-Fi instead of Ethernet: a
                    NetworkManager profile is staged for boots 1-2 only and
                    firstinstall wipes it (profile, leases, logs) before RF
                    lockdown arms. Needs a NetworkManager image — Trixie
                    Lite is one (anything bookworm+ works, bullseye is not);
                    SSID must not contain ':'; PSK visible in shell history
  --wifi-country CC two-letter regulatory domain (required with --wifi —
                    without one the stock image keeps wlan rfkill-blocked)
  -h, --help        this text
EOF
}

die()  { echo "dashberry-install: error: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing tool: $1"; }

# "8 GB" cards are ~7.9e9 real bytes; below this is not an 8 GB device.
MIN_DEV_BYTES=7700000000
MIN_DATA_BYTES=$((1024 * 1024 * 1024))    # refuse a /data smaller than 1 GiB

BYPASS_TIME=0
BYPASS_REAR=0
ROOT_GIB=4
READONLY=1
USERSPEC=
WANT_SSH=0
WIFISPEC=
WIFI_CC=
WIFI_SSID=
FIRSTBOOT_WIFI=0
IMG=
DEV=

while [ $# -gt 0 ]; do
    case $1 in
        --bypass-time) BYPASS_TIME=1 ;;
        --bypass-rear) BYPASS_REAR=1 ;;
        --root-size)   shift; ROOT_GIB=${1:-} ;;
        --writable)    READONLY=0 ;;
        --user)        shift; USERSPEC=${1:-} ;;
        --ssh)         WANT_SSH=1 ;;
        --wifi)        shift; WIFISPEC=${1:-} ;;
        --wifi-country) shift; WIFI_CC=${1:-} ;;
        -h|--help)     usage; exit 0 ;;
        -*)            die "unknown option: $1 (see --help)" ;;
        *)             if   [ -z "$IMG" ]; then IMG=$1
                       elif [ -z "$DEV" ]; then DEV=$1
                       else die "too many arguments (see --help)"; fi ;;
    esac
    shift
done

[ -n "$IMG" ] && [ -n "$DEV" ] || { usage >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root (flashing and mounting need it)"
case $ROOT_GIB in *[!0-9]*|'') die "--root-size wants a whole number of GiB" ;; esac
[ "$ROOT_GIB" -ge 3 ] || die "--root-size below 3 GiB cannot hold the OS"
if [ -n "$USERSPEC" ]; then
    case $USERSPEC in *:*) ;; *) die "--user wants NAME:PASS" ;; esac
    need openssl
fi
if [ -n "$WIFISPEC" ]; then
    case $WIFISPEC in *:*) ;; *) die "--wifi wants SSID:PSK" ;; esac
    WIFI_SSID=${WIFISPEC%%:*}          # split at the FIRST ':' — the PSK may
    WIFI_PSK=${WIFISPEC#*:}            # contain colons, the SSID may not
    [ -n "$WIFI_SSID" ] && [ "${#WIFI_SSID}" -le 32 ] || \
        die "--wifi SSID must be 1-32 characters (and must not contain ':')"
    [ "${#WIFI_PSK}" -ge 8 ] && [ "${#WIFI_PSK}" -le 64 ] || \
        die "--wifi PSK must be a 8-63 char passphrase (or 64 hex digits)"
    [ -n "$WIFI_CC" ] || \
        die "--wifi needs --wifi-country CC (stock Pi OS keeps wlan blocked without a regulatory domain)"
    case $WIFI_CC in [A-Za-z][A-Za-z]) ;; *) die "--wifi-country wants a two-letter code (e.g. JP, CA)" ;; esac
    WIFI_CC=$(printf '%s' "$WIFI_CC" | tr '[:lower:]' '[:upper:]')
    FIRSTBOOT_WIFI=1
elif [ -n "$WIFI_CC" ]; then
    die "--wifi-country does nothing without --wifi"
fi

for t in dd sfdisk partprobe blkid mkfs.ext4 e2fsck resize2fs lsblk \
         blockdev udevadm findmnt mktemp awk sed tr; do need "$t"; done

# --- image: must already exist locally; pick the decompressor by suffix ----
[ -f "$IMG" ] || die "image not found: $IMG (download it first — this tool does not)"
case $IMG in
    *.img) DECOMP=cat ;;
    *.xz)  DECOMP=xz;    need xz ;;
    *.gz)  DECOMP=gzip ;;
    *.zip) DECOMP=unzip; need unzip ;;
    *)     die "unrecognized image format (want .img, .img.xz, .img.gz or .zip): $IMG" ;;
esac
decompress() {
    case $DECOMP in
        cat)   cat "$IMG" ;;
        xz)    xz -dc "$IMG" ;;
        gzip)  gzip -dc "$IMG" ;;
        unzip) unzip -p "$IMG" '*.img' ;;
    esac
}

# --- device: whole disk, not the system disk, unmounted, >= 8 GB -----------
[ -b "$DEV" ] || die "$DEV is not a block device"
devname=$(basename "$(readlink -f "$DEV")")
[ -e "/sys/block/$devname" ] || die "$DEV looks like a partition — pass the whole disk"

rootsrc=$(findmnt -no SOURCE / 2>/dev/null || true)
rootdisk=$(lsblk -no PKNAME "$rootsrc" 2>/dev/null | head -n1 || true)
[ "$rootdisk" != "$devname" ] || die "refusing: $DEV holds the running system"

if lsblk -no MOUNTPOINT "$DEV" 2>/dev/null | grep -q .; then
    lsblk -o NAME,SIZE,MOUNTPOINT "$DEV" >&2
    die "$DEV has mounted partitions — unmount them first (a mounted disk is often the wrong disk)"
fi

devbytes=$(blockdev --getsize64 "$DEV")
[ "$devbytes" -ge "$MIN_DEV_BYTES" ] || \
    die "$DEV is $((devbytes / 1000000000)) GB — DashBerry needs a device of 8 GB or bigger"

# --- the point of no return: a typed confirmation, nothing softer ----------
[ -t 0 ] || die "no terminal to confirm on — this tool never wipes a disk unattended"
echo
echo "################################################################"
echo "#                          WARNING                             #"
echo "#   ALL DATA ON THE DEVICE BELOW WILL BE PERMANENTLY ERASED    #"
echo "################################################################"
echo
lsblk -o NAME,MODEL,SIZE,TYPE,MOUNTPOINT "$DEV" | sed 's/^/    /'
echo
echo "    image : $IMG"
echo "    layout: p1 boot (from image) | p2 OS ${ROOT_GIB} GiB$( [ $READONLY = 1 ] && echo ' (read-only after install)' ) | p3 /data (rest)"
[ "$BYPASS_TIME" = 1 ] && echo "    bypass: TIME (no DS3231 — GPS disciplines the clock)"
[ "$BYPASS_REAR" = 1 ] && echo "    bypass: REAR (no rear camera)"
[ "$FIRSTBOOT_WIFI" = 1 ] && echo "    wifi  : first boot joins '$WIFI_SSID' ($WIFI_CC) — wiped before RF lockdown"
echo
printf 'Type the device path (%s) to continue, anything else aborts: ' "$DEV"
read -r answer
[ "$answer" = "$DEV" ] || die "aborted — nothing was written"

# --- flash -----------------------------------------------------------------
info "flashing $IMG onto $DEV..."
decompress | dd of="$DEV" bs=4M iflag=fullblock conv=fsync status=progress
sync
partprobe "$DEV"
udevadm settle

P=""
case $devname in *[0-9]) P=p ;; esac      # sdb2 vs mmcblk0p2 / nvme0n1p2
BOOTP="${DEV}${P}1"
ROOTP="${DEV}${P}2"
DATAP="${DEV}${P}3"

wait_part() {
    for _ in $(seq 1 20); do
        [ -b "$1" ] && return 0
        sleep 0.5
    done
    die "partition $1 never appeared after flashing"
}
wait_part "$BOOTP"
wait_part "$ROOTP"

[ "$(blkid -o value -s TYPE "$BOOTP")" = vfat ] || die "$BOOTP is not vfat — not a Raspberry Pi OS image?"
[ "$(blkid -o value -s TYPE "$ROOTP")" = ext4 ] || die "$ROOTP is not ext4 — not a Raspberry Pi OS image?"
[ ! -b "$DATAP" ] || die "image already carries a 3rd partition — expected a stock 2-partition Pi OS image"

# --- partitions: right-size the (to-be-read-only) OS, add /data ------------
root_bytes=$((ROOT_GIB * 1024 * 1024 * 1024))
cur_bytes=$(blockdev --getsize64 "$ROOTP")
if [ "$cur_bytes" -lt "$root_bytes" ]; then
    info "growing OS partition to ${ROOT_GIB} GiB..."
    echo ", ${ROOT_GIB}GiB" | sfdisk -q -N 2 "$DEV"
    partprobe "$DEV"
    udevadm settle
    rc=0
    e2fsck -f -p "$ROOTP" || rc=$?
    [ "$rc" -le 2 ] || die "e2fsck on $ROOTP failed (exit $rc)"
    resize2fs "$ROOTP"
else
    info "image OS partition already >= ${ROOT_GIB} GiB — keeping its size"
fi

info "creating /data partition (rest of the device)..."
echo ",,L" | sfdisk -q -a "$DEV"
partprobe "$DEV"
udevadm settle
wait_part "$DATAP"
[ "$(blockdev --getsize64 "$DATAP")" -ge "$MIN_DATA_BYTES" ] || \
    die "/data would be under 1 GiB — lower --root-size or use a bigger card"
mkfs.ext4 -q -F -L dashberry-data "$DATAP"
DATA_PARTUUID=$(blkid -o value -s PARTUUID "$DATAP")
[ -n "$DATA_PARTUUID" ] || die "could not read PARTUUID of $DATAP"

info "creating /data directory skeleton..."
DMNT=$(mktemp -d)
mount "$DATAP" "$DMNT"
mkdir -p "$DMNT/front" "$DMNT/rear" "$DMNT/gps" "$DMNT/rf"
umount "$DMNT"
rmdir "$DMNT"

# --- customize the OS + boot partitions ------------------------------------
SWDIR=$(cd "$(dirname "$(readlink -f "$0")")/../sw" && pwd)
[ -f "$SWDIR/firstinstall.sh" ] || die "payload not found: $SWDIR/firstinstall.sh"

MNT=
BOOTDIR=
cleanup() {
    [ -n "$BOOTDIR" ] && umount "$BOOTDIR" 2>/dev/null || true
    if [ -n "$MNT" ]; then
        umount "$MNT" 2>/dev/null || true
        rmdir "$MNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

MNT=$(mktemp -d)
mount "$ROOTP" "$MNT"
BOOTDIR="$MNT/boot/firmware"                  # bookworm+ (incl. trixie); /boot fallback
[ -d "$BOOTDIR" ] || BOOTDIR="$MNT/boot"
mount "$BOOTP" "$BOOTDIR"

# --wifi rides on NetworkManager (the stack since bookworm, incl. trixie);
# bail before customizing a card that could never bring the profile up
# (bullseye and older run dhcpcd/wpa_supplicant)
[ "$FIRSTBOOT_WIFI" = 0 ] || [ -d "$MNT/etc/NetworkManager" ] || \
    die "--wifi needs a NetworkManager image (Raspberry Pi OS Trixie Lite)"

info "appending /data to fstab (PARTUUID=$DATA_PARTUUID)..."
mkdir -p "$MNT/data"
cat >> "$MNT/etc/fstab" <<EOF
# DashBerry footage partition (dashberry-install; options per etc/fstab.snippet
# — commit=1 bounds a hard power cut to ~1-2 s of lost footage)
PARTUUID=$DATA_PARTUUID  /data  ext4  defaults,noatime,data=ordered,commit=1,nofail  0  2
EOF

info "merging boot/config-snippet.txt into config.txt..."
# The snippet's directives sit between its header block (ends at the first
# blank line) and the dashes-only separator (the cmdline.txt notes below that
# are documentation, not directives).
snippet=$(awk '/^# -+$/{exit} started{print} /^$/{started=1}' \
    "$SWDIR/boot/config-snippet.txt")
if [ "$BYPASS_TIME" = 1 ]; then
    snippet=$(printf '%s\n' "$snippet" | sed '/^# --- DS3231 RTC ---$/d; /^dtoverlay=i2c-rtc/d')
fi
{
    echo
    echo "# ===== DashBerry (added by dashberry-install) ====="
    printf '%s\n' "$snippet"
} >> "$BOOTDIR/config.txt"

info "staging sw/ payload and first-boot installer..."
mkdir -p "$MNT/opt/dashberry"
cp -a "$SWDIR" "$MNT/opt/dashberry/sw"
# Bypass flags ride in the payload's conf — the one the firstinstall step
# installs to /etc — so the panel and firstinstall read the same truth.
if [ "$BYPASS_TIME" = 1 ]; then
    sed -i 's/^BYPASS_TIME=0/BYPASS_TIME=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$BYPASS_REAR" = 1 ]; then
    sed -i 's/^BYPASS_REAR=0/BYPASS_REAR=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
printf 'READONLY=%s\nFIRSTBOOT_WIFI=%s\n' "$READONLY" "$FIRSTBOOT_WIFI" \
    > "$MNT/opt/dashberry/install-opts"

cat > "$MNT/etc/systemd/system/dashberry-firstinstall.service" <<'EOF'
[Unit]
Description=DashBerry first-boot installer (self-removing)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/dashberry/sw/firstinstall.sh

[Service]
Type=oneshot
ExecStart=/opt/dashberry/sw/firstinstall.sh --from-unit
TimeoutStartSec=3600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF
mkdir -p "$MNT/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/dashberry-firstinstall.service \
    "$MNT/etc/systemd/system/multi-user.target.wants/dashberry-firstinstall.service"

if [ -n "$USERSPEC" ]; then
    info "writing userconf.txt (first-boot user '${USERSPEC%%:*}')..."
    printf '%s:%s\n' "${USERSPEC%%:*}" \
        "$(openssl passwd -6 "${USERSPEC#*:}")" > "$BOOTDIR/userconf.txt"
fi
if [ "$WANT_SSH" = 1 ]; then
    info "enabling ssh..."
    : > "$BOOTDIR/ssh"
fi
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "staging first-boot Wi-Fi '$WIFI_SSID' (firstinstall wipes it)..."
    NMFILE="$MNT/etc/NetworkManager/system-connections/dashberry-firstboot.nmconnection"
    mkdir -p "${NMFILE%/*}"
    # printf, not a heredoc: the PSK must land byte-for-byte ($, \, %s-safe);
    # umask 077 so the plaintext PSK is never world-readable, even briefly
    # (NM refuses keyfiles that are not 600 anyway)
    (
        umask 077
        {
            printf '[connection]\nid=dashberry-firstboot\nuuid=%s\ntype=wifi\nautoconnect=true\n\n' \
                "$(cat /proc/sys/kernel/random/uuid)"
            printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$WIFI_SSID"
            printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$WIFI_PSK"
            printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
        } > "$NMFILE"
    )
    chmod 600 "$NMFILE"
    # Stock Pi OS (since bullseye, still true on trixie) keeps wlan
    # rfkill-blocked until a regulatory domain is set; the kernel cmdline is
    # the offline way to provide one. cmdline.txt is a single line — append
    # to it, don't add a second. firstinstall removes the token again during
    # the credential wipe.
    [ -f "$BOOTDIR/cmdline.txt" ] || die "no cmdline.txt on the boot partition?"
    sed -i "1s/\$/ cfg80211.ieee80211_regdom=$WIFI_CC/" "$BOOTDIR/cmdline.txt"
fi

sync
cleanup
trap - EXIT

# --- done ------------------------------------------------------------------
echo
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "card ready. Insert it and power the Pi (first boot joins Wi-Fi '$WIFI_SSID')"
    echo "    (setup-only network: firstinstall wipes the profile, leases and"
    echo "     logs before the OS locks read-only)."
else
    info "card ready. Insert it and power the Pi WITH ETHERNET CONNECTED"
    echo "    (first boot needs apt; Wi-Fi is rfkill-blocked by design)."
fi
echo
echo "    boot 1: Pi OS housekeeping (its auto-expand self-disarms: root is"
echo "            no longer the last partition), reboots"
echo "    boot 2: dashberry-firstinstall — apt packages, builds"
echo "            dashberry-panel, enables units$( [ "$FIRSTBOOT_WIFI" = 1 ] && echo ', wipes the Wi-Fi traces' )$( [ "$READONLY" = 1 ] && echo ', flips the OS read-only' ) — reboots"
echo "    boot 3: recording; radios come up BLOCKED (fresh card, fail-closed)"
echo
echo "    progress: journalctl -u dashberry-firstinstall (or the console)"
echo "    then: work the VERIFY table in sw/README.md (bench checks)"
