#!/bin/bash
# dashberry-install — ALL-IN-ONE card builder for the DashBerry Pi 4 (PC-side).
#
# Replaces sw/install.sh (which ran on the Pi): one command takes a stock
# Raspberry Pi OS Lite image you already downloaded (nothing is ever fetched
# here) and a target block device, and produces a card that boots straight
# into a self-installing DashBerry:
#
#   1. wipes the old partition signatures and table (wipefs on every old
#      partition node, then the disk — incl. fs superblocks inside old
#      partitions and a stale backup GPT, none of which dd reaches) and
#      flashes the image — after a typed confirmation; the device is WIPED;
#   2. grows the OS partition to a fixed working size (default 8 GiB) instead
#      of letting first boot swallow the card — this is the volume that ends
#      up READ-ONLY (overlayfs, enabled at the end of the first-boot install);
#   3. creates the writable /data partition (ext4, rest of the card) and
#      appends its fstab entry (by PARTUUID; options from etc/fstab.snippet);
#   4. merges boot/config-snippet.txt into config.txt;
#   5. stages sw/ at /opt/dashberry/sw and enables a oneshot first-boot
#      service that installs packages, builds dashberry-panel, enables the
#      units, and reboots (sw/firstinstall.sh). The card lands in one of
#      three modes, set by --auth and --debug (see below);
#   6. (--wifi) stages a first-boot Wi-Fi profile plus the regulatory
#      domain that stock Pi OS (Trixie) needs before it will unblock wlan,
#      so boot 2 can run without Ethernet. The staged credential is always
#      wiped on a non-debug card before the overlay freezes the OS; DEBUG
#      keeps the profile so the card rejoins the LAN on every boot.
#
# The three modes (--debug requires --auth; the account is --auth's job now,
# it is no longer --debug's parameter):
#
#   (neither)            SEALED production card. Read-only OS, no user, no
#                        sshd, no radios, every network trace wiped. Its
#                        only interfaces are the OLED and pulling the card.
#   --auth NAME:PASS     JOIN WIFI card. Still a production card — read-only
#                        OS, no stored credential, radios blocked at every
#                        boot — but that account + sshd exist, and the panel
#                        arms JOIN WIFI (RF_JOIN=1): a 5 s button-A hold on
#                        the OLED brings the radios up and walks the user
#                        through picking an SSID and typing its passphrase.
#                        Needs --wifi-country: without a regulatory domain
#                        the kernel hard-blocks wlan and the feature is dead.
#   --debug --auth N:P   DEBUG card. Writable OS, ssh + that account,
#                        journal kept and made persistent. JOIN WIFI is NOT
#                        armed here; the card boots RF-KILLED unless a
#                        --wifi profile was explicitly staged for it.
#
# The stock image's own auto-expand is left in place and self-disarms: it
# refuses to grow a root partition that is not the last one, and /data is.
#
# PC-side tooling, so the on-image no-interpreters rule doesn't bind; bash
# rather than Python because this is pure dd/sfdisk/mkfs orchestration.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: sudo dashberry-install [options] <image> <device>

  <image>   Raspberry Pi OS Lite (64-bit) image
  <device>  target block device (at least 16GB; ALL DATA ON IT WILL BE ERASED.)

Options:
  --bypass-time     ignore DS3231 from system requirement and use GPS for time calibration
  --bypass-rear     ignore rear camera from system requirement
  --invert-front AXES / --invert-rear AXES
                    correct how that camera is mounted: a comma-separated
                    list of v (mounted upside down) and h (image comes out
                    mirrored) — "v", "h" or "v,h", either case, each axis
                    once. Flipped at capture, so recordings need no fixing
  --root-size GIB   OS partition size in GiB (default: 8)
  --root-size keep  REFLASH, KEEPING THE FOOTAGE. Re-adopts the /data
                    partition already on the card instead of rebuilding it:
                    boot and OS are replaced as usual, /data is left byte for
                    byte where it is and the OS is sized to land exactly in
                    front of it. Needs a card this tool already built
  --auth NAME:PASS  create this account (+ sshd). On its own it also arms
                    JOIN WIFI on the panel (needs --wifi-country)
  --debug           build a debug card: writable OS, journal kept and made
                    persistent. Requires --auth; JOIN WIFI is not armed
  --wifi SSID:PSK   run the first boot over Wi-Fi instead of Ethernet
  --wifi-country CC regulatory domain; required by --wifi and by JOIN WIFI
  -h, --help        display this help
EOF
}

die()  { echo "Fatal Error: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing tool: $1"; }

MIN_DATA_BYTES=$((1024 * 1024 * 1024))    # refuse a /data smaller than 1 GiB

BYPASS_TIME=0
BYPASS_REAR=0
INVERT_FRONT=
INVERT_REAR=
ROOT_GIB=8
KEEP_DATA=0
DEBUG=0
AUTH=0
RF_JOIN=0
USERSPEC=
WIFISPEC=
WIFI_CC=
WIFI_SSID=
FIRSTBOOT_WIFI=0
IMG=
DEV=

while [ $# -gt 0 ]; do
    case $1 in
        --bypass-time) BYPASS_TIME=1 ;;
        --bypass-rear) BYPASS_REAR=1 ;;
        --invert-front) shift; INVERT_FRONT=${1:-}
                        [ -n "$INVERT_FRONT" ] || die "--invert-front requires v, h or v,h" ;;
        --invert-rear)  shift; INVERT_REAR=${1:-}
                        [ -n "$INVERT_REAR" ] || die "--invert-rear requires v, h or v,h" ;;
        --root-size)   shift; ROOT_GIB=${1:-} ;;
        --debug)       DEBUG=1 ;;
        --auth)        shift; AUTH=1; USERSPEC=${1:-} ;;
        --wifi)        shift; WIFISPEC=${1:-} ;;
        --wifi-country) shift; WIFI_CC=${1:-} ;;
        -h|--help)     usage; exit 0 ;;
        -*)            die "Unknown option: $1 (see --help)" ;;
        *)             if   [ -z "$IMG" ]; then IMG=$1
                       elif [ -z "$DEV" ]; then DEV=$1
                       else die "Too many arguments (see --help)"; fi ;;
    esac
    shift
done

[ -n "$IMG" ] && [ -n "$DEV" ] || { usage >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "Run this script as root"
# --root-size takes a GiB count or the word `keep`. `keep` is not a size: it
# means "derive the size from the card so the /data already on it survives",
# and the number is only known once the old partition table has been read
# (KEEP block below). Growing the OS PAST the existing /data would mean
# relocating the footage, so keep derives the size rather than accepting one.
case $ROOT_GIB in
    keep|KEEP)   KEEP_DATA=1 ;;
    *[!0-9]*|'') die "--root-size requires a whole number of GiB, or 'keep'" ;;
    *)           [ "$ROOT_GIB" -ge 8 ] || die "--root-size must be at least 8GiB" ;;
esac
# The device must hold boot (512 MiB) + the OS + a useful /data — checked
# up front because the wipe below is the point of no return. The default
# 8 GiB OS means a 16 GB card in practice. Meaningless under `keep`: the card
# demonstrably already holds a layout, and the real constraint there is the
# derived OS size, checked against the recorded /data start instead.
if [ "$KEEP_DATA" = 0 ]; then
    MIN_DEV_BYTES=$((512 * 1024 * 1024 + ROOT_GIB * 1024 * 1024 * 1024 + MIN_DATA_BYTES))
fi
# The account moved out of --debug into --auth, so the three modes are a
# plain truth table: --debug needs an account to be worth anything, and
# --auth alone is the JOIN WIFI card.
[ "$DEBUG" = 0 ] || [ "$AUTH" = 1 ] || die "--debug requires --auth NAME:PASS"
if [ "$AUTH" = 1 ]; then
    case $USERSPEC in *:*) ;; *) die "--auth requires NAME:PASS" ;; esac
    need openssl
    [ "$DEBUG" = 1 ] || RF_JOIN=1
fi
# A JOIN WIFI card must carry a regulatory domain or the kernel keeps wlan
# hard-blocked for its whole life and the feature can never do anything.
if [ "$RF_JOIN" = 1 ] && [ -z "$WIFI_CC" ]; then
    die "--auth without --debug arms JOIN WIFI, which needs --wifi-country CC"
fi
if [ -n "$WIFI_CC" ]; then
    case $WIFI_CC in [A-Za-z][A-Za-z]) ;; *) die "--wifi-country requires a two-letter code" ;; esac
    WIFI_CC=$(printf '%s' "$WIFI_CC" | tr '[:lower:]' '[:upper:]')
    # A regdom on its own is now meaningful (JOIN WIFI needs one); it is
    # only pointless on a card with neither --wifi nor JOIN WIFI.
    [ -n "$WIFISPEC" ] || [ "$RF_JOIN" = 1 ] || \
        die "--wifi-country needs --wifi or a JOIN WIFI card (--auth without --debug)"
fi
if [ -n "$WIFISPEC" ]; then
    case $WIFISPEC in *:*) ;; *) die "--wifi requires SSID:PSK" ;; esac
    WIFI_SSID=${WIFISPEC%%:*}          # split at the FIRST ':' — the PSK may
    WIFI_PSK=${WIFISPEC#*:}            # contain colons, the SSID may not
    [ -n "$WIFI_SSID" ] && [ "${#WIFI_SSID}" -le 32 ] || \
        die "--wifi SSID must be 1-32 characters and must not contain :"
    [ "${#WIFI_PSK}" -ge 8 ] && [ "${#WIFI_PSK}" -le 64 ] || \
        die "--wifi PSK must be a 8-63 char passphrase or 64 hex digits"
    [ -n "$WIFI_CC" ] || \
        die "--wifi needs --wifi-country CC"
    FIRSTBOOT_WIFI=1
fi

# --invert-front/--invert-rear name the axes a camera's mounting has to be
# corrected on: v (it is upside down) and/or h (its image comes out mirrored),
# comma separated, in either case, each axis at most once. Validated HERE
# rather than on the card because this is the last place a human is present to
# read the message — the recorders run headless, and a value they cannot parse
# costs a whole drive's footage before anyone sees the journal. Normalized to
# one lowercase spelling ("v", "h", "v,h") so the conf carries exactly one form
# and the two recorders can stay as simple as a case statement.
AXES=
parse_axes() {                     # $1 = option name, $2 = raw list → $AXES
    local a v= h= IFS=,
    for a in $2; do
        case ${a,,} in
            v) [ -z "$v" ] || die "$1: v listed twice in \"$2\""; v=v ;;
            h) [ -z "$h" ] || die "$1: h listed twice in \"$2\""; h=h ;;
            *) die "$1: bad axis \"$a\" — want v and/or h, comma separated" ;;
        esac
    done
    case $v$h in vh) AXES=v,h ;; *) AXES=$v$h ;; esac
}
parse_axes --invert-front "$INVERT_FRONT"; INVERT_FRONT=$AXES
parse_axes --invert-rear  "$INVERT_REAR";  INVERT_REAR=$AXES

for t in dd sfdisk partprobe blkid mkfs.ext4 e2fsck resize2fs lsblk \
         blockdev udevadm findmnt mktemp awk sed tr wipefs; do need "$t"; done

# --- image: must already exist locally; pick the decompressor by suffix ----
[ -f "$IMG" ] || die "Image not found: $IMG"
case $IMG in
    *.img) DECOMP=cat ;;
    *.xz)  DECOMP=xz;    need xz ;;
    *.gz)  DECOMP=gzip ;;
    *.zip) DECOMP=unzip; need unzip ;;
    *)     die "Unrecognized image format (not in: .img, .img.xz, .img.gz or .zip): $IMG" ;;
esac
decompress() {
    case $DECOMP in
        cat)   cat "$IMG" ;;
        xz)    xz -dc "$IMG" ;;
        gzip)  gzip -dc "$IMG" ;;
        unzip) unzip -p "$IMG" '*.img' ;;
    esac
}

# --- device: whole disk, not the system disk, unmounted, big enough --------
[ -b "$DEV" ] || die "$DEV is not a block device"
devname=$(basename "$(readlink -f "$DEV")")
[ -e "/sys/block/$devname" ] || die "$DEV looks like a partition, use the whole disk"

rootsrc=$(findmnt -no SOURCE / 2>/dev/null || true)
rootdisk=$(lsblk -no PKNAME "$rootsrc" 2>/dev/null | head -n1 || true)
[ "$rootdisk" != "$devname" ] || die "Refusing: $DEV holds the running system"

if lsblk -no MOUNTPOINT "$DEV" 2>/dev/null | grep -q .; then
    die "$DEV has mounted partitions"
fi

# Partition node names depend only on the device name, and `keep` needs them
# BEFORE the wipe (to spare /data) — so they are derived here rather than
# after the flash.
P=""
case $devname in *[0-9]) P=p ;; esac      # sdb2 vs mmcblk0p2 / nvme0n1p2
BOOTP="${DEV}${P}1"
ROOTP="${DEV}${P}2"
DATAP="${DEV}${P}3"

devbytes=$(blockdev --getsize64 "$DEV")
if [ "$KEEP_DATA" = 0 ]; then
    [ "$devbytes" -ge "$MIN_DEV_BYTES" ] || \
        die "$DEV is $((devbytes / 1000000000)) GB (boot + ${ROOT_GIB} GiB OS + 1 GiB /data needs at least $(((MIN_DEV_BYTES + 999999999) / 1000000000)) GB)"
fi

# --- --root-size keep: read the layout we are about to preserve -------------
# `sfdisk -d` is the machine-readable dump (`unit: sectors`), parsed with awk
# rather than -J because this script is deliberately pure shell orchestration
# and carries no JSON parser. Its partition lines look like:
#
#     /dev/sdb3 : start=    17833984, size=   204472320, type=83
#
# so the value sits one whitespace-token past the `start=` / `size=` token,
# with a trailing comma to strip.
sfdisk_label() { printf '%s\n' "$1" | awk '$1 == "label:" { print $2; exit }'; }
sfdisk_parts() { printf '%s\n' "$1" | awk '$2 == ":" && $1 ~ "^/dev/" { n++ } END { print n + 0 }'; }
sfdisk_field() {          # $1=dump  $2=partition node  $3=start|size
    printf '%s\n' "$1" | awk -v node="$2" -v key="$3=" '
        $1 == node && $2 == ":" {
            for (i = 3; i <= NF; i++)
                if ($i == key) { v = $(i + 1); sub(/,$/, "", v); print v; exit }
        }'
}

if [ "$KEEP_DATA" = 1 ]; then
    info "Reading the existing DashBerry layout on $DEV..."
    OLD_TABLE=$(sfdisk -d "$DEV" 2>/dev/null) || \
        die "--root-size keep: $DEV has no readable partition table. It needs a card this tool already built; use --root-size N to build one from scratch."

    # MBR only. Pi OS images are msdos-labelled, and this also settles the one
    # question a GPT card would raise: whether the whole-disk wipefs below
    # (which clears a BACKUP GPT from the last sector of the disk) could clip
    # the tail of the very partition we are trying to preserve.
    old_label=$(sfdisk_label "$OLD_TABLE")
    [ "$old_label" = dos ] || \
        die "--root-size keep: $DEV has a '$old_label' partition table, expected 'dos'. Not a card this tool built."

    old_nparts=$(sfdisk_parts "$OLD_TABLE")
    [ "$old_nparts" = 3 ] || \
        die "--root-size keep: $DEV has $old_nparts partitions, expected 3 (boot | OS | /data). Not a card this tool built."

    KEEP_DATA_START=$(sfdisk_field "$OLD_TABLE" "$DATAP" start)
    KEEP_DATA_SIZE=$(sfdisk_field "$OLD_TABLE" "$DATAP" size)
    case $KEEP_DATA_START in *[!0-9]*|'') die "--root-size keep: could not read the start sector of $DATAP" ;; esac
    case $KEEP_DATA_SIZE  in *[!0-9]*|'') die "--root-size keep: could not read the size of $DATAP" ;; esac

    # Refuse to adopt a third partition that is not OURS. Without the label
    # check this mode would happily preserve a stranger's partition and write
    # an fstab pointing at it.
    keep_type=$(blkid -p -o value -s TYPE  "$DATAP" 2>/dev/null || true)
    keep_label=$(blkid -p -o value -s LABEL "$DATAP" 2>/dev/null || true)
    KEEP_DATA_UUID=$(blkid -p -o value -s UUID "$DATAP" 2>/dev/null || true)
    [ "$keep_type" = ext4 ] || \
        die "--root-size keep: $DATAP is '${keep_type:-unrecognised}', expected ext4"
    [ "$keep_label" = dashberry-data ] || \
        die "--root-size keep: $DATAP is labelled '${keep_label:-(none)}', expected 'dashberry-data'. Refusing to adopt a partition this tool did not create."
    [ -n "$KEEP_DATA_UUID" ] || die "--root-size keep: could not read the filesystem UUID of $DATAP"

    # Check the filesystem NOW, while nothing has been destroyed yet: this is
    # the last moment at which "your /data is broken" is still free advice.
    info "Checking the /data filesystem before adopting it..."
    rc=0; e2fsck -f -p "$DATAP" || rc=$?
    [ "$rc" -le 2 ] || \
        die "e2fsck on $DATAP failed (exit $rc) — repair it before reflashing, or use --root-size N to start clean"

    KEEP_DATA_BYTES=$((KEEP_DATA_SIZE * 512))
    # Provisional only: the OS size is fixed by where the NEW image puts p2,
    # which is not known until after the flash. Recomputed and reported then.
    old_root_start=$(sfdisk_field "$OLD_TABLE" "$ROOTP" start)
    case $old_root_start in *[!0-9]*|'') old_root_start=0 ;; esac
    KEEP_ROOT_GIB_APPROX=$(( (KEEP_DATA_START - old_root_start) * 512 / 1024 / 1024 / 1024 ))
fi

# --- the point of no return: a typed confirmation, nothing softer ----------
[ -t 0 ] || die "This script must be run on a visual terminal"
echo "################################################################"
echo "#                          WARNING                             #"
if [ "$KEEP_DATA" = 1 ]; then
echo "#   BOOT AND OS ERASED — /data (THE FOOTAGE) IS PRESERVED      #"
else
echo "#   ALL DATA ON THE DEVICE BELOW WILL BE PERMANENTLY ERASED    #"
fi
echo "################################################################"
echo
lsblk -o NAME,MODEL,SIZE,TYPE,MOUNTPOINT "$DEV" | sed 's/^/    /'
echo
echo "    image : $IMG"
if [ "$KEEP_DATA" = 1 ]; then
    echo "    layout: boot | OS ~${KEEP_ROOT_GIB_APPROX} GiB$( [ $DEBUG = 0 ] && echo ' (read-only)' ) | /data (KEPT, $((KEEP_DATA_BYTES / 1024 / 1024 / 1024)) GiB)"
    echo "    keep  : $DATAP at sector $KEEP_DATA_START, fs UUID $KEEP_DATA_UUID"
else
    echo "    layout: boot | OS ${ROOT_GIB} GiB$( [ $DEBUG = 0 ] && echo ' (read-only)' ) | /data"
fi
if [ "$DEBUG" = 1 ]; then
    echo "    mode  : debug"
elif [ "$RF_JOIN" = 1 ]; then
    echo "    mode  : production (ssh enabled)"
else
    echo "    mode  : production (sealed)"
fi
[ "$BYPASS_TIME" = 1 ] && echo "    bypass: TIME"
[ "$BYPASS_REAR" = 1 ] && echo "    bypass: REAR"
[ -n "$INVERT_FRONT" ] && echo "    invert: FRONT ($INVERT_FRONT)"
[ -n "$INVERT_REAR" ] && echo "    invert: REAR ($INVERT_REAR)"
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    echo "    wifi  : $WIFI_SSID ($WIFI_CC)"
fi
echo
printf 'Type the device path (%s) to continue: ' "$DEV"
read -r answer
[ "$answer" = "$DEV" ] || die "Aborted"

# --- wipe: start from a clean device, not whatever the card held -----------
info "Wiping the old partition signatures and table on $DEV..."
# dd below only overwrites the image's length: a previous GPT keeps its
# backup table at the END of the disk, and old filesystem superblocks (a
# previous card's /data ext4, say) sit INSIDE the old partitions, where a
# whole-disk wipefs never probes — sfdisk then warns "contains a ext4
# signature" when a new partition lands on the same offset. So wipe each
# partition through its node while the old table still provides them, THEN
# the table itself (MBR, GPT primary+backup).
while read -r part; do
    # `keep`: this is destruction step 1 of 3 for the footage — wiping the
    # ext4 signature off /data. Skip it. (The other two are the sfdisk
    # --wipe-partitions and the mkfs, both further down.)
    if [ "$KEEP_DATA" = 1 ] && [ "$part" = "$DATAP" ]; then
        info "  keeping $part (the footage)"
        continue
    fi
    if [ -b "$part" ]; then wipefs -a -q "$part"; fi
done < <(lsblk -nro TYPE,PATH "$DEV" | awk '$1 == "part" {print $2}')
# Whole-disk: clears the MBR, which dd rewrites immediately below. Safe under
# `keep` because the table is msdos (asserted above), so there is no backup
# GPT at the end of the disk for this to reach into.
wipefs -a -q "$DEV"
partprobe "$DEV" 2>/dev/null || true
udevadm settle

# --- flash -----------------------------------------------------------------
info "Flashing $IMG onto $DEV..."
decompress | dd of="$DEV" bs=4M iflag=fullblock conv=fsync status=progress
sync
partprobe "$DEV"
udevadm settle

# `keep`: the flash is the only thing that could have physically reached the
# footage, and whether it did is a question about the image's length, which
# varies by format and is a nuisance to determine ahead of time. So ask the
# disk instead: probe the ext4 superblock where /data starts (blkid -O takes
# a byte offset and needs no partition node, which is just as well — the
# table now says two partitions) and require the same filesystem UUID we
# recorded. This runs BEFORE the partition table is touched, so a failure
# here costs nothing further.
if [ "$KEEP_DATA" = 1 ]; then
    info "Verifying the preserved /data survived the flash..."
    post_uuid=$(blkid -p -O "$((KEEP_DATA_START * 512))" -o value -s UUID "$DEV" 2>/dev/null || true)
    [ "$post_uuid" = "$KEEP_DATA_UUID" ] || die \
"the image overwrote /data — expected fs UUID $KEEP_DATA_UUID at sector $KEEP_DATA_START, found '${post_uuid:-nothing}'.
       The footage on this card is gone and nothing can bring it back. The
       card has NOT been partitioned; rerun with --root-size N to build it
       clean. (This means the image was larger than the $((KEEP_DATA_START * 512 / 1024 / 1024)) MiB
       ahead of /data, which a stock Pi OS Lite image is not.)"
fi

wait_part() {
    for _ in $(seq 1 20); do
        [ -b "$1" ] && return 0
        sleep 0.5
    done
    die "Partition $1 never appeared after flashing"
}
wait_part "$BOOTP"
wait_part "$ROOTP"

[ "$(blkid -o value -s TYPE "$BOOTP")" = vfat ] || die "$BOOTP is not vfat"
[ "$(blkid -o value -s TYPE "$ROOTP")" = ext4 ] || die "$ROOTP is not ext4"
[ ! -b "$DATAP" ] || die "Image already carries a 3rd partition (expected a stock 2-partition Pi OS image)"

# --- partitions: right-size the (to-be-read-only) OS, add /data ------------
# Under `keep` the OS size is not a choice: p2 must end exactly one sector
# before the /data we are preserving. Its START comes from the freshly
# flashed image (which need not match the card's previous one), so the size
# is only computable here, after the flash.
if [ "$KEEP_DATA" = 1 ]; then
    NEW_TABLE=$(sfdisk -d "$DEV")
    new_root_start=$(sfdisk_field "$NEW_TABLE" "$ROOTP" start)
    case $new_root_start in *[!0-9]*|'') die "Could not read the start sector of $ROOTP after flashing" ;; esac
    [ "$new_root_start" -lt "$KEEP_DATA_START" ] || die \
        "the flashed OS partition starts at sector $new_root_start, at or past the preserved /data at $KEEP_DATA_START"
    root_sectors=$((KEEP_DATA_START - new_root_start))
    root_bytes=$((root_sectors * 512))
    [ "$root_bytes" -ge $((8 * 1024 * 1024 * 1024)) ] || die \
        "--root-size keep: this card leaves only $((root_bytes / 1024 / 1024 / 1024)) GiB for the OS, under the 8 GiB minimum. Rebuild it with --root-size N."
    info "Sizing OS partition to $((root_bytes / 1024 / 1024 / 1024)) GiB (sectors $new_root_start..$((KEEP_DATA_START - 1)), ending where /data begins)..."
    echo ", ${root_sectors}" | sfdisk -q -N 2 "$DEV"
    partprobe "$DEV"
    udevadm settle
    rc=0
    e2fsck -f -p "$ROOTP" || rc=$?
    [ "$rc" -le 2 ] || die "e2fsck on $ROOTP failed (exit $rc)"
    resize2fs "$ROOTP"
else
root_bytes=$((ROOT_GIB * 1024 * 1024 * 1024))
cur_bytes=$(blockdev --getsize64 "$ROOTP")
if [ "$cur_bytes" -lt "$root_bytes" ]; then
    info "Growing OS partition to ${ROOT_GIB} GiB..."
    echo ", ${ROOT_GIB}GiB" | sfdisk -q -N 2 "$DEV"
    partprobe "$DEV"
    udevadm settle
    rc=0
    e2fsck -f -p "$ROOTP" || rc=$?
    [ "$rc" -le 2 ] || die "e2fsck on $ROOTP failed (exit $rc)"
    resize2fs "$ROOTP"
else
    info "Image OS partition already >= ${ROOT_GIB} GiB"
fi
fi

root_end=$(sfdisk -l -o Device,End "$DEV" | awk -v p="$ROOTP" '$1 == p {print $2}')
case $root_end in *[!0-9]*|'') die "Could not read the end sector of $ROOTP" ;; esac

if [ "$KEEP_DATA" = 1 ]; then
    info "Re-adopting the existing /data partition (NOT formatting it)..."
    [ "$root_end" -lt "$KEEP_DATA_START" ] || die \
        "the OS partition now ends at sector $root_end, overlapping the preserved /data at $KEEP_DATA_START"
    # Exact original geometry, and --wipe-partitions NEVER: destruction step
    # 2 of 3 for the footage is sfdisk helpfully erasing the fs signature it
    # finds where the partition lands. Here that signature IS the payload.
    echo "${KEEP_DATA_START},${KEEP_DATA_SIZE},L" | sfdisk -q --wipe-partitions never -a "$DEV"
    partprobe "$DEV"
    udevadm settle
    wait_part "$DATAP"
    # Step 3 of 3 — the mkfs — is simply not run. Verify instead.
    rc=0; e2fsck -f -p "$DATAP" || rc=$?
    [ "$rc" -le 2 ] || die "e2fsck on the re-adopted $DATAP failed (exit $rc)"
    readopted_uuid=$(blkid -p -o value -s UUID "$DATAP" 2>/dev/null || true)
    [ "$readopted_uuid" = "$KEEP_DATA_UUID" ] || die \
        "re-adopted $DATAP has fs UUID '${readopted_uuid:-none}', expected $KEEP_DATA_UUID"
else
    info "Creating /data partition..."
    # The flashed image can leave a small free gap BEFORE the boot partition
    # (bootfs starts at 4 MiB), and sfdisk with no start sector appends into the
    # first free area — i.e. that gap, yielding a few-MiB /data. Start explicitly
    # on the first 1 MiB boundary after the OS partition instead.
    data_start=$(( (root_end / 2048 + 1) * 2048 ))
    # --wipe-partitions: erase any stale fs signature where the new partition
    # lands (belt-and-braces to the pre-dd wipe — covers cards whose old table
    # was already gone, leaving signatures with no node to wipe them through)
    echo "${data_start},,L" | sfdisk -q --wipe-partitions always -a "$DEV"
    partprobe "$DEV"
    udevadm settle
    wait_part "$DATAP"
    [ "$(blockdev --getsize64 "$DATAP")" -ge "$MIN_DATA_BYTES" ] || \
        die "/data would be under 1 GiB, lower --root-size or use a bigger card"
    mkfs.ext4 -q -F -L dashberry-data "$DATAP"
fi
# PARTUUID is expected to CHANGE under keep: for an msdos table it derives
# from the MBR disk id, which came from the freshly flashed image. Harmless —
# fstab is written from this value a few steps below, every time.
DATA_PARTUUID=$(blkid -o value -s PARTUUID "$DATAP")
[ -n "$DATA_PARTUUID" ] || die "Could not read PARTUUID of $DATAP"

info "Creating /data directory skeleton..."
DMNT=$(mktemp -d)
mount "$DATAP" "$DMNT"
# mkdir -p, so this is equally the "the skeleton is already there" path that
# a re-adopted /data takes.
mkdir -p "$DMNT/front" "$DMNT/rear" "$DMNT/gps"
if [ "$KEEP_DATA" = 1 ]; then
    # `|| true` on both: the script runs under `set -euo pipefail`, and a
    # find that trips over anything would otherwise abort the install at the
    # very last, purely cosmetic, step.
    kept_sessions=$( (find "$DMNT/front" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true) | wc -l)
    kept_segs=$( (find "$DMNT/front" "$DMNT/rear" -name '*.ts' 2>/dev/null || true) | wc -l)
    info "  /data preserved: $kept_sessions front session(s), $kept_segs segment(s) still on the card"
fi
umount "$DMNT"
rmdir "$DMNT"

# --- customize the OS + boot partitions ------------------------------------
SWDIR=$(cd "$(dirname "$(readlink -f "$0")")/../sw" && pwd)
[ -f "$SWDIR/firstinstall.sh" ] || die "payload not found: $SWDIR/firstinstall.sh"

MNT=
BOOTDIR=
cleanup() {
    [ -n "$BOOTDIR" ] && umount "$BOOTDIR" 2>/dev/null || true
    if [ -n "$MNT" ]; then
        umount "$MNT" 2>/dev/null || true
        rmdir "$MNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

MNT=$(mktemp -d)
mount "$ROOTP" "$MNT"
BOOTDIR="$MNT/boot/firmware"                  # bookworm+ (incl. trixie); /boot fallback
[ -d "$BOOTDIR" ] || BOOTDIR="$MNT/boot"
mount "$BOOTP" "$BOOTDIR"

# --wifi rides on NetworkManager (the stack since bookworm, incl. trixie);
# bail before customizing a card that could never bring the profile up
# (bullseye and older run dhcpcd/wpa_supplicant)
[ "$FIRSTBOOT_WIFI" = 0 ] || [ -d "$MNT/etc/NetworkManager" ] || \
    die "--wifi needs a NetworkManager image"

info "Appending /data to fstab (PARTUUID=$DATA_PARTUUID)..."
mkdir -p "$MNT/data"
cat >> "$MNT/etc/fstab" <<EOF
# DashBerry footage partition (dashberry-install; options per etc/fstab.snippet
# — nodelalloc makes the 1 s commit carry the open segment's appends, bounding
# a hard power cut to ~1-2 s of lost footage; data=journal keeps that loss at
# the TAIL instead of leaving zeroed holes mid-segment)
PARTUUID=$DATA_PARTUUID  /data  ext4  defaults,noatime,nodelalloc,data=journal,commit=1,nofail  0  2
EOF

info "Merging boot/config-snippet.txt into config.txt..."
# The snippet's directives sit between its header block (ends at the first
# blank line) and the dashes-only separator (the cmdline.txt notes below that
# are documentation, not directives).
snippet=$(awk '/^# -+$/{exit} started{print} /^$/{started=1}' \
    "$SWDIR/boot/config-snippet.txt")
if [ "$BYPASS_TIME" = 1 ]; then
    snippet=$(printf '%s\n' "$snippet" | sed '/^# --- DS3231 RTC ---$/d; /^dtoverlay=i2c-rtc/d')
fi
{
    echo
    echo "# ===== DashBerry (added by dashberry-install) ====="
    printf '%s\n' "$snippet"
} >> "$BOOTDIR/config.txt"

info "Keeping fbcon off the OLED (cmdline fbcon=map:9)..."
# The OLED enumerates as fb0 on a headless boot — fbcon's default target —
# so the console would paint boot text and a blinking cursor over the
# panel. fb9 never exists, so fbcon binds nothing regardless of probe
# order. cmdline.txt is a single line — append to it, don't add a second.
[ -f "$BOOTDIR/cmdline.txt" ] || die "No cmdline.txt on the boot partition"
sed -i '1s/$/ fbcon=map:9/' "$BOOTDIR/cmdline.txt"

info "Staging sw/ payload and first-boot installer..."
mkdir -p "$MNT/opt/dashberry"
cp -a "$SWDIR" "$MNT/opt/dashberry/sw"
# Docs stay on the PC — the payload ships code only (README.md is
# gitignored dev documentation, not part of the runtime).
rm -f "$MNT/opt/dashberry/sw/README.md"
# cp -a copies the dev tree as it is, junk included. firstinstall now
# survives stray files, but they still have no business on the card:
#   - __pycache__ from running the PC-side tools over the tree;
#   - src/dashberry-panel if it was built on this PC. That one is not
#     cosmetic: it is an x86 binary, and make on the Pi would see it newer
#     than dashberry-panel.c, skip the rebuild, and install a panel the
#     card cannot execute.
find "$MNT/opt/dashberry/sw" -name __pycache__ -type d -prune -exec rm -rf {} +
rm -f "$MNT/opt/dashberry/sw/src/dashberry-panel"
# Bypass and mode flags ride in the payload's conf — the one the
# firstinstall step installs to /etc — so the panel (which bakes the
# shield/wireless glyph off DEBUG) and firstinstall read the same truth.
if [ "$BYPASS_TIME" = 1 ]; then
    sed -i 's/^BYPASS_TIME=0/BYPASS_TIME=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$BYPASS_REAR" = 1 ]; then
    sed -i 's/^BYPASS_REAR=0/BYPASS_REAR=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
# Mounting orientation: the recorders flip at capture, so the files on the
# card are upright and un-mirrored and nothing downstream has to know which
# way the camera was screwed to the glass. The conf ships these EMPTY, so the
# axis list is appended to the bare `NAME=` rather than substituted for a
# value — which also leaves the line's trailing comment intact.
if [ -n "$INVERT_FRONT" ]; then
    sed -i "s/^INVERT_FRONT=/INVERT_FRONT=$INVERT_FRONT/" "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ -n "$INVERT_REAR" ]; then
    sed -i "s/^INVERT_REAR=/INVERT_REAR=$INVERT_REAR/" "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$DEBUG" = 1 ]; then
    sed -i 's/^DEBUG=0/DEBUG=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$RF_JOIN" = 1 ]; then
    sed -i 's/^RF_JOIN=0/RF_JOIN=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
printf 'FIRSTBOOT_WIFI=%s\n' "$FIRSTBOOT_WIFI" \
    > "$MNT/opt/dashberry/install-opts"

cat > "$MNT/etc/systemd/system/dashberry-firstinstall.service" <<'EOF'
[Unit]
Description=DashBerry first-boot installer (self-removing)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/dashberry/sw/firstinstall.sh

[Service]
Type=oneshot
ExecStart=/opt/dashberry/sw/firstinstall.sh --from-unit
TimeoutStartSec=3600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF
mkdir -p "$MNT/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/dashberry-firstinstall.service \
    "$MNT/etc/systemd/system/multi-user.target.wants/dashberry-firstinstall.service"

# The account is --auth's job, on a debug card and a JOIN WIFI card alike:
# a card you can bring onto a network is only useful if something answers
# there. A SEALED card gets neither a user nor sshd — with no account to
# log into and no listener, its only interface is the OLED and pulling the
# card itself.
if [ "$AUTH" = 1 ]; then
    info "Creating account '${USERSPEC%%:*}' + ssh..."
    printf '%s:%s\n' "${USERSPEC%%:*}" \
        "$(openssl passwd -6 "${USERSPEC#*:}")" > "$BOOTDIR/userconf.txt"
    : > "$BOOTDIR/ssh"
fi
# The regulatory domain: stock Pi OS (since bullseye, still true on trixie)
# keeps wlan rfkill-blocked until one is set, and the kernel cmdline is the
# offline way to provide it. Needed by a --wifi first boot AND for the
# lifetime of a JOIN WIFI card. cmdline.txt is a single line — append to
# it, don't add a second. firstinstall removes the token again during the
# credential wipe unless the card is a debug or JOIN WIFI build.
if [ -n "$WIFI_CC" ]; then
    info "Setting the regulatory domain ($WIFI_CC)..."
    [ -f "$BOOTDIR/cmdline.txt" ] || die "No cmdline.txt on the boot partition"
    sed -i "1s/\$/ cfg80211.ieee80211_regdom=$WIFI_CC/" "$BOOTDIR/cmdline.txt"
fi
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "Staging first-boot Wi-Fi '$WIFI_SSID'..."
    NMFILE="$MNT/etc/NetworkManager/system-connections/dashberry-firstboot.nmconnection"
    mkdir -p "${NMFILE%/*}"
    # printf, not a heredoc: the PSK must land byte-for-byte ($, \, %s-safe);
    # umask 077 so the plaintext PSK is never world-readable, even briefly
    # (NM refuses keyfiles that are not 600 anyway)
    (
        umask 077
        {
            printf '[connection]\nid=dashberry-firstboot\nuuid=%s\ntype=wifi\nautoconnect=true\n\n' \
                "$(cat /proc/sys/kernel/random/uuid)"
            printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$WIFI_SSID"
            printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$WIFI_PSK"
            printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
        } > "$NMFILE"
    )
    chmod 600 "$NMFILE"
fi

sync
cleanup
trap - EXIT

# --- done ------------------------------------------------------------------
echo
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "Card ready."
else
    info "Card ready. First boot requires Ethernet connection."
fi
