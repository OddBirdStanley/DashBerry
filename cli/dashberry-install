#!/bin/bash
# dashberry-install — ALL-IN-ONE card builder for the DashBerry Pi 4 (PC-side).
#
# Replaces sw/install.sh (which ran on the Pi): one command takes a stock
# Raspberry Pi OS Lite image you already downloaded (nothing is ever fetched
# here) and a target block device, and produces a card that boots straight
# into a self-installing DashBerry:
#
#   1. wipes the old partition signatures and table (wipefs on every old
#      partition node, then the disk — incl. fs superblocks inside old
#      partitions and a stale backup GPT, none of which dd reaches) and
#      flashes the image — after a typed confirmation; the device is WIPED;
#   2. grows the OS partition to a fixed working size (default 8 GiB) instead
#      of letting first boot swallow the card — this is the volume that ends
#      up READ-ONLY (overlayfs, enabled at the end of the first-boot install);
#   3. creates the writable /data partition (ext4, rest of the card) and
#      appends its fstab entry (by PARTUUID; options from etc/fstab.snippet);
#   4. merges boot/config-snippet.txt into config.txt;
#   5. stages sw/ at /opt/dashberry/sw and enables a oneshot first-boot
#      service that installs packages, builds dashberry-panel, enables the
#      units, and reboots (sw/firstinstall.sh). Without --debug the card is
#      PRODUCTION: the OS flips read-only, no user account or ssh exists,
#      and every network credential is wiped — sealed; archive by pulling
#      the card. With --debug NAME:PASS it is a DEBUG card: writable OS,
#      ssh + that user, journal kept and persistent;
#   6. (--wifi) stages a first-boot Wi-Fi profile plus the regulatory
#      domain that stock Pi OS (Trixie) needs before it will unblock wlan,
#      so boot 2 can run without Ethernet. PRODUCTION wipes every trace of
#      it before the overlay freezes the OS; DEBUG keeps the profile so the
#      card rejoins the LAN on every boot.
#
# The stock image's own auto-expand is left in place and self-disarms: it
# refuses to grow a root partition that is not the last one, and /data is.
#
# PC-side tooling, so the on-image no-interpreters rule doesn't bind; bash
# rather than Python because this is pure dd/sfdisk/mkfs orchestration.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: sudo dashberry-install [options] <image> <device>

  <image>   Raspberry Pi OS Lite (64-bit) image
  <device>  target block device (at least 16GB; ALL DATA ON IT WILL BE ERASED.)

Options:
  --bypass-time     ignore DS3231 from system requirement and use GPS for time calibration
  --bypass-rear     ignore rear camera from system requirement
  --root-size GIB   OS partition size in GiB (default: 8)
  --debug NAME:PASS build a DEBUG card: writable OS, ssh with this user,
                    journal kept + persistent, Wi-Fi profile kept.
                    Without it the card is PRODUCTION: read-only OS, no
                    user, no ssh, all network credentials wiped (sealed)
  --wifi SSID:PSK   run the first boot over Wi-Fi instead of Ethernet
                    (PRODUCTION erases it at the end; DEBUG keeps it)
  --wifi-country CC required to configure --wifi
  -h, --help        display this help
EOF
}

die()  { echo "Fatal Error: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing tool: $1"; }

MIN_DATA_BYTES=$((1024 * 1024 * 1024))    # refuse a /data smaller than 1 GiB

BYPASS_TIME=0
BYPASS_REAR=0
ROOT_GIB=8
DEBUG=0
USERSPEC=
WIFISPEC=
WIFI_CC=
WIFI_SSID=
FIRSTBOOT_WIFI=0
IMG=
DEV=

while [ $# -gt 0 ]; do
    case $1 in
        --bypass-time) BYPASS_TIME=1 ;;
        --bypass-rear) BYPASS_REAR=1 ;;
        --root-size)   shift; ROOT_GIB=${1:-} ;;
        --debug)       shift; DEBUG=1; USERSPEC=${1:-} ;;
        --wifi)        shift; WIFISPEC=${1:-} ;;
        --wifi-country) shift; WIFI_CC=${1:-} ;;
        -h|--help)     usage; exit 0 ;;
        -*)            die "Unknown option: $1 (see --help)" ;;
        *)             if   [ -z "$IMG" ]; then IMG=$1
                       elif [ -z "$DEV" ]; then DEV=$1
                       else die "Too many arguments (see --help)"; fi ;;
    esac
    shift
done

[ -n "$IMG" ] && [ -n "$DEV" ] || { usage >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "Run this script as root"
case $ROOT_GIB in *[!0-9]*|'') die "--root-size requires a whole number of GiB" ;; esac
[ "$ROOT_GIB" -ge 8 ] || die "--root-size must be at least 8GiB"
# The device must hold boot (512 MiB) + the OS + a useful /data — checked
# up front because the wipe below is the point of no return. The default
# 8 GiB OS means a 16 GB card in practice.
MIN_DEV_BYTES=$((512 * 1024 * 1024 + ROOT_GIB * 1024 * 1024 * 1024 + MIN_DATA_BYTES))
if [ "$DEBUG" = 1 ]; then
    case $USERSPEC in *:*) ;; *) die "--debug requires NAME:PASS (the ssh login)" ;; esac
    need openssl
fi
if [ -n "$WIFISPEC" ]; then
    case $WIFISPEC in *:*) ;; *) die "--wifi requires SSID:PSK" ;; esac
    WIFI_SSID=${WIFISPEC%%:*}          # split at the FIRST ':' — the PSK may
    WIFI_PSK=${WIFISPEC#*:}            # contain colons, the SSID may not
    [ -n "$WIFI_SSID" ] && [ "${#WIFI_SSID}" -le 32 ] || \
        die "--wifi SSID must be 1-32 characters and must not contain :"
    [ "${#WIFI_PSK}" -ge 8 ] && [ "${#WIFI_PSK}" -le 64 ] || \
        die "--wifi PSK must be a 8-63 char passphrase or 64 hex digits"
    [ -n "$WIFI_CC" ] || \
        die "--wifi needs --wifi-country CC"
    case $WIFI_CC in [A-Za-z][A-Za-z]) ;; *) die "--wifi-country wants a two-letter code" ;; esac
    WIFI_CC=$(printf '%s' "$WIFI_CC" | tr '[:lower:]' '[:upper:]')
    FIRSTBOOT_WIFI=1
elif [ -n "$WIFI_CC" ]; then
    die "--wifi-country should only be used with --wifi"
fi

for t in dd sfdisk partprobe blkid mkfs.ext4 e2fsck resize2fs lsblk \
         blockdev udevadm findmnt mktemp awk sed tr wipefs; do need "$t"; done

# --- image: must already exist locally; pick the decompressor by suffix ----
[ -f "$IMG" ] || die "Image not found: $IMG"
case $IMG in
    *.img) DECOMP=cat ;;
    *.xz)  DECOMP=xz;    need xz ;;
    *.gz)  DECOMP=gzip ;;
    *.zip) DECOMP=unzip; need unzip ;;
    *)     die "Unrecognized image format (not in: .img, .img.xz, .img.gz or .zip): $IMG" ;;
esac
decompress() {
    case $DECOMP in
        cat)   cat "$IMG" ;;
        xz)    xz -dc "$IMG" ;;
        gzip)  gzip -dc "$IMG" ;;
        unzip) unzip -p "$IMG" '*.img' ;;
    esac
}

# --- device: whole disk, not the system disk, unmounted, big enough --------
[ -b "$DEV" ] || die "$DEV is not a block device"
devname=$(basename "$(readlink -f "$DEV")")
[ -e "/sys/block/$devname" ] || die "$DEV looks like a partition, use the whole disk"

rootsrc=$(findmnt -no SOURCE / 2>/dev/null || true)
rootdisk=$(lsblk -no PKNAME "$rootsrc" 2>/dev/null | head -n1 || true)
[ "$rootdisk" != "$devname" ] || die "Refusing: $DEV holds the running system"

if lsblk -no MOUNTPOINT "$DEV" 2>/dev/null | grep -q .; then
    die "$DEV has mounted partitions"
fi

devbytes=$(blockdev --getsize64 "$DEV")
[ "$devbytes" -ge "$MIN_DEV_BYTES" ] || \
    die "$DEV is $((devbytes / 1000000000)) GB (boot + ${ROOT_GIB} GiB OS + 1 GiB /data needs at least $(((MIN_DEV_BYTES + 999999999) / 1000000000)) GB)"

# --- the point of no return: a typed confirmation, nothing softer ----------
[ -t 0 ] || die "This script must be run on a visual terminal"
echo "################################################################"
echo "#                          WARNING                             #"
echo "#   ALL DATA ON THE DEVICE BELOW WILL BE PERMANENTLY ERASED    #"
echo "################################################################"
echo
lsblk -o NAME,MODEL,SIZE,TYPE,MOUNTPOINT "$DEV" | sed 's/^/    /'
echo
echo "    image : $IMG"
echo "    layout: boot | OS ${ROOT_GIB} GiB$( [ $DEBUG = 0 ] && echo ' (read-only)' ) | /data"
if [ "$DEBUG" = 1 ]; then
    echo "    mode  : DEBUG — writable OS, ssh user '${USERSPEC%%:*}', journal kept"
else
    echo "    mode  : PRODUCTION — read-only OS, no user, no ssh (sealed)"
fi
[ "$BYPASS_TIME" = 1 ] && echo "    bypass: TIME"
[ "$BYPASS_REAR" = 1 ] && echo "    bypass: REAR"
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    if [ "$DEBUG" = 1 ]; then
        echo "    wifi  : '$WIFI_SSID' ($WIFI_CC) (kept — debug card)"
    else
        echo "    wifi  : '$WIFI_SSID' ($WIFI_CC) (first boot only, then wiped)"
    fi
fi
echo
printf 'Type the device path (%s) to continue: ' "$DEV"
read -r answer
[ "$answer" = "$DEV" ] || die "Aborted"

# --- wipe: start from a clean device, not whatever the card held -----------
info "Wiping the old partition signatures and table on $DEV..."
# dd below only overwrites the image's length: a previous GPT keeps its
# backup table at the END of the disk, and old filesystem superblocks (a
# previous card's /data ext4, say) sit INSIDE the old partitions, where a
# whole-disk wipefs never probes — sfdisk then warns "contains a ext4
# signature" when a new partition lands on the same offset. So wipe each
# partition through its node while the old table still provides them, THEN
# the table itself (MBR, GPT primary+backup).
while read -r part; do
    if [ -b "$part" ]; then wipefs -a -q "$part"; fi
done < <(lsblk -nro TYPE,PATH "$DEV" | awk '$1 == "part" {print $2}')
wipefs -a -q "$DEV"
partprobe "$DEV" 2>/dev/null || true
udevadm settle

# --- flash -----------------------------------------------------------------
info "Flashing $IMG onto $DEV..."
decompress | dd of="$DEV" bs=4M iflag=fullblock conv=fsync status=progress
sync
partprobe "$DEV"
udevadm settle

P=""
case $devname in *[0-9]) P=p ;; esac      # sdb2 vs mmcblk0p2 / nvme0n1p2
BOOTP="${DEV}${P}1"
ROOTP="${DEV}${P}2"
DATAP="${DEV}${P}3"

wait_part() {
    for _ in $(seq 1 20); do
        [ -b "$1" ] && return 0
        sleep 0.5
    done
    die "Partition $1 never appeared after flashing"
}
wait_part "$BOOTP"
wait_part "$ROOTP"

[ "$(blkid -o value -s TYPE "$BOOTP")" = vfat ] || die "$BOOTP is not vfat"
[ "$(blkid -o value -s TYPE "$ROOTP")" = ext4 ] || die "$ROOTP is not ext4"
[ ! -b "$DATAP" ] || die "Image already carries a 3rd partition (expected a stock 2-partition Pi OS image)"

# --- partitions: right-size the (to-be-read-only) OS, add /data ------------
root_bytes=$((ROOT_GIB * 1024 * 1024 * 1024))
cur_bytes=$(blockdev --getsize64 "$ROOTP")
if [ "$cur_bytes" -lt "$root_bytes" ]; then
    info "Growing OS partition to ${ROOT_GIB} GiB..."
    echo ", ${ROOT_GIB}GiB" | sfdisk -q -N 2 "$DEV"
    partprobe "$DEV"
    udevadm settle
    rc=0
    e2fsck -f -p "$ROOTP" || rc=$?
    [ "$rc" -le 2 ] || die "e2fsck on $ROOTP failed (exit $rc)"
    resize2fs "$ROOTP"
else
    info "Image OS partition already >= ${ROOT_GIB} GiB"
fi

info "Creating /data partition..."
# The flashed image can leave a small free gap BEFORE the boot partition
# (bootfs starts at 4 MiB), and sfdisk with no start sector appends into the
# first free area — i.e. that gap, yielding a few-MiB /data. Start explicitly
# on the first 1 MiB boundary after the OS partition instead.
root_end=$(sfdisk -l -o Device,End "$DEV" | awk -v p="$ROOTP" '$1 == p {print $2}')
case $root_end in *[!0-9]*|'') die "Could not read the end sector of $ROOTP" ;; esac
data_start=$(( (root_end / 2048 + 1) * 2048 ))
# --wipe-partitions: erase any stale fs signature where the new partition
# lands (belt-and-braces to the pre-dd wipe — covers cards whose old table
# was already gone, leaving signatures with no node to wipe them through)
echo "${data_start},,L" | sfdisk -q --wipe-partitions always -a "$DEV"
partprobe "$DEV"
udevadm settle
wait_part "$DATAP"
[ "$(blockdev --getsize64 "$DATAP")" -ge "$MIN_DATA_BYTES" ] || \
    die "/data would be under 1 GiB, lower --root-size or use a bigger card"
mkfs.ext4 -q -F -L dashberry-data "$DATAP"
DATA_PARTUUID=$(blkid -o value -s PARTUUID "$DATAP")
[ -n "$DATA_PARTUUID" ] || die "Could not read PARTUUID of $DATAP"

info "Creating /data directory skeleton..."
DMNT=$(mktemp -d)
mount "$DATAP" "$DMNT"
mkdir -p "$DMNT/front" "$DMNT/rear" "$DMNT/gps"
umount "$DMNT"
rmdir "$DMNT"

# --- customize the OS + boot partitions ------------------------------------
SWDIR=$(cd "$(dirname "$(readlink -f "$0")")/../sw" && pwd)
[ -f "$SWDIR/firstinstall.sh" ] || die "payload not found: $SWDIR/firstinstall.sh"

MNT=
BOOTDIR=
cleanup() {
    [ -n "$BOOTDIR" ] && umount "$BOOTDIR" 2>/dev/null || true
    if [ -n "$MNT" ]; then
        umount "$MNT" 2>/dev/null || true
        rmdir "$MNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

MNT=$(mktemp -d)
mount "$ROOTP" "$MNT"
BOOTDIR="$MNT/boot/firmware"                  # bookworm+ (incl. trixie); /boot fallback
[ -d "$BOOTDIR" ] || BOOTDIR="$MNT/boot"
mount "$BOOTP" "$BOOTDIR"

# --wifi rides on NetworkManager (the stack since bookworm, incl. trixie);
# bail before customizing a card that could never bring the profile up
# (bullseye and older run dhcpcd/wpa_supplicant)
[ "$FIRSTBOOT_WIFI" = 0 ] || [ -d "$MNT/etc/NetworkManager" ] || \
    die "--wifi needs a NetworkManager image"

info "Appending /data to fstab (PARTUUID=$DATA_PARTUUID)..."
mkdir -p "$MNT/data"
cat >> "$MNT/etc/fstab" <<EOF
# DashBerry footage partition (dashberry-install; options per etc/fstab.snippet
# — commit=1 bounds a hard power cut to ~1-2 s of lost footage)
PARTUUID=$DATA_PARTUUID  /data  ext4  defaults,noatime,data=ordered,commit=1,nofail  0  2
EOF

info "Merging boot/config-snippet.txt into config.txt..."
# The snippet's directives sit between its header block (ends at the first
# blank line) and the dashes-only separator (the cmdline.txt notes below that
# are documentation, not directives).
snippet=$(awk '/^# -+$/{exit} started{print} /^$/{started=1}' \
    "$SWDIR/boot/config-snippet.txt")
if [ "$BYPASS_TIME" = 1 ]; then
    snippet=$(printf '%s\n' "$snippet" | sed '/^# --- DS3231 RTC ---$/d; /^dtoverlay=i2c-rtc/d')
fi
{
    echo
    echo "# ===== DashBerry (added by dashberry-install) ====="
    printf '%s\n' "$snippet"
} >> "$BOOTDIR/config.txt"

info "Staging sw/ payload and first-boot installer..."
mkdir -p "$MNT/opt/dashberry"
cp -a "$SWDIR" "$MNT/opt/dashberry/sw"
# Bypass and mode flags ride in the payload's conf — the one the
# firstinstall step installs to /etc — so the panel (which bakes the
# shield/wireless glyph off DEBUG) and firstinstall read the same truth.
if [ "$BYPASS_TIME" = 1 ]; then
    sed -i 's/^BYPASS_TIME=0/BYPASS_TIME=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$BYPASS_REAR" = 1 ]; then
    sed -i 's/^BYPASS_REAR=0/BYPASS_REAR=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
if [ "$DEBUG" = 1 ]; then
    sed -i 's/^DEBUG=0/DEBUG=1/' "$MNT/opt/dashberry/sw/etc/dashberry.conf"
fi
printf 'FIRSTBOOT_WIFI=%s\n' "$FIRSTBOOT_WIFI" \
    > "$MNT/opt/dashberry/install-opts"

cat > "$MNT/etc/systemd/system/dashberry-firstinstall.service" <<'EOF'
[Unit]
Description=DashBerry first-boot installer (self-removing)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/dashberry/sw/firstinstall.sh

[Service]
Type=oneshot
ExecStart=/opt/dashberry/sw/firstinstall.sh --from-unit
TimeoutStartSec=3600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF
mkdir -p "$MNT/etc/systemd/system/multi-user.target.wants"
ln -sf /etc/systemd/system/dashberry-firstinstall.service \
    "$MNT/etc/systemd/system/multi-user.target.wants/dashberry-firstinstall.service"

# PRODUCTION cards get neither a user nor sshd: with no account to log
# into and no listener, the sealed card's only interface is the OLED and
# pulling the card itself.
if [ "$DEBUG" = 1 ]; then
    info "Debug card: user '${USERSPEC%%:*}' + ssh..."
    printf '%s:%s\n' "${USERSPEC%%:*}" \
        "$(openssl passwd -6 "${USERSPEC#*:}")" > "$BOOTDIR/userconf.txt"
    : > "$BOOTDIR/ssh"
fi
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "Staging first-boot Wi-Fi '$WIFI_SSID'..."
    NMFILE="$MNT/etc/NetworkManager/system-connections/dashberry-firstboot.nmconnection"
    mkdir -p "${NMFILE%/*}"
    # printf, not a heredoc: the PSK must land byte-for-byte ($, \, %s-safe);
    # umask 077 so the plaintext PSK is never world-readable, even briefly
    # (NM refuses keyfiles that are not 600 anyway)
    (
        umask 077
        {
            printf '[connection]\nid=dashberry-firstboot\nuuid=%s\ntype=wifi\nautoconnect=true\n\n' \
                "$(cat /proc/sys/kernel/random/uuid)"
            printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$WIFI_SSID"
            printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$WIFI_PSK"
            printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
        } > "$NMFILE"
    )
    chmod 600 "$NMFILE"
    # Stock Pi OS (since bullseye, still true on trixie) keeps wlan
    # rfkill-blocked until a regulatory domain is set; the kernel cmdline is
    # the offline way to provide one. cmdline.txt is a single line — append
    # to it, don't add a second. On a production card firstinstall removes
    # the token again during the credential wipe; a debug card keeps it.
    [ -f "$BOOTDIR/cmdline.txt" ] || die "No cmdline.txt on the boot partition"
    sed -i "1s/\$/ cfg80211.ieee80211_regdom=$WIFI_CC/" "$BOOTDIR/cmdline.txt"
fi

sync
cleanup
trap - EXIT

# --- done ------------------------------------------------------------------
echo
if [ "$FIRSTBOOT_WIFI" = 1 ]; then
    info "Card ready."
else
    info "Card ready. First boot requires Ethernet connection."
fi
