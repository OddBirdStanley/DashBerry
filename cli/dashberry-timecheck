#!/bin/sh
# dashberry-timecheck — which of the three timestamp faults is this card's?
#
# INVESTIGATE-TIMESTAMPS.md establishes that "the session folders have the
# wrong timestamps" has three unrelated causes, that they need different
# responses (one is a bug on the card, one is a display convention, one is
# filesystem semantics that no fix can change), and that the card itself
# carries the evidence to tell them apart. This is that five-minute check,
# run over every session instead of one.
#
# It reads only; it never writes to the tree. Point it at a mounted card, a
# copied /data, or run it on the Pi:
#
#   dashberry-timecheck [/path/to/data]        (default /data)
#
# POSIX sh + coreutils, so it runs on the card as well as the PC — this is
# the one PC-side tool that must also work with nothing but the Pi's own
# userland, because "is the RTC lying?" is a question you ask while the Pi
# is in front of you.
#
# THE FOUR CLOCKS. Per session, four things should all say the same time,
# and each is set by a different actor at a different moment — which is
# exactly why their disagreements localize the fault:
#
#   name   the session directory name; session-init's `date` AT BOOT
#   dir    the session folder mtime; POSIX last-entry-created, per camera
#   boot   the health log's first record; dashberry-panel, seconds LATER
#   rmc    field 1+9 of the first $G?RMC; the satellites, absolute truth
#
# name vs boot pins a clock correction to the window between them. Either
# vs rmc says whether the card's clock was ever right at all.
set -eu

DATA=${1:-/data}
[ -d "$DATA/front" ] || [ -d "$DATA/health" ] || {
    echo "dashberry-timecheck: $DATA does not look like a DashBerry /data tree" >&2
    echo "  (expected front/ rear/ gps/ health/ under it)" >&2
    exit 1
}

# Same epoch session-init refuses to mint below. Read from the card's own
# conf when this runs on the Pi, so the two can never disagree; the literal
# is the 2026-01-01 fallback for a pulled card with no conf in reach.
CLOCK_FLOOR=1767225600
[ -r /etc/dashberry.conf ] && . /etc/dashberry.conf

# Session name -> epoch. The name is rendered in the CARD's timezone, which
# nothing in the install ever sets, so it is Etc/UTC — hence -u here. A
# whole-hour disagreement with your file manager is mechanism 2 and is not
# a fault; see the verdict text.
# Split YYYYmmdd-HHMMSS-NNNN by column rather than handing the raw name to
# date(1): every compact form date accepts is ambiguous with something, and
# a silently mis-parsed name would make this tool lie about the very thing
# it exists to check.
name_epoch() {
    case $1 in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*) ;;
        *) echo ""; return 0 ;;
    esac
    n=$1
    date -u -d "$(printf '%s' "$n" | cut -c1-4)-$(printf '%s' "$n" | cut -c5-6)-$(printf '%s' "$n" | cut -c7-8) $(printf '%s' "$n" | cut -c10-11):$(printf '%s' "$n" | cut -c12-13):$(printf '%s' "$n" | cut -c14-15)" \
        +%s 2>/dev/null || echo ""
}

# First $G?RMC in the session's NMEA log -> epoch. Field 1 is hhmmss.ss and
# field 9 is ddmmyy, both UTC; a sentence logged before the first fix has an
# empty date field, so keep looking until one carries both.
rmc_epoch() {
    f=$1
    [ -r "$f" ] || { echo ""; return 0; }
    awk -F, '
        /\$G.RMC/ && $2 != "" && $10 != "" {
            printf "20%s-%s-%s %s:%s:%s\n",
                   substr($10,5,2), substr($10,3,2), substr($10,1,2),
                   substr($2,1,2),  substr($2,3,2),  substr($2,5,2)
            exit
        }' "$f" 2>/dev/null | {
        read -r stamp || { echo ""; return 0; }
        date -u -d "$stamp" +%s 2>/dev/null || echo ""
    }
}

fmt() { [ -n "${1:-}" ] && date -u -d "@$1" '+%F %T' || printf '%-19s' "-"; }

# Absolute difference, or "" if either side is unknown.
delta() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo ""; return 0; }
    echo $(( $1 > $2 ? $1 - $2 : $2 - $1 ))
}

# Seconds -> the largest unit that keeps the number small. These gaps run
# from a few seconds (the probe race) to years (a 1970 clock), and raw
# seconds are unreadable at both ends.
span() {
    if   [ "$1" -lt 120 ];    then echo "$1 s"
    elif [ "$1" -lt 7200 ];   then echo "$(($1 / 60)) min"
    elif [ "$1" -lt 172800 ]; then echo "$(($1 / 3600)) h"
    else                           echo "$(($1 / 86400)) days"
    fi
}

SESSIONS=$(ls "$DATA/health" 2>/dev/null || ls "$DATA/front" 2>/dev/null || true)
[ -n "$SESSIONS" ] || { echo "no sessions under $DATA"; exit 0; }

# Counters for the closing summary — a verdict per session is noise; the
# question being asked is which mechanism this CARD has.
n_total=0 n_floor=0 n_stale=0 n_agree=0 n_nogps=0

for s in $SESSIONS; do
    n_total=$((n_total + 1))
    ne=$(name_epoch "$s")
    be=""
    hl="$DATA/health/$s/$s.log"
    [ -r "$hl" ] && be=$(awk 'NR == 1 && $2 == "boot" { print $1; exit }' "$hl" || true)
    re=$(rmc_epoch "$DATA/gps/$s/$s.nmea")

    echo "=== $s"
    printf '    %-6s %s\n' name "$(fmt "$ne")"
    printf '    %-6s %s\n' boot "$(fmt "$be")"
    printf '    %-6s %s%s\n' rmc "$(fmt "$re")" \
        "$([ -z "$re" ] && echo '  (no dated fix in the NMEA log)' || true)"
    for cam in front rear gps health; do
        [ -d "$DATA/$cam/$s" ] || continue
        printf '    %-6s %s  %s/\n' dir \
            "$(date -u -d "@$(stat -c %Y "$DATA/$cam/$s")" '+%F %T')" "$cam"
    done

    # --- verdict ----------------------------------------------------------
    d_nr=$(delta "$ne" "$re")      # name vs satellites: was the clock ever right
    d_nb=$(delta "$ne" "$be")      # name vs panel: did it get corrected mid-boot
    if [ -n "$ne" ] && [ "$ne" -lt "$CLOCK_FLOOR" ]; then
        n_floor=$((n_floor + 1))
        echo "    -> MECHANISM 1: name predates CLOCK_FLOOR. The RTC was never"
        echo "       set or its cell is dead; nothing offline ever corrects it."
    elif [ -n "$d_nr" ] && [ "$d_nr" -gt 3600 ]; then
        n_stale=$((n_stale + 1))
        echo "    -> MECHANISM 1: name disagrees with the satellites by" \
             "$(span "$d_nr")."
        if [ -n "$d_nb" ] && [ "$d_nb" -gt 300 ]; then
            echo "       boot is $(span "$d_nb") from the name: the clock was"
            echo "       corrected BETWEEN session-init and the panel's first"
            echo "       write — the probe race, or a card mid-GPS-fix."
        else
            echo "       boot agrees with the name, so the clock stayed wrong"
            echo "       all drive: the RTC itself holds the wrong time."
        fi
    elif [ -z "$re" ]; then
        n_nogps=$((n_nogps + 1))
        echo "    -> INCONCLUSIVE: the card's own clocks agree, but there is no"
        echo "       dated GPS fix in this session to check them against — a"
        echo "       card can be perfectly self-consistent and still wrong."
    else
        n_agree=$((n_agree + 1))
        echo "    -> name and satellites agree. Any oddness left is MECHANISM 2"
        echo "       (names are UTC, your file manager is local) or MECHANISM 3"
        echo "       (a directory mtime is its LAST write — front/rear session"
        echo "       folders mark the END of the drive, and retention deleting"
        echo "       an old segment bumps that old folder to today)."
    fi
    echo
done

echo "=== $n_total session(s): $n_floor below the floor, $n_stale disagreeing" \
     "with GPS, $n_agree agreeing, $n_nogps without a dated fix"
if [ "$n_floor" -gt 0 ] || [ "$n_stale" -gt 0 ]; then
    cat <<'EOF'

MECHANISM 1 is real and it is not cosmetic: retention deletes by oldest
mtime, so footage written under a stale clock looks older than everything
else and the sweep eats the drive you are currently recording first.

  On the Pi, with the card writable:
      hwclock -r                       # what the DS3231 itself holds
      date -u -s 'YYYY-mm-dd HH:MM:SS'  # or let chrony sync first
      hwclock -w                       # burn it in
      hwclock -r                       # confirm it stuck

  If it does not stick across a power cycle with the Pi unplugged, the
  coin cell is dead — that is the whole fault, and a new CR2032 ends it.
EOF
fi
