#!/usr/bin/env python3
"""dashberry-cli — PC-side tooling for a copy of the DashBerry /data tree.

PLAN.md §3c. Runs on an external machine against a pulled-card copy of /data.
This tool NEVER ships on the Pi image (the runtime footprint rule — no
interpreters on the image — does not bind PC-side tooling, which is why it
may be Python). firstinstall.sh deliberately does not install it.

Stdlib only; ffmpeg/ffprobe are invoked as subprocesses for all heavy lifting.

Subcommands:
  catalog  one line per DRIVE (= per-boot session directory), or just one
           drive with --drive; --verbose adds distance / average / top speed
           and button-B event markers
  render   continuous boot-to-shutdown video of one drive (footage holes —
           including segments ffprobe cannot read — become black "No
           Signal" filler, GPS trouble is labeled from the health log;
           --annotate burns time/position/speed);
           --camera both-prio-* composites the other camera picture-in-
           picture; --timelapse speeds the result up (a factor "8x" or a
           target length "HH:MM:SS"). Always a re-encode — near-
           transparent x264 settings
  gpx      GPX 1.0 track (native <speed>, m/s) from the session NMEA log
  csv      the same track as a spreadsheet — one row per GPS fix, with SoC
           temperature joined on from the health log and the button-B
           markers flagged

The health log (/data/health/<session>/<session>.log, written by
dashberry-panel — format in IMPL.md) is what makes render honest: its
first/last records bound the session, its gps/gpsfix records become
"GPS Error" / "GPS No Signal" overlays, and its event records are the
button-B markers. Sessions predating the health log degrade gracefully
(footage evidence bounds the timeline, fix holes stand in for NOFIX).

Time alignment note (RENDER): a segment file's mtime is when it was LAST
written, i.e. the segment's END. Segment start = mtime - duration(ffprobe).
Getting this wrong shifts every annotation by one segment length.
"""

import argparse
import csv
import datetime as dt
import math
import os
import subprocess
import sys
import tempfile

def _version():
    # The repo root's VERSION file, one directory above cli/ — this tool
    # runs from a checkout, never from the card (the runtime footprint rule
    # above), so the file is normally there. A copy of the script that
    # wandered off alone answers honestly instead of guessing.
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                               os.pardir, "VERSION")) as f:
            return f.read().strip()
    except OSError:
        return "unknown"


VERSION = _version()

KNOTS_TO_MPH = 1.15078
KNOTS_TO_KMH = 1.852
KNOTS_TO_MS = 0.514444

MOVING_KNOTS = 2.0                  # 3.7 km/h: below this the vehicle is
                                    # stopped and the receiver is reporting
                                    # noise, not a crawl
MAX_KNOTS = 250.0 / KNOTS_TO_KMH    # 250 km/h — a faster fix is junk

TIMELINE_FPS = 30       # timeline renders normalize both cameras to this
PIP_FRAC = 0.28         # PiP window width as a fraction of the main width
PIP_MARGIN = 16         # PiP inset from the top/right edges, px
GAP_MIN = 1.0           # timeline holes shorter than this are scheduling
                        # jitter (mtime granularity), absorbed not rendered
FILLER_TILE = 30.0      # seconds of pre-rendered "No Signal" filler; a hole
                        # of any length is covered by repeating this one tile
CAM_FALLBACK_WH = {"front": (1920, 1080), "rear": (1640, 922)}


# --------------------------------------------------------------- helpers --

def die(msg):
    sys.exit("dashberry-cli: " + msg)


def warn(msg):
    sys.stderr.write("dashberry-cli: " + msg + "\n")


def sessions(data):
    """Union of session dir names across front/rear/gps."""
    names = set()
    for sub in ("front", "rear", "gps"):
        d = os.path.join(data, sub)
        if os.path.isdir(d):
            for e in os.listdir(d):
                if os.path.isdir(os.path.join(d, e)):
                    names.add(e)
    return sorted(names)


def segments(data, session, camera):
    """Sorted [(path, mtime)] for one camera of one session."""
    d = os.path.join(data, camera, session)
    if not os.path.isdir(d):
        return []
    out = []
    for e in sorted(os.listdir(d)):
        if e.endswith(".ts"):
            p = os.path.join(d, e)
            out.append((p, os.path.getmtime(p)))
    return out


def nmea_path(data, session):
    d = os.path.join(data, "gps", session)
    if not os.path.isdir(d):
        return None
    for e in sorted(os.listdir(d)):
        if e.endswith(".nmea"):
            return os.path.join(d, e)
    return None


def parse_rmc(path):
    """[(epoch_utc, lat, lon, speed_knots)] from RMC sentences with status A."""
    fixes = []
    if not path or not os.path.exists(path):
        return fixes
    with open(path, "r", errors="replace") as f:
        for line in f:
            if len(line) < 6 or not line.startswith("$") or line[3:6] != "RMC":
                continue
            parts = line.strip().split("*")[0].split(",")
            if len(parts) < 10 or parts[2] != "A":
                continue
            try:
                t, lat, ns, lon, ew = parts[1], parts[3], parts[4], parts[5], parts[6]
                knots = float(parts[7]) if parts[7] else 0.0
                date = parts[9]
                deg = int(float(lat) / 100)
                latd = deg + (float(lat) - deg * 100) / 60.0
                if ns == "S":
                    latd = -latd
                deg = int(float(lon) / 100)
                lond = deg + (float(lon) - deg * 100) / 60.0
                if ew == "W":
                    lond = -lond
                when = dt.datetime(
                    2000 + int(date[4:6]), int(date[2:4]), int(date[0:2]),
                    int(t[0:2]), int(t[2:4]), int(float(t[4:])),
                    tzinfo=dt.timezone.utc)
                fixes.append((when.timestamp(), latd, lond, knots))
            except (ValueError, IndexError):
                continue
    return fixes


def health_path(data, session):
    d = os.path.join(data, "health", session)
    if not os.path.isdir(d):
        return None
    for e in sorted(os.listdir(d)):
        if e.endswith(".log"):
            return os.path.join(d, e)
    return None


def parse_health(path):
    """Parse the panel's per-session health log (format: IMPL.md — lines of
    '<epoch> boot' / '<epoch> ver <release>' / '<epoch> <comp> <OK|ERR>' /
    '<epoch> gpsfix <FIX|NOFIX>' / '<epoch> event' / '<epoch> hb' /
    '<epoch> tmp <degC>'; unknown kinds are skipped). Returns None if
    absent/unreadable, else a dict:
      start, end   first/last record epoch (boot .. last heartbeat)
      err          {comp: [(t0, t1), ...]} ERR spans (open spans end at end)
      nofix        [(t0, t1), ...] spans without a GPS fix
      events       [epoch, ...] button-B markers
      temps        [degC, ...] SoC temperature samples (empty on sessions
                   recorded before the panel logged them)
      temp_series  [(epoch, degC), ...] the same samples with their times
                   kept, for joining temperature onto a GPS timeline (csv)
    Tolerates the duplicate initial-state dumps a mid-session log reopen
    produces (same-state records are ignored)."""
    if not path:
        return None
    err, open_err = {}, {}
    nofix, nofix_open = [], None
    events, temps = [], []
    start = end = None
    try:
        f = open(path, "r", errors="replace")
    except OSError:
        return None
    with f:
        for line in f:
            parts = line.split()
            if len(parts) < 2 or not parts[0].isdigit():
                continue
            t = int(parts[0])
            if start is None:
                start = t
            end = t
            kind = parts[1]
            if kind == "event":
                events.append(t)
            elif kind == "tmp" and len(parts) >= 3:
                try:
                    temps.append((t, int(parts[2])))
                except ValueError:
                    pass
            elif kind == "gpsfix" and len(parts) >= 3:
                if parts[2] == "NOFIX" and nofix_open is None:
                    nofix_open = t
                elif parts[2] == "FIX" and nofix_open is not None:
                    nofix.append((nofix_open, t))
                    nofix_open = None
            elif len(parts) >= 3 and parts[2] in ("OK", "ERR"):
                if parts[2] == "ERR" and kind not in open_err:
                    open_err[kind] = t
                elif parts[2] == "OK" and kind in open_err:
                    err.setdefault(kind, []).append((open_err.pop(kind), t))
    if start is None:
        return None
    for comp, t0 in open_err.items():
        err.setdefault(comp, []).append((t0, end))
    if nofix_open is not None:
        nofix.append((nofix_open, end))
    return {"start": start, "end": end, "err": err, "nofix": nofix,
            "events": events, "temps": [c for _, c in temps],
            "temp_series": temps}


def spans_subtract(spans, minus):
    """Subtract the 'minus' intervals from 'spans'; drops slivers < 0.2 s."""
    out = []
    for a, b in spans:
        cur = [(a, b)]
        for ma, mb in minus:
            nxt = []
            for x, y in cur:
                if mb <= x or ma >= y:
                    nxt.append((x, y))
                    continue
                if x < ma:
                    nxt.append((x, ma))
                if mb < y:
                    nxt.append((mb, y))
            cur = nxt
        out += cur
    return [(a, b) for a, b in out if b - a > 0.2]


# A file ffprobe cannot read is a broken SEGMENT, not a broken install, and
# the two used to be one fatal error: a card pulled after a power cut ends
# its last session with a zero-length or header-less fragment (the recorder
# never got to finalize it), and that one file aborted the whole render —
# the drive you most wanted to look at is exactly the one that ends badly.
# So the probes take fatal=False and answer None, and callers treat an
# unreadable file as footage that is not there: the timeline covers it with
# "No Signal" filler like any other hole. ffprobe *itself* missing stays
# fatal — that is the broken install, and no amount of skipping fixes it.

def ffprobe_duration(path, fatal=True):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "default=noprint_wrappers=1:nokey=1", path],
            capture_output=True, text=True, check=True).stdout.strip()
        return float(out)
    except FileNotFoundError:
        die("ffprobe not found (is ffmpeg installed?)")
    except (subprocess.CalledProcessError, ValueError):
        if fatal:
            die("ffprobe failed on %s" % path)
        return None


def ffprobe_dur_start(path, fatal=True):
    """(duration, first container timestamp) in a single probe.

    The start timestamp is what makes a concat-demuxer cut land in the right
    place: inpoint/outpoint are absolute timestamps in the FILE'S OWN domain,
    and an MPEG-TS segment does not begin at zero (the muxer offsets by 1.4 s,
    and splitmuxsink carries a running PTS across the whole session, so a late
    segment can start hours in). Feeding a raw in-segment offset would cut at
    a completely unrelated instant. Probed here rather than at cut time
    because the duration probe already visits every segment — this costs
    nothing extra. A file that reports no start time is treated as starting
    at zero, which is the right reading for a container without the field."""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries",
             "format=duration,start_time", "-of", "default=noprint_wrappers=1",
             path], capture_output=True, text=True, check=True).stdout
        vals = {}
        for line in out.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                vals[k.strip()] = v.strip()
        dur = float(vals["duration"])
        try:
            t0 = float(vals.get("start_time", "0"))
        except ValueError:
            t0 = 0.0
        return dur, t0
    except FileNotFoundError:
        die("ffprobe not found (is ffmpeg installed?)")
    except (subprocess.CalledProcessError, KeyError, ValueError):
        if fatal:
            die("ffprobe failed on %s" % path)
        return None


def ffprobe_wh(path, fatal=True):
    """(width, height) of the first video stream.

    Reads the FIRST row only. An MPEG-TS file carries programs, and ffprobe
    prints a matching stream once per program as well as once for the file,
    so a .ts segment answers "1280,720\\n\\n1280,720" — unpacking that whole
    string raised, this returned None, and every render silently fell back to
    CAM_FALLBACK_WH. That was invisible while the fallbacks happened to match
    the recorder's real geometry, and stops being invisible the moment
    anything else has to be generated at the same size (the No Signal filler
    now is): a mismatch makes the concat demuxer switch resolution mid-stream
    and ffmpeg drops frames across the join."""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "csv=p=0", path],
            capture_output=True, text=True, check=True).stdout
        row = next(l for l in out.splitlines() if l.strip())
        w, h = row.strip().split(",")
        return int(w), int(h)
    except FileNotFoundError:
        die("ffprobe not found (is ffmpeg installed?)")
    except (subprocess.CalledProcessError, ValueError, StopIteration):
        if fatal:
            die("ffprobe failed on %s" % path)
        return None


def parse_hms(s):
    parts = s.split(":")
    if len(parts) != 3:
        die("bad time %r (want HH:MM:SS)" % s)
    return int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])


def timelapse_speed(spec, span):
    """--timelapse spec -> speed factor over a rendered span of `span`
    seconds. Two spellings: 'Vx' (a decimal factor, at least 1) or
    'HH:MM:SS' (the target output length, at most the span itself —
    the factor is derived as span / target)."""
    if spec.endswith(("x", "X")):
        try:
            v = float(spec[:-1])
        except ValueError:
            die("bad --timelapse %r (want e.g. '8x' or 'HH:MM:SS')" % spec)
        if not math.isfinite(v) or v < 1.0:
            die("--timelapse factor must be a decimal >= 1 (got %r)" % spec)
        return v
    if ":" not in spec:
        die("bad --timelapse %r (want e.g. '8x' or 'HH:MM:SS')" % spec)
    try:
        target = parse_hms(spec)
    except ValueError:
        die("bad --timelapse %r (want e.g. '8x' or 'HH:MM:SS')" % spec)
    if target <= 0:
        die("--timelapse length must be positive")
    if target > span:
        die("--timelapse length %s exceeds the rendered span %s"
            % (spec, fmt_span(span)))
    return span / target


def parse_tz(s):
    """'±HH:MM' -> seconds."""
    sign = -1 if s.startswith("-") else 1
    body = s.lstrip("+-")
    h, m = body.split(":")
    return sign * (int(h) * 3600 + int(m) * 60)


def fmt_span(seconds):
    seconds = int(seconds)
    return "%d:%02d:%02d" % (seconds // 3600, (seconds % 3600) // 60,
                             seconds % 60)


def drive_start(data, session, fixes=None):
    """Earliest evidence of the drive: min over segment STARTS (mtime minus
    duration) of both cameras and the first RMC fix. None if no evidence.
    A caller that has already parsed the NMEA log passes its fixes in rather
    than paying to read it twice."""
    starts = []
    for cam in ("front", "rear"):
        # First segment that actually probes: segments() is sorted, so that
        # is this camera's earliest surviving evidence. An unreadable one is
        # skipped rather than fatal — catalog must still list a drive whose
        # tail fragment was truncated by a power cut.
        for p, mt in segments(data, session, cam):
            dur = ffprobe_duration(p, fatal=False)
            if dur is not None:
                starts.append(mt - dur)
                break
    if fixes is None:
        fixes = parse_rmc(nmea_path(data, session))
    if fixes:
        starts.append(fixes[0][0])
    return min(starts) if starts else None


# --------------------------------------------------------------- catalog --

def drive_stats(fixes):
    """(distance_m, moving_secs, top_knots) over the RMC timeline.

    Distance INTEGRATES THE RECEIVER'S DOPPLER SPEED over time — the RMC
    speed field, trapezoid rule between consecutive fixes — instead of
    summing haversine hops between consecutive positions, which is what
    this did until 2026-08-11.

    Doppler is the better observable by a wide margin, and the gap widens
    as the fix rate rises. It is derived from carrier phase rate, good to
    a few cm/s, and its error is zero-mean, so integrating it averages the
    noise away. A position, by contrast, carries metres of independent
    noise per fix, and differencing two of them ADDS those errors instead
    of cancelling them: at the puck's 5 Hz a stationary car random-walks
    its way to kilometres of distance it never travelled (measured: ~4 km
    over a 5-minute stop with 1.5 m RMS noise). Sampling faster makes
    position-differencing worse and Doppler integration better.

    Gates, all junk rejection rather than smoothing:

    - A pair more than 10 s apart (tunnel, log gap, power cut) contributes
      nothing. The speed across that gap is *unknown*, not zero — this
      undercounts a tunnel rather than inventing a straight line through
      it, which is the conservative direction for a dashcam log.
    - A fix reading above MAX_KNOTS is discarded outright.
    - A pair with BOTH ends below MOVING_KNOTS is stopped, and contributes
      neither distance nor time. This is what keeps standstill noise out
      of the total now that every pair is integrated; it costs a genuine
      sub-3.7 km/h crawl, which is the right trade for a car. Because it
      is the same threshold `moving` uses, `distance / moving_secs` is
      exactly the mean speed while moving.
    """
    dist = moving = top = 0.0
    for (t0, _, _, k0), (t1, _, _, k1) in zip(fixes, fixes[1:]):
        span = t1 - t0
        if span <= 0 or span > 10:
            continue
        if k0 > MAX_KNOTS or k1 > MAX_KNOTS:
            continue
        if k0 < MOVING_KNOTS and k1 < MOVING_KNOTS:
            continue
        dist += (k0 + k1) / 2.0 * KNOTS_TO_MS * span
        moving += span
        if k1 > top:
            top = k1
    return dist, moving, top


def catalog_verbose(data, session, fixes, units):
    ind = " " * 4
    if fixes:
        dist_m, moving_s, top_kn = drive_stats(fixes)
        if units == "KMH":
            dist_s = "%.1f km" % (dist_m / 1000.0)
            avg = dist_m / moving_s * 3.6 if moving_s else 0.0
            top = top_kn * KNOTS_TO_KMH
        else:
            dist_s = "%.1f mi" % (dist_m / 1609.344)
            avg = dist_m / moving_s * 2.236936 if moving_s else 0.0
            top = top_kn * KNOTS_TO_MPH
        print("%sdistance %s   avg %d %s moving   top %d %s"
              % (ind, dist_s, round(avg), units, round(top), units))
    else:
        print("%sno GPS fixes" % ind)
    health = parse_health(health_path(data, session))
    if health is None:
        return                      # session predates the health log
    if health["events"]:
        marks = ", ".join("+%s" % fmt_span(max(0, e - health["start"]))
                          for e in health["events"])
        print("%sevents %d   (%s from boot)"
              % (ind, len(health["events"]), marks))
    else:
        print("%sevents 0" % ind)
    # SoC temperature, one sample per health-log heartbeat. The peak is the
    # number that matters — a glovebox in summer is where thermal throttling
    # (and a dead card) comes from — with the average for context. Omitted
    # entirely for sessions recorded before the panel logged temperature.
    temps = health["temps"]
    if temps:
        print("%stemp avg %d C   peak %d C"
              % (ind, round(sum(temps) / len(temps)), max(temps)))


def cmd_catalog(args):
    data = args.data
    sess = sessions(data)
    if not sess:
        die("no sessions under %s" % data)
    if args.drive:
        # One row, same columns and same header — the point is to skip the
        # per-session ffprobe/NMEA work for every OTHER drive on a card
        # holding weeks of them, not to print a different thing.
        if args.drive not in sess:
            die("no such drive: %s (see `catalog` for the list)" % args.drive)
        sess = [args.drive]
    print("%-20s %-19s %9s %6s %6s  %s" %
          ("DRIVE", "START", "DURATION", "FRONT", "REAR", "GPS"))
    for s in sess:
        front = segments(data, s, "front")
        rear = segments(data, s, "rear")
        fixes = parse_rmc(nmea_path(data, s))
        # A segment's mtime is its LAST WRITE, i.e. its END — so min(mtimes),
        # which this used to call the start, is really the moment the FIRST
        # segment closed: one SEGMENT_NS (60 s) after the drive began. That
        # put START a whole segment late, made it postdate the GPS column it
        # sits next to, and docked DURATION the same 60 s. Anchor on
        # drive_start() instead: the same evidence render/gpx/csv already use,
        # so catalog agrees with `render --from 0:00`, and START cannot
        # postdate the first fix because that fix is one of the candidates it
        # takes the min over. The end needs no such care — the newest mtime
        # really is the last write of the drive. Costs one ffprobe per camera
        # per session, which is why the cheap version existed.
        mtimes = [m for _, m in front + rear]
        end = max(mtimes) if mtimes else (fixes[-1][0] if fixes else None)
        start = drive_start(data, s, fixes)
        if start is None and mtimes:
            # Every segment unprobeable (truncated tail, no ffprobe): fall
            # back to the old estimate rather than losing the row entirely.
            start = min(mtimes)
        if start is not None and end is not None:
            start_s = dt.datetime.fromtimestamp(start).strftime(
                "%Y-%m-%d %H:%M:%S")
            dur = fmt_span(max(0.0, end - start))
        else:
            start_s, dur = "?", "?"
        if fixes:
            g0 = dt.datetime.fromtimestamp(fixes[0][0], dt.timezone.utc)
            g1 = dt.datetime.fromtimestamp(fixes[-1][0], dt.timezone.utc)
            gps = "%s-%sZ" % (g0.strftime("%H:%M:%S"), g1.strftime("%H:%M:%S"))
        else:
            gps = "none"
        print("%-20s %-19s %9s %6d %6d  %s" %
              (s, start_s, dur, len(front), len(rear), gps))
        if args.verbose:
            catalog_verbose(data, s, fixes, args.units)


