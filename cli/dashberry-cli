"""


def ass_time(t):
    if t < 0:
        t = 0
    cs = int(round(t * 100))
    return "%d:%02d:%02d.%02d" % (cs // 360000, (cs // 6000) % 60,
                                  (cs // 100) % 60, cs % 100)


def display_shift_secs(args, start0):
    """anchor: assert the drive's true wall-clock start (repairs wrong-RTC
    drives); tz-offset: constant local-time offset. Both display-only."""
    shift = 0.0
    if args.anchor:
        try:
            anchor = dt.datetime.strptime(
                args.anchor, "%Y-%m-%d %H:%M:%S").replace(
                tzinfo=dt.timezone.utc).timestamp()
        except ValueError:
            die("bad --anchor (want 'YYYY-mm-dd HH:MM:SS')")
        if start0 is None:
            die("cannot anchor: drive has no timing evidence")
        shift += anchor - start0
    if args.tz_offset:
        shift += parse_tz(args.tz_offset)
    return shift


# ------------------------------------------------- render: the timeline --
# Every render is the continuous boot-to-shutdown timeline (the lossless
# whole-segment stream-copy path was dropped with the flag that gated it):
# the health log's boot..last-heartbeat span (fallback: footage/fix
# evidence), covered piece by piece per camera — real segments trimmed to
# the window (sub-second exact) alternating with generated black
# "No Signal" filler — and GPS trouble labeled "GPS Error"/"GPS No
# Signal". Always a re-encode; near-transparent x264 settings (CRF 18)
# keep the loss on 8 Mbps dashcam source visually negligible (both cameras;
# the rear rose from 4 on 2026-08-12).
#
# Each camera reaches ffmpeg as ONE input: an ffconcat list walked by the
# concat DEMUXER, which opens one segment at a time. It used to be one -i
# per segment joined by the concat FILTER, and that is what made a long
# drive unrenderable — ffmpeg opened every segment at once, so both the
# per-input decoder overhead and libavfilter's unbounded per-input frame
# queues grew with the length of the drive. Measured on 640x480 stand-in
# footage, peak RSS went 1.06 / 1.93 / 3.65 / 7.16 GB across 20 / 40 / 80 /
# 160 segments and failed outright at 120 under a 16 GB cap ("Error while
# opening decoder: Resource temporarily unavailable"); the same renders on
# the demuxer hold flat at 0.23 GB. Real 60 s 1080p segments are far
# heavier per segment than that stand-in, which is why hours of footage
# filled RAM.
#
# What keeps the joins seamless is the division of labour between the two:
# the demuxer places each piece on the timeline (durations pinned by our own
# arithmetic, cuts taken off segment TAILS so nothing seeks into a GOP) and
# the filter graph does the frame-exact work (fps= onto a rigid grid, then
# the single head trim --from needs). See tail_trim_overlaps,
# write_concat_list and normalize_filter for why each half does its half.

def cam_segments_abs(data, session, cam):
    """Sorted [(path, start_epoch, duration, ts0)]; start = mtime - duration
    (mtime is the segment END — see module docstring). ts0 is the segment's
    own first timestamp, carried because a concat-demuxer cut is expressed in
    that domain (see ffprobe_dur_start)."""
    out = []
    for path, mtime in segments(data, session, cam):
        probe = ffprobe_dur_start(path, fatal=False)
        if probe is None:
            warn("skipping unreadable segment %s (rendered as No Signal)"
                 % path)
            continue
        dur, ts0 = probe
        out.append((path, mtime - dur, dur, ts0))
    out.sort(key=lambda s: s[1])
    return out


def timeline_pieces(segs, lo, hi):
    """Cover [lo, hi] with ('seg', path, in_offset, take) and ('gap', dur)
    pieces. Holes shorter than GAP_MIN are mtime jitter: absorbed (the
    timeline drifts by that amount) rather than rendered as flicker
    filler; overlaps trim the head of the later segment."""
    pieces = []
    cursor = lo
    for path, start, dur, ts0 in segs:
        end = start + dur
        if end <= cursor or start >= hi:
            continue
        if start - cursor >= GAP_MIN:
            pieces.append(("gap", start - cursor))
            cursor = start
        in_off = max(0.0, cursor - start)
        take = min(end, hi) - (start + in_off)
        if take <= 0:
            continue
        pieces.append(("seg", path, in_off, take, ts0))
        cursor = start + in_off + take
    if hi - cursor >= GAP_MIN:
        pieces.append(("gap", hi - cursor))
    return pieces


def tail_trim_overlaps(pieces):
    """Move every interior head trim onto the tail of the piece before it.

    timeline_pieces resolves an overlap by trimming the HEAD of the later
    segment. Under the old per-piece `trim` filter that was free, but for the
    concat demuxer a head trim is an inpoint in the middle of a GOP: the
    decoder has to start at the preceding keyframe, the frames before the cut
    come out referencing pictures it never saw, and the cut both loses real
    footage and shows a brief freeze where fps= papers over the hole.
    Trimming the TAIL of the EARLIER segment removes exactly the same amount
    of timeline at exactly the same instant, but the demuxer merely stops
    reading early — no seek, no broken references, frame-exact.

    The trim cascades backwards: normally the immediately preceding piece has
    room for all of it, but a segment shorter than the overlap that swallowed
    it has to pass the remainder further back. Filler holes can absorb it too
    — shrinking generated black by the same amount as it shifts is exactly
    the mtime-jitter approximation timeline_pieces already makes. Every move
    keeps the total length identical, so the timeline and every overlay time
    survive untouched.

    What this guarantees downstream: after this pass, only the FIRST piece
    can still carry a head trim (anything earlier that could have absorbed it
    was reduced to nothing and dropped). That one is the --from cut, and
    write_concat_list hands it to the filter graph rather than the demuxer.
    """
    out = [list(p) for p in pieces]
    room = lambda p: p[3] if p[0] == "seg" else p[1]

    def take_from(p, amount):
        if p[0] == "seg":
            p[3] -= amount
        else:
            p[1] -= amount

    for i in range(len(out) - 1, 0, -1):
        cur = out[i]
        if cur[0] != "seg" or cur[2] <= 0:
            continue
        j = i - 1
        while cur[2] > 0 and j >= 0:
            move = min(cur[2], room(out[j]))
            if move > 0:
                take_from(out[j], move)
                cur[2] -= move
                cur[3] += move
            j -= 1
    # A piece consumed whole by the cascade contributes nothing; drop it
    # rather than emit a zero-length concat entry.
    return [tuple(p) for p in out if room(p) > 0]


def concat_quote(path):
    """Quote a path for an ffconcat list. The parser quotes like a shell:
    inside single quotes everything is literal, so only the quote itself has
    to break out. --data is caller-supplied and may contain anything."""
    return "'" + path.replace("'", "'\\''") + "'"


def make_filler(w, h, dur, tmpdir, cam):
    """Pre-render one "No Signal" tile for a camera -> (path, duration, ts0).

    Holes used to be lavfi color sources generated inside the filter graph,
    which cost one graph input per hole. As a file, one tile covers a hole of
    any length by being listed repeatedly, so the input count stays at one
    per camera no matter how broken the footage is. Rendered at the camera's
    own w×h so the demuxer never sees a resolution change mid-stream.

    drawtext needs a fontconfig default font; where there is none, fall back
    to unlabeled black rather than failing the whole render — a black hole
    still reads as "no footage", which is the point of the filler."""
    path = os.path.join(tmpdir, "filler-%s.ts" % cam)
    src = ("color=black:size=%dx%d:rate=%d:duration=%.3f"
           % (w, h, TIMELINE_FPS, dur))
    labeled = ("drawtext=text='No Signal':fontcolor=white:fontsize=%d:"
               "x=(w-text_w)/2:y=(h-text_h)/2,format=yuv420p" % (h // 9))
    for attempt, vf in enumerate((labeled, "format=yuv420p")):
        try:
            subprocess.run(
                ["ffmpeg", "-hide_banner", "-v", "error", "-y",
                 "-f", "lavfi", "-i", src, "-vf", vf, "-c:v", "libx264",
                 "-preset", "ultrafast", "-crf", "23", "-pix_fmt", "yuv420p",
                 "-an", "-f", "mpegts", path], check=True)
        except FileNotFoundError:
            die("ffmpeg not found")
        except subprocess.CalledProcessError:
            continue
        probe = ffprobe_dur_start(path, fatal=False)
        if probe:
            if attempt:
                warn("no usable font for the 'No Signal' label: "
                     "rendering footage holes as plain black")
            return path, probe[0], probe[1]
    die("could not render 'No Signal' filler for %s" % cam)


def write_concat_list(pieces, filler, tmpdir, cam):
    """One camera's pieces -> (ffconcat list path, segment count).

    This is what keeps memory flat. The old graph gave every segment its own
    -i and joined them with the concat FILTER, so ffmpeg opened all of them
    at once and libavfilter's unbounded per-input frame queues accumulated
    decoded frames for every segment not yet reached — O(segments) RAM, which
    on a multi-hour drive is tens of gigabytes. The concat DEMUXER walks the
    same list one file at a time, closing each before opening the next, so
    peak memory is a single decoder regardless of how long the drive is.

    Two directives per entry, and each earns its place:
      outpoint  where the piece ends. Absolute in the FILE'S OWN timestamp
                domain, hence ts0 + ... — see ffprobe_dur_start.
      duration  the timeline advance, pinned to OUR arithmetic. Without it
                the demuxer derives the next file's start from where the
                packets actually stopped, which is a packet boundary rather
                than the exact cut, and those sub-frame errors would random-
                walk across hundreds of segments until the two cameras and
                the overlay no longer agreed on what time it was.

    Deliberately NO inpoint, even for the one head trim tail_trim_overlaps
    cannot move (the --from cut). inpoint does not compose with duration:
    the demuxer still lays the file's frames down at (pts - file start), so
    the skipped head becomes a silent lead-in that collides with the next
    entry's offset and ffmpeg drops the overlap — a --from render came out
    ~28 frames short and shifted. Instead the first file goes in WHOLE and
    the caller trims that lead off in the filter graph, which is frame-exact
    and costs one segment of decoded-and-discarded video, once per render.
    Returned as `lead` for exactly that purpose.
    """
    lines = ["ffconcat version 1.0"]
    n_seg = 0
    lead = 0.0
    for i, piece in enumerate(pieces):
        if piece[0] == "seg":
            _, path, in_off, take, ts0 = piece
            # Read the lead off the FIRST piece and only the first, rather
            # than off whichever piece still has one. tail_trim_overlaps
            # leaves the others at zero mathematically, but it subtracts
            # floats, so a later piece can hold a stray 1e-16 — and picking
            # that up would silently overwrite a real --from cut with it.
            if i == 0:
                lead = in_off
            lines.append("file " + concat_quote(os.path.abspath(path)))
            lines.append("outpoint %.6f" % (ts0 + in_off + take))
            lines.append("duration %.6f" % (in_off + take))
            n_seg += 1
        else:
            fpath, fdur, fts0 = filler
            left = piece[1]
            while left > 0.5 / TIMELINE_FPS:    # ignore a sub-frame remainder
                take = min(left, fdur)
                lines.append("file " + concat_quote(fpath))
                if take < fdur:
                    lines.append("outpoint %.6f" % (fts0 + take))
                lines.append("duration %.6f" % take)
                left -= take
    out = os.path.join(tmpdir, "concat-%s.txt" % cam)
    with open(out, "w") as f:
        f.write("\n".join(lines) + "\n")
    return out, n_seg, lead


def normalize_filter(idx, w, h, lead, span, label):
    """The whole of one camera, as a single chain on a single input.

    Order matters, and every step is load-bearing for seamlessness:
      setpts=PTS-STARTPTS  rebase to zero FIRST. The concatenated stream
                           inherits the first segment's timestamp, which for
                           MPEG-TS is ~1.4 s in and can be far larger; leave
                           it and every .ass cue (which counts from zero)
                           would sit that far off the footage it describes.
      fps                  resample onto a rigid grid. This is what makes the
                           joins seamless: a cut that lands mid-GOP, a
                           segment whose real length differs a hair from its
                           declared one, a filler tile boundary — all of them
                           become an exact frame count instead of a drift,
                           so the two cameras stay locked to each other and
                           to the overlay for the length of the drive.
      scale/setsar/format  after fps, so surplus frames are dropped before
                           the expensive part rather than after.
      trim                 drop `lead` — the --from cut the demuxer could not
                           take (see write_concat_list) — and cap the result
                           at the timeline span. Placed AFTER fps so both
                           edges land on the rigid grid and the cut is exact
                           to the frame; also insurance that nothing runs
                           past the window even if a segment over-reports
                           itself.
      setpts               rebase again, so the kept range starts at zero and
                           the .ass cues (which count from zero) line up with
                           the footage they describe.
    """
    return ("[%d:v]setpts=PTS-STARTPTS,fps=%d,scale=%d:%d,setsar=1,"
            "format=yuv420p,trim=start=%.6f:end=%.6f,setpts=PTS-STARTPTS[%s]"
            % (idx, TIMELINE_FPS, w, h, lead, lead + span, label))


def ticking_spans(spans, epoch0, text):
    """Chop spans into one event per displayed second, each stamped with
    its own clock. A Dialogue's text is fixed for the life of the event,
    so a clock that ticks has to be one event per tick. epoch0 is the
    display epoch of timeline zero (lo + shift); cuts land on whole
    display seconds so the digits never change mid-event."""
    out = []
    for a, b in spans:
        t = a
        while t < b - 1e-6:
            sec = math.floor(epoch0 + t + 1e-6)
            nxt = min(b, sec + 1 - epoch0)
            shown = dt.datetime.fromtimestamp(sec, dt.timezone.utc)
            out.append((t, nxt, "%s  %s"
                        % (shown.strftime("%Y-%m-%d %H:%M:%S"), text)))
            t = nxt
    return out


def write_timeline_ass(fixes, health, lo, hi, shift, units, annotate, tmpdir):
    """.ass overlay for a timeline render, or None if there is nothing to
    say. With annotate: one event per fix, capped at 2 s so a stale data
    line never lingers into a GPS hole. GPS trouble labels: health-log
    gps ERR spans read "GPS Error", no-fix spans "GPS No Signal" (ERR
    wins where they overlap — a dead gpsd also drops the fix). Without a
    health log, holes > 2 s in the RMC timeline stand in for the no-fix
    spans. Trouble spans yield to annotate events (a fix on screen is
    precise data; span edges are heartbeat-coarse, and synthesized no-fix
    spans start at the last fix itself): at most one event is active at
    any instant, so libass never collision-stacks the overlay onto a
    second line. Trouble labels carry the clock too — chopped one event
    per second by ticking_spans, since the 2 s annotate cap means a hole
    would otherwise show no time at all. That clock is the timeline's own
    (RTC/health-log derived), which survives a dead GPS."""
    factor, label = ((KNOTS_TO_KMH, "KMH") if units == "KMH"
                     else (KNOTS_TO_MPH, "MPH"))
    if health:
        err = [(max(a, lo), min(b, hi))
               for a, b in health["err"].get("gps", []) if b > lo and a < hi]
        nofix = [(max(a, lo), min(b, hi))
                 for a, b in health["nofix"] if b > lo and a < hi]
    else:
        err = []
        nofix = []
        cursor = lo
        for t in (f[0] for f in fixes if lo <= f[0] <= hi):
            if t - cursor > 2:
                nofix.append((cursor, t))
            cursor = t
        if hi - cursor > 2:
            nofix.append((cursor, hi))
    nofix = spans_subtract(nofix, err)
    lines = []
    ann = []
    if annotate:
        sel = [f for f in fixes if lo - 1 <= f[0] <= hi + 1]
        for i, (t, lat, lon, knots) in enumerate(sel):
            start = t - lo
            end = (sel[i + 1][0] - lo) if i + 1 < len(sel) else start + 0.5
            end = min(end, start + 2.0)
            shown = dt.datetime.fromtimestamp(t + shift, dt.timezone.utc)
            ann.append((start, end))
            lines.append((start, end, "%s  %.5f,%.5f  %d %s" % (
                shown.strftime("%Y-%m-%d %H:%M:%S"), lat, lon,
                int(knots * factor + 0.5), label)))
    err = spans_subtract([(a - lo, b - lo) for a, b in err], ann)
    nofix = spans_subtract([(a - lo, b - lo) for a, b in nofix], ann)
    lines += ticking_spans(err, lo + shift, "GPS Error")
    lines += ticking_spans(nofix, lo + shift, "GPS No Signal")
    if not lines:
        return None
    lines.sort()
    path = os.path.join(tmpdir, "overlay.ass")
    with open(path, "w") as f:
        f.write(ASS_HEADER)
        for a, b, text in lines:
            f.write("Dialogue: 0,%s,%s,gps,%s\n"
                    % (ass_time(a), ass_time(b), text))
    return path


def cmd_render(args):
    data, session = args.data, args.drive
    both = args.camera.startswith("both-")
    if both:
        main_cam = "front" if args.camera == "both-prio-front" else "rear"
        cams = [main_cam, "rear" if main_cam == "front" else "front"]
    else:
        cams = [args.camera]

    segs = {c: cam_segments_abs(data, session, c) for c in cams}
    # Re-count the directory (no probing) to report what was dropped: a
    # render that silently covers a broken segment with filler looks the
    # same as one where the camera really was down.
    n_bad = sum(len(segments(data, session, c)) - len(segs[c]) for c in cams)
    fixes = parse_rmc(nmea_path(data, session))
    health = parse_health(health_path(data, session))

    # timeline bounds: every timing evidence there is (health log first —
    # boot..last-heartbeat is the "system boot to shutdown" span)
    starts = [s[0][1] for s in segs.values() if s]
    ends = [s[-1][1] + s[-1][2] for s in segs.values() if s]
    if fixes:
        starts.append(fixes[0][0])
        ends.append(fixes[-1][0])
    if health:
        starts.append(health["start"])
        ends.append(health["end"])
    if not starts:
        die("no footage/health evidence for drive %s" % session)
    t0, t1 = min(starts), max(ends)

    lo = t0 + parse_hms(getattr(args, "from")) if getattr(args, "from") else t0
    hi = t0 + parse_hms(args.to) if args.to else t1
    lo, hi = max(lo, t0), min(hi, t1)
    if hi <= lo:
        die("requested range is empty")
    speed = timelapse_speed(args.timelapse, hi - lo) if args.timelapse else 1.0

    def cam_wh(cam):
        wh = ffprobe_wh(segs[cam][0][0], fatal=False) if segs[cam] else None
        return wh or CAM_FALLBACK_WH[cam]

    with tempfile.TemporaryDirectory() as tmpdir:
        # One input per CAMERA, not per segment: each camera's whole timeline
        # is an ffconcat list the demuxer walks file by file. Peak memory is
        # therefore flat in the length of the drive (see write_concat_list),
        # and a both-prio-* render of a multi-hour drive is 2 inputs where it
        # used to be several hundred — which also puts the open-file count
        # and the argument list back well under their limits.
        input_args, filter_lines = [], []
        n_seg = 0
        n_fill = 0
        for idx, cam in enumerate(cams):
            w, h = cam_wh(cam)
            pieces = timeline_pieces(segs[cam], lo, hi)
            if not pieces:          # window inside an absorbed sliver
                pieces = [("gap", hi - lo)]
            pieces = tail_trim_overlaps(pieces)
            gaps = [p[1] for p in pieces if p[0] == "gap"]
            n_fill += len(gaps)
            filler = (make_filler(w, h, min(FILLER_TILE, max(gaps)),
                                  tmpdir, cam) if gaps else None)
            lst, ns, lead = write_concat_list(pieces, filler, tmpdir, cam)
            n_seg += ns
            input_args += ["-f", "concat", "-safe", "0", "-i", lst]
            filter_lines.append(
                normalize_filter(idx, w, h, lead, hi - lo, cam))

        # Both cameras are now exactly the same number of frames on exactly
        # the same grid, so the PiP stays registered to the main picture for
        # the whole drive instead of sliding as holes accumulate.
        if both:
            mw, _ = cam_wh(cams[0])
            pw, ph = cam_wh(cams[1])
            pip_w = int(mw * PIP_FRAC) // 2 * 2
            pip_h = int(pip_w * ph / pw) // 2 * 2
            filter_lines.append("[%s]scale=%d:%d[pip]"
                                % (cams[1], pip_w, pip_h))
            filter_lines.append("[%s][pip]overlay=W-w-%d:%d[vid]"
                                % (cams[0], PIP_MARGIN, PIP_MARGIN))
            vid = "vid"
        else:
            vid = cams[0]

        shift = display_shift_secs(args, t0)
        ass = write_timeline_ass(fixes, health, lo, hi, shift,
                                 args.units, args.annotate, tmpdir)
        if ass:
            filter_lines.append("[%s]ass=%s[outv]" % (vid, ass))
            vid = "outv"
        # Timelapse goes last, after the overlay is burned in, so labels
        # stay glued to the footage they describe and simply pass faster.
        # fps= after setpts drops the now-surplus frames instead of asking
        # x264 to encode a sped-up frame flood at the same output rate.
        if speed > 1.0:
            filter_lines.append("[%s]setpts=PTS/%.6f,fps=%d[fast]"
                                % (vid, speed, TIMELINE_FPS))
            vid = "fast"
        script = os.path.join(tmpdir, "filter.txt")
        with open(script, "w") as f:
            f.write(";\n".join(filter_lines))
        # CRF 18 = x264's visually-lossless neighborhood — generous next
        # to the ~2 Mbps hardware-encoded source, so the mandatory
        # re-encode costs no quality a viewer can see.
        # The rendered file is the one artifact that leaves the toolchain —
        # a comment tag lets it name the release that produced it.
        cmd = (["ffmpeg", "-hide_banner", "-y"] + input_args +
               ["-filter_complex_script", script, "-map", "[%s]" % vid,
                "-c:v", "libx264", "-preset", "medium", "-crf", "18",
                "-metadata", "comment=DashBerry %s (dashberry-cli render)"
                % VERSION,
                "-an", args.output])
        try:
            subprocess.run(cmd, check=True)
        except FileNotFoundError:
            die("ffmpeg not found")
        except subprocess.CalledProcessError as e:
            die("ffmpeg failed (%d)" % e.returncode)
    print("wrote %s (%s span %s%s, %d segments, %d filler pieces%s)"
          % (args.output, args.camera, fmt_span(hi - lo),
             " at %gx" % speed if speed > 1.0 else "", n_seg, n_fill,
             ", %d unreadable segments skipped" % n_bad if n_bad else ""))


# ------------------------------------------------------------------- gpx --

def cmd_gpx(args):
    fixes = parse_rmc(nmea_path(args.data, args.drive))
    if not fixes:
        die("no RMC fixes for drive %s" % args.drive)
    start0 = drive_start(args.data, args.drive)
    lo = start0 + parse_hms(getattr(args, "from")) if getattr(args, "from") else None
    hi = start0 + parse_hms(args.to) if args.to else None
    shift = display_shift_secs(args, start0)
    tzoff = parse_tz(args.tz_offset) if args.tz_offset else 0
    sel = [f for f in fixes
           if (lo is None or f[0] >= lo) and (hi is None or f[0] <= hi)]
    if not sel:
        die("no fixes in the requested range")

    def stamp(t):
        d = dt.datetime.fromtimestamp(t + shift, dt.timezone.utc)
        if tzoff:
            sign = "+" if tzoff >= 0 else "-"
            a = abs(tzoff)
            return d.strftime("%Y-%m-%dT%H:%M:%S") + "%s%02d:%02d" % (
                sign, a // 3600, (a % 3600) // 60)
        return d.strftime("%Y-%m-%dT%H:%M:%SZ")

    out = sys.stdout if args.output in (None, "-") else open(args.output, "w")
    # GPX 1.0 on purpose: it has a NATIVE <speed> element (m/s); 1.1 buries
    # speed in extensions that many tools ignore (PLAN §3c).
    out.write('<?xml version="1.0" encoding="UTF-8"?>\n')
    # creator is the GPX spec's "name version" slot — the one place the
    # exported track names the tool and release that wrote it.
    out.write('<gpx version="1.0" creator="dashberry-cli %s" '
              'xmlns="http://www.topografix.com/GPX/1/0">\n' % VERSION)
    out.write("<trk><name>%s</name><trkseg>\n" % args.drive)
    for t, lat, lon, knots in sel:
        out.write('<trkpt lat="%.6f" lon="%.6f">'
                  "<time>%s</time><speed>%.2f</speed></trkpt>\n"
                  % (lat, lon, stamp(t), knots * KNOTS_TO_MS))
    out.write("</trkseg></trk>\n</gpx>\n")
    if out is not sys.stdout:
        out.close()
        print("wrote %s (%d points)" % (args.output, len(sel)))


# ------------------------------------------------------------------- csv --

# The panel samples SoC temperature on its 10 s health heartbeat while RMC
# fixes arrive at the puck's 5 Hz, so there is no sample of our own on almost
# every row: each row carries the most recent EARLIER sample forward. Carrying
# it forward without limit would print a reading from before a logging gap as
# though it were current, so a sample older than this leaves the cell empty
# instead. Three heartbeats — long enough that an ordinary missed record does
# not punch holes in the column, short enough that a real gap shows as one.
TEMP_STALE_S = 30

# A button-B marker is logged with 1 s resolution, so it never lands exactly
# on a fix; it is attributed to the nearest one. Beyond this the nearest fix
# is not plausibly "the same moment" (GPS was out, or the event sits outside
# the --from/--to window) and the marker is dropped rather than pinned to an
# arbitrary row.
EVENT_MATCH_S = 2.0


def temp_at(series, t):
    """Most recent temperature sample at or before t, or None if there is
    none or that sample is staler than TEMP_STALE_S. The health log is
    append-only and therefore already sorted, so this is a bisect."""
    lo, hi = 0, len(series) - 1
    best = None
    while lo <= hi:                      # rightmost sample with time <= t
        mid = (lo + hi) // 2
        if series[mid][0] <= t:
            best = mid
            lo = mid + 1
        else:
            hi = mid - 1
    if best is None:
        return None
    ts, degc = series[best]
    return degc if t - ts <= TEMP_STALE_S else None


def cmd_csv(args):
    """One row per RMC fix: time, position, speed, SoC temperature, and the
    button-B marker. Same drive selection and same --from/--to/--anchor/
    --tz-offset handling as gpx — this is that track as a spreadsheet."""
    fixes = parse_rmc(nmea_path(args.data, args.drive))
    if not fixes:
        die("no RMC fixes for drive %s" % args.drive)
    start0 = drive_start(args.data, args.drive)
    lo = start0 + parse_hms(getattr(args, "from")) if getattr(args, "from") else None
    hi = start0 + parse_hms(args.to) if args.to else None
    shift = display_shift_secs(args, start0)
    tzoff = parse_tz(args.tz_offset) if args.tz_offset else 0
    sel = [f for f in fixes
           if (lo is None or f[0] >= lo) and (hi is None or f[0] <= hi)]
    if not sel:
        die("no fixes in the requested range")

    def stamp(t):
        d = dt.datetime.fromtimestamp(t + shift, dt.timezone.utc)
        if tzoff:
            sign = "+" if tzoff >= 0 else "-"
            a = abs(tzoff)
            return d.strftime("%Y-%m-%dT%H:%M:%S") + "%s%02d:%02d" % (
                sign, a // 3600, (a % 3600) // 60)
        return d.strftime("%Y-%m-%dT%H:%M:%SZ")

    health = parse_health(health_path(args.data, args.drive))
    series = health["temp_series"] if health else []
    if health is None:
        warn("no health log for %s: temp_c will be empty" % args.drive)
    elif not series:
        warn("%s predates temperature logging: temp_c will be empty"
             % args.drive)

    # Walk the markers, not the rows: there are a handful of markers per
    # drive against thousands of fixes. Markers are filtered by the SAME
    # window as the fixes before being matched — otherwise a press just
    # outside --to lands on the last row in range, reporting an event the
    # caller explicitly asked not to see.
    marked = set()
    for e in (health["events"] if health else []):
        if (lo is not None and e < lo) or (hi is not None and e > hi):
            continue
        best, bestd = None, None
        for i, f in enumerate(sel):
            d = abs(f[0] - e)
            if bestd is None or d < bestd:
                best, bestd = i, d
        if best is not None and bestd <= EVENT_MATCH_S:
            marked.add(best)

    factor, unit = ((KNOTS_TO_KMH, "kmh") if args.units == "KMH"
                    else (KNOTS_TO_MPH, "mph"))
    out = sys.stdout if args.output in (None, "-") else open(
        args.output, "w", newline="")
    # lineterminator is pinned: csv defaults to CRLF, and this file is read
    # by whatever the user has on a PC, not by a spreadsheet on Windows only.
    w = csv.writer(out, lineterminator="\n")
    w.writerow(["timestamp", "epoch", "lat", "lon",
                "speed_" + unit, "speed_ms", "temp_c", "event"])
    for i, (t, lat, lon, knots) in enumerate(sel):
        degc = temp_at(series, t)
        w.writerow([stamp(t), "%d" % round(t),
                    "%.6f" % lat, "%.6f" % lon,
                    "%.1f" % (knots * factor), "%.2f" % (knots * KNOTS_TO_MS),
                    "" if degc is None else "%d" % degc,
                    "1" if i in marked else "0"])
    if out is not sys.stdout:
        out.close()
        print("wrote %s (%d rows)" % (args.output, len(sel)))


# ------------------------------------------------------------------ main --

def add_range_opts(p):
    p.add_argument("--from", metavar="HH:MM:SS",
                   help="range start, relative to drive start")
    p.add_argument("--to", metavar="HH:MM:SS",
                   help="range end, relative to drive start")
    p.add_argument("--anchor", metavar="'YYYY-mm-dd HH:MM:SS'",
                   help="assert the drive's true wall-clock start "
                        "(repairs wrong-RTC drives)")
    p.add_argument("--tz-offset", metavar="±HH:MM",
                   help="constant timezone offset applied to displayed times")


def main():
    ap = argparse.ArgumentParser(
        prog="dashberry-cli",
        description="DashBerry data exporter for PC")
    ap.add_argument("--version", action="version",
                    version="dashberry-cli %s" % VERSION)
    ap.add_argument("--data", required=True, metavar="DIR",
                    help="path to a copy of /data")
    sub = ap.add_subparsers(dest="cmd", required=True)

    pc = sub.add_parser("catalog", help="print drive session info")
    pc.add_argument("--drive", metavar="SESSION",
                    help="list only this drive (default: every drive)")
    pc.add_argument("-v", "--verbose", action="store_true",
                    help="add per-drive distance / avg / top speed (from the "
                         "NMEA log) and button-B event markers (health log)")
    pc.add_argument("--units", choices=["MPH", "KMH"], default="MPH",
                    help="verbose speed/distance units (default MPH)")

    pr = sub.add_parser(
        "render",
        help="produce a video file from one drive",
        description="Renders the continuous boot-to-shutdown timeline: "
                    "footage holes become black 'No Signal' filler and GPS "
                    "trouble is labeled from the session health log. "
                    "--from/--to count from boot.")
    pr.add_argument("--drive", required=True, metavar="SESSION")
    pr.add_argument("--camera", required=True,
                    choices=["front", "rear",
                             "both-prio-front", "both-prio-rear"],
                    help="both-prio-* composites both cameras: the prio "
                         "camera full-frame, the other picture-in-picture "
                         "top-right")
    pr.add_argument("--annotate", action="store_true",
                    help="burn time/position/speed into the image")
    pr.add_argument("--timelapse", metavar="Vx|HH:MM:SS",
                    help="speed the output up: either a factor ('8x', a "
                         "decimal >= 1) or the target output length "
                         "('HH:MM:SS', at most the rendered span). "
                         "Overlays are burned first, so they stay in "
                         "sync and just pass faster")
    pr.add_argument("--units", choices=["MPH", "KMH"], default="MPH",
                    help="annotation speed units (default MPH)")
    add_range_opts(pr)
    pr.add_argument("-o", "--output", required=True, metavar="OUT.mp4")

    pg = sub.add_parser("gpx", help="generate a GPX 1.0 track from one drive")
    pg.add_argument("--drive", required=True, metavar="SESSION")
    add_range_opts(pg)
    pg.add_argument("-o", "--output", metavar="OUT.gpx",
                    help="output file (default stdout)")

    pv = sub.add_parser(
        "csv", help="generate a CSV track log from one drive",
        description="One row per GPS fix: timestamp, position, speed, SoC "
                    "temperature and the button-B event marker. Same drive "
                    "selection and same --from/--to/--anchor/--tz-offset "
                    "handling as gpx. temp_c comes from the session health "
                    "log and is empty where that log has nothing recent to "
                    "say; it is empty for every row on drives recorded "
                    "before the panel logged temperature.")
    pv.add_argument("--drive", required=True, metavar="SESSION")
    add_range_opts(pv)
    pv.add_argument("--units", choices=["MPH", "KMH"], default="MPH",
                    help="units for the speed_mph/speed_kmh column "
                         "(default MPH); speed_ms is always present")
    pv.add_argument("-o", "--output", metavar="OUT.csv",
                    help="output file (default stdout)")

    args = ap.parse_args()
    if args.cmd == "catalog":
        cmd_catalog(args)
    elif args.cmd == "render":
        cmd_render(args)
    elif args.cmd == "gpx":
        cmd_gpx(args)
    elif args.cmd == "csv":
        cmd_csv(args)


if __name__ == "__main__":
    main()
